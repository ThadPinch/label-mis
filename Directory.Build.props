<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    SixLabors.ImageSharp 3.1.12 has six advisories published 2026-10-07, all fixed in 3.2.0. With
    TreatWarningsAsErrors, NuGet audit turns them into restore errors (NU1902/NU1903), so every Docker
    build and deploy fails. 3.2.0 can't be dropped in: its build targets refuse a Release build without
    a Six Labors license key (SixLaborsLicenseKey / sixlabors.lic).
    These suppressions are scoped to exactly these six advisory IDs. They change no runtime code;
    production already runs 3.1.12. Remove them once ImageSharp is upgraded with a license, or replaced.
    A new advisory still fails the build.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>

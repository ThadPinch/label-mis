@page "/purchase-orders/{id:guid}/edit"
@model LabelsMis.Web.Pages.PurchaseOrders.EditModel
@{ ViewData["Title"] = Model.Po?.PoNumber ?? "Purchase order"; ViewData["BackNav"] = new BackNavModel(); }

<h1 class="h3 mb-1">@Model.Po?.PoNumber</h1>
<p class="text-muted">@Model.Po?.Status — @Model.Po?.Supplier.Name</p>

<div class="mb-3">
    <a asp-page-handler="Pdf" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary">View PO</a>
</div>

@if (Model.CanEdit)
{
    <input type="hidden" id="po-supplier-id" value="@Model.Po?.SupplierId" />
    <form method="post" asp-page-handler="Save">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="Input.ExpectedAt" class="form-label">Expected</label>
                <input asp-for="Input.ExpectedAt" class="form-control" type="date" />
            </div>
            <div class="col-md-8">
                <label asp-for="Input.Notes" class="form-label">Notes</label>
                <textarea asp-for="Input.Notes" class="form-control" rows="1"></textarea>
            </div>
        </div>

        <partial name="_PoLines" model="Model.Input" />

        <div class="mt-2">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
    <form method="post" asp-page-handler="Send" class="d-flex flex-wrap gap-2 align-items-center mt-3">
        @if (Model.ContactEmails.Count > 0)
        {
            <div class="form-check mb-0">
                <input asp-for="SendEmail" class="form-check-input" />
                <label asp-for="SendEmail" class="form-check-label">Email PO to</label>
            </div>
            <select asp-for="EmailTo" class="form-select" style="max-width: 22rem;" asp-items="Model.ContactEmails"></select>
        }
        else
        {
            <input type="hidden" asp-for="SendEmail" value="false" />
            <span class="text-muted small">No supplier contact emails on file — the PO will be marked sent without emailing.
                <a asp-page="/Suppliers/Edit" asp-route-id="@Model.Po?.SupplierId">Add a contact</a>.</span>
        }
        <button type="submit" class="btn btn-success">Send PO</button>
    </form>
    <form method="post" asp-page-handler="Delete" class="mt-3"
          onsubmit="return confirm('Delete this draft purchase order? This cannot be undone.');">
        <button type="submit" class="btn btn-outline-danger">Delete draft</button>
    </form>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Line</th><th>Stock</th><th>Qty LF</th><th>Received</th><th>Total</th></tr></thead>
        <tbody>
        @foreach (var line in Model.Po!.Lines.OrderBy(l => l.LineNumber))
        {
            <tr>
                <td>@line.LineNumber</td><td>@line.Stock.Description</td>
                <td>@line.QuantityLf.ToString("N2")</td><td>@line.QuantityReceivedLf.ToString("N2")</td>
                <td>@line.LineTotal.ToString("C2")</td>
            </tr>
        }
        </tbody>
    </table>
}

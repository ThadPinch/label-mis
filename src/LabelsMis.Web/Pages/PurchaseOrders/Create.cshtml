@page "/purchase-orders/create"
@model LabelsMis.Web.Pages.PurchaseOrders.CreateModel
@{
    ViewData["Title"] = "New purchase order";
    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New purchase order</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.SupplierId" class="form-label">Supplier</label>
        <select asp-for="Input.SupplierId" id="po-supplier" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Suppliers"]!)"></select>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="Input.ExpectedAt" class="form-label">Expected date</label>
            <input asp-for="Input.ExpectedAt" class="form-control" type="date" />
        </div>
        <div class="col-md-8">
            <label asp-for="Input.Notes" class="form-label">Notes</label>
            <textarea asp-for="Input.Notes" class="form-control" rows="1"></textarea>
        </div>
    </div>

    <partial name="_PoLines" model="Model.Input" />

    <div>
        <button type="submit" class="btn btn-primary">Create draft</button>
    </div>
</form>

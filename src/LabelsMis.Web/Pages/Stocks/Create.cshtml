@page "/stocks/create"
@model LabelsMis.Web.Pages.Stocks.CreateModel
@{
    ViewData["Title"] = "New stock";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New stock</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_StockForm" model="Model.Input" />
    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

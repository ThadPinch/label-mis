@page "/stocks"
@model LabelsMis.Web.Pages.Stocks.IndexModel
@{
    ViewData["Title"] = "Stocks";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["StockType"] = Model.StockType?.ToString(),
        ["IncludeInactive"] = Model.IncludeInactive ? "true" : null,
        ["Sort"] = Model.Sort
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stocks</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-primary" asp-page="Create">New stock</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input asp-for="Search" class="form-control" placeholder="Search code or description" />
    </div>
    <div class="col-md-2">
        <select asp-for="StockType" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.StockType>()">
            <option value="">All types</option>
        </select>
    </div>
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-2 form-check align-self-center">
        <input asp-for="IncludeInactive" class="form-check-input" />
        <label asp-for="IncludeInactive" class="form-check-label">Show inactive</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Code", "code", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Description", "description", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Type", "type", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Supplier", "supplier", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Active", "active", Model.Sort, route))</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr>
            <td>@item.Code</td>
            <td>@item.Description</td>
            <td>@item.StockType</td>
            <td>@item.SupplierName</td>
            <td>@(item.IsActive ? "Yes" : "No")</td>
            <td class="text-end text-nowrap">
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@(Model.CanEdit ? "Edit" : "View")</a>
                @if (Model.CanEdit)
                {
                    <a asp-page="Create" asp-route-duplicateFrom="@item.Id" class="btn btn-sm btn-outline-secondary">Duplicate</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount,
    Model.Search,
    Model.Sort,
    Model.IncludeInactive,
    Model.StockType?.ToString()))

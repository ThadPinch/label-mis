@page "/stocks/edit/{id:guid}"
@model LabelsMis.Web.Pages.Stocks.EditModel
@{
    ViewData["Title"] = "Edit stock";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">Edit stock</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_StockForm" model="Model.Input" />
    @if (Model.CanEdit)
    {
        <button type="submit" class="btn btn-primary">Save</button>
        @if (Model.IsActive)
        {
            <button type="submit" asp-page-handler="Deactivate" class="btn btn-outline-danger"
                    onclick="return confirm('Deactivate this stock?');">Deactivate</button>
        }
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

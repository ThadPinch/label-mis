@model LabelsMis.Web.Pages.ShippingMethods.ShippingMethodFormInput
@using LabelsMis.Domain.Enums

<div class="row g-3">
    <div class="col-md-5">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MethodType" class="form-label"></label>
        <select asp-for="MethodType" asp-items="Html.GetEnumSelectList<ShippingMethodType>()" class="form-select"></select>
        <span class="form-text">FedEx is a label only — no live rates are pulled. Customer account = shipped on the customer's own carrier account, billed $0.</span>
    </div>
    <div class="col-md-3">
        <label asp-for="Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Price" class="form-control" />
        </div>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <input asp-for="Notes" class="form-control" maxlength="500" />
        <span asp-validation-for="Notes" class="text-danger"></span>
        <div class="form-text">Shown next to the method on estimates and orders, e.g. how its price is billed.</div>
    </div>
    <div class="col-12 form-check ms-1">
        <input asp-for="RequiresAddress" class="form-check-input" />
        <label asp-for="RequiresAddress" class="form-check-label"></label>
        <div class="form-text">Uncheck for methods like pickup where no ship-to address is needed — the address fields are hidden on estimates and orders.</div>
    </div>
    <div class="col-12 form-check ms-1">
        <input asp-for="RequiresShipmentRecord" class="form-check-input" />
        <label asp-for="RequiresShipmentRecord" class="form-check-label"></label>
        <div class="form-text">
            Checked (carriers like FedEx): production can't mark these jobs shipped — they wait on
            Shipping → Ready to ship until the shipment is recorded with its packages, tracking and carrier
            cost, which is what the shipping charge is billed from. Unchecked (pickup, local delivery,
            customer account): <strong>Mark shipped</strong> records a shipment by itself.
        </div>
    </div>
</div>

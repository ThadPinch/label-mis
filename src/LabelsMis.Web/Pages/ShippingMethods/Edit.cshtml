@page "/shipping-methods/edit/{id:guid}"
@model LabelsMis.Web.Pages.ShippingMethods.EditModel
@{
    ViewData["Title"] = "Edit shipping method";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">Edit shipping method</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_ShippingMethodForm" model="Model.Input" />
    @if (Model.CanEdit)
    {
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>
            @if (Model.IsActive)
            {
                <button type="submit" asp-page-handler="Deactivate" class="btn btn-outline-danger"
                        onclick="return confirm('Deactivate this shipping method?');">Deactivate</button>
            }
        </div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

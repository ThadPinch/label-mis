@page "/search"
@model LabelsMis.Web.Pages.Search.IndexModel
@using LabelsMis.Web.Services.Search
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Search" : $"Search: {Model.Query}";
    var q = Model.Results.Query;
    var total = Model.AllGroups.Sum(g => g.Hits.Count);
    var anyMore = Model.AllGroups.Any(g => g.HasMore);
    var terms = q.Terms;
}

@functions {
    private static string ToneClass(SearchTone tone) => "tone-" + tone.ToString().ToLowerInvariant();

    /// <summary>Wraps each search term's occurrences in &lt;mark&gt;, encoding everything else.</summary>
    private static Microsoft.AspNetCore.Html.IHtmlContent Highlight(string? text, IReadOnlyList<string> terms)
    {
        if (string.IsNullOrEmpty(text))
        {
            return Microsoft.AspNetCore.Html.HtmlString.Empty;
        }

        var wanted = terms.Where(t => t.Length > 0).OrderByDescending(t => t.Length).ToList();
        if (wanted.Count == 0)
        {
            return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text));
        }

        var pattern = string.Join("|", wanted.Select(System.Text.RegularExpressions.Regex.Escape));
        var parts = System.Text.RegularExpressions.Regex.Split(text, $"({pattern})",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
        var html = new System.Text.StringBuilder();
        for (var i = 0; i < parts.Length; i++)
        {
            var encoded = System.Net.WebUtility.HtmlEncode(parts[i]);
            html.Append(i % 2 == 1 ? $"<mark>{encoded}</mark>" : encoded);
        }

        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }
}

<div class="search-page">
    <header class="search-page-head">
        <form method="get" class="search-page-form" role="search">
            <div class="search-page-box">
                <svg class="search-page-icon" aria-hidden="true"><use href="#si-search" /></svg>
                <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Job, order, customer, PO, SKU, invoice, tracking #, roll, or a size like 2x3" aria-label="Search everything" autofocus />
                <input type="hidden" name="all" value="true" />
                @if (Model.OnlyCategory is { } typeOnly)
                {
                    <input type="hidden" name="type" value="@GlobalSearchService.CategoryKey(typeOnly)" />
                }
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </header>

    @if (q.IsEmpty)
    {
        <div class="search-page-empty">
            <p class="mb-1"><strong>Search everything from one box.</strong> The bar at the top of every page does the same — press <kbd>/</kbd> to jump to it.</p>
            <p class="text-muted mb-0">Type a job, sales order, estimate, invoice, shipment or PO number (<code>52</code>, <code>job 52</code>, <code>SO-2026-00052</code>), a customer or contact, a customer PO, a product SKU or description, a tracking number, a roll barcode or lot, or a label size like <code>2x3</code> to find dies and products.</p>
        </div>
    }
    else if (total == 0)
    {
        <div class="search-page-empty">
            <p class="mb-1"><strong>Nothing matches “@q.Text”.</strong></p>
            <p class="text-muted mb-0">Check the spelling, try fewer words, or search by a number (job, order, PO, invoice, tracking).</p>
        </div>
    }
    else
    {
        <nav class="search-tabs" aria-label="Result categories">
            <a class="search-tab @(Model.OnlyCategory is null ? "active" : "")" href="?q=@Uri.EscapeDataString(q.Text)&amp;all=true">
                All <span class="search-tab-count">@total@(anyMore ? "+" : "")</span>
            </a>
            @foreach (var g in Model.AllGroups)
            {
                <a class="search-tab @(Model.OnlyCategory == g.Category ? "active" : "")"
                   href="?q=@Uri.EscapeDataString(q.Text)&amp;type=@GlobalSearchService.CategoryKey(g.Category)&amp;all=true">
                    @g.Label <span class="search-tab-count">@g.Hits.Count@(g.HasMore ? "+" : "")</span>
                </a>
            }
        </nav>

        <div class="search-groups">
            @foreach (var g in Model.Results.Groups)
            {
                var key = GlobalSearchService.CategoryKey(g.Category);
                <section class="search-group" id="results-@key">
                    <header class="search-group-head">
                        <h2>
                            <span class="as-icon as-icon-@key" aria-hidden="true"><svg><use href="#si-@key" /></svg></span>
                            @g.Label
                            <span class="search-group-count">@g.Hits.Count@(g.HasMore ? "+" : "")</span>
                        </h2>
                        <div class="search-group-links">
                            @if (g.HasMore && Model.OnlyCategory is null)
                            {
                                <a href="?q=@Uri.EscapeDataString(q.Text)&amp;type=@key&amp;all=true">Show more</a>
                            }
                            @if (g.SeeAllUrl is { } listUrl)
                            {
                                <a href="@listUrl">Open in the @g.Label.ToLowerInvariant() list →</a>
                            }
                        </div>
                    </header>
                    <ul class="search-hits">
                        @foreach (var hit in g.Hits)
                        {
                            <li>
                                <a class="search-hit" href="@hit.Url">
                                    <span class="search-hit-text">
                                        <span class="search-hit-title">@Highlight(hit.Title, terms)</span>
                                        @if (!string.IsNullOrWhiteSpace(hit.Subtitle))
                                        {
                                            <span class="search-hit-sub">@Highlight(hit.Subtitle, terms)</span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(hit.Badge))
                                    {
                                        <span class="as-badge @ToneClass(hit.Tone)">@hit.Badge</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

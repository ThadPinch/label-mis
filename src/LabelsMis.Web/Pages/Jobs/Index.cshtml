@page "/jobs"
@model LabelsMis.Web.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Jobs";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["StatusFilter"] = Model.StatusFilter,
        ["CustomerId"] = Model.CustomerId?.ToString(),
        ["PressId"] = Model.PressId?.ToString(),
        ["DueFrom"] = Model.DueFrom?.ToString("yyyy-MM-dd"),
        ["DueTo"] = Model.DueTo?.ToString("yyyy-MM-dd"),
        ["ScheduledDate"] = Model.ScheduledDate?.ToString("yyyy-MM-dd"),
        ["Sort"] = Model.Sort
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Jobs</h1>
</div>

@if (TempData["JobActionError"] is string actionError)
{
    <div class="alert alert-danger">@actionError</div>
}

<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-2">
        <input asp-for="Search" class="form-control" placeholder="Search job, customer, product" />
    </div>
    <div class="col-md-2">
        <select asp-for="StatusFilter" class="form-select">
            <option value="live">Live statuses</option>
            <option value="all">All statuses</option>
            @foreach (var s in Enum.GetValues<LabelsMis.Domain.Enums.JobStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="CustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["CustomerOptions"]!)">
            <option value="">All customers</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="PressId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["PressOptions"]!)">
            <option value="">All presses</option>
        </select>
    </div>
    <div class="col-md-1">
        <input asp-for="DueFrom" class="form-control" type="date" placeholder="Due from" />
    </div>
    <div class="col-md-1">
        <input asp-for="DueTo" class="form-control" type="date" />
    </div>
    <div class="col-md-1">
        <input asp-for="ScheduledDate" class="form-control" type="date" title="Scheduled date" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Job #", "number", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Order", "order", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Customer", "customer", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Product", "product", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Status", "status", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Due", "due", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Scheduled", "scheduled", Model.Sort, route))</th>
            <th class="text-end">@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Qty", "qty", Model.Sort, route))</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr>
            <td class="text-nowrap"><a asp-page="Detail" asp-route-id="@item.Id">@item.JobNumber</a></td>
            <td class="text-nowrap"><a asp-page="/SalesOrders/Edit" asp-route-id="@item.SalesOrderId">@item.OrderNumber</a></td>
            <td>@item.CustomerName</td>
            <td>@item.ProductDescription</td>
            <td class="text-nowrap">@item.Status @if (item.IsOutsourced) { <span class="badge text-bg-info">Outsourced</span> }</td>
            <td class="text-nowrap">@(item.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td class="text-nowrap">@(item.ScheduledForDate?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td class="text-end">@item.QuantityOrdered.ToString("N0")</td>
            <td class="text-end text-nowrap">
                @if (Model.CanAdvance && LabelsMis.Web.Services.Jobs.JobService.NextStep(item.Status) is { } step)
                {
                    <button type="button" class="btn btn-sm btn-primary"
                            data-action-panel="?handler=ActionPanel&jobId=@item.Id">
                        @step.Label…
                    </button>
                }
                <a asp-page="Ticket" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ticket</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_JobActionModalHost" />

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount)
{
    Extra = route
})

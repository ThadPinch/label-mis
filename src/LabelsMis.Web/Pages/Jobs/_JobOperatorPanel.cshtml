@using LabelsMis.Domain.Enums
@using LabelsMis.Web.Pages.Production
@model LabelsMis.Web.Pages.Jobs.DetailModel
@{
    var job = Model.Detail!.Job;
    var status = job.Status;
    var countsView = Model.CountOperations.FirstOrDefault(o => o.Id == Model.DefaultCountsOperationId);

    // Counts are part of the advance action everywhere production has happened; pre-press has
    // nothing to count yet, so its advance stays a plain button.
    var showCounts = Model.CanRecordCounts && countsView is not null && status != JobStatus.PrePress;
}
<div class="card">
    <div class="card-header py-2">
        <strong>Current step: @status</strong>
    </div>
    <div class="card-body py-2">
        <ul class="nav nav-pills nav-pills-sm mb-2 flex-wrap small">
            @foreach (var stage in ProductionStages.All)
            {
                var active = stage.Status == status;
                var done = (int)stage.Status < (int)status;
                <li class="nav-item">
                    <span class="nav-link @(active ? "active" : "") @(done && !active ? "text-success" : "")">
                        @(done ? "✓ " : "")@stage.Label
                    </span>
                </li>
            }
        </ul>

        @if (status == JobStatus.Printed && Model.FinishingTasks.Count > 0)
        {
            var remaining = Model.FinishingTasks.Count(t => !t.IsDone);
            <p class="form-text mb-2">
                Complete each finishing task, entering how long it took (less than planned if it ran
                faster). The job moves to Rewinding once all are done (@remaining remaining).
            </p>
            <ul class="list-group list-group-flush mb-0">
                @foreach (var task in Model.FinishingTasks)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                @task.Label
                                @if (task.IsLamination)
                                {
                                    <span class="badge text-bg-info ms-1">Laminate</span>
                                }
                                <span class="text-muted small ms-1">planned @task.PlannedMinutes.ToString("N0") min</span>
                            </span>
                            @if (task.IsDone)
                            {
                                <span class="badge text-bg-success">Done@(task.ActualMinutes > 0 ? $" — {task.ActualMinutes:N0} min" : "")</span>
                            }
                            else if (Model.CanAdvanceStage)
                            {
                                <form method="post" asp-page-handler="CompleteFinishingTask" class="d-flex align-items-center gap-1">
                                    <input type="hidden" name="operationId" value="@task.OperationId" />
                                    <div class="input-group input-group-sm" style="width: 11rem;">
                                        <input name="actualMinutes" type="number" min="0" step="0.5" class="form-control"
                                               value="@task.PlannedMinutes.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                               aria-label="Time taken in minutes" />
                                        <span class="input-group-text">min</span>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Complete</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@task.Status</span>
                            }
                        </div>
                        @if (task.IsLamination && !task.IsDone && Model.CanOperate)
                        {
                            <form method="post" asp-page-handler="RecordRollUsage" class="row g-2 align-items-end mt-2">
                                <div class="col-md-5">
                                    <label class="form-label">Laminate roll barcode</label>
                                    <input name="RollBarcode" class="form-control" autocomplete="off" placeholder="Scan or enter barcode" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Linear feet used</label>
                                    <input name="ConsumedLf" class="form-control" type="number" min="0" step="0.01" />
                                </div>
                                <div class="col-md-auto">
                                    <button type="submit" class="btn btn-outline-secondary">Record usage</button>
                                </div>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        else if (Model.NextStep is { } step)
        {
            @if (status == JobStatus.Queued && Model.CanOperate)
            {
                <form method="post" asp-page-handler="RecordRollUsage" class="row g-2 align-items-end mb-2">
                    <div class="col-md-5">
                        <label asp-for="RollBarcode" class="form-label small mb-0">Roll barcode</label>
                        <input asp-for="RollBarcode" class="form-control form-control-sm" autocomplete="off" placeholder="Scan or enter barcode" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConsumedLf" class="form-label small mb-0">Linear feet used</label>
                        <input asp-for="ConsumedLf" class="form-control form-control-sm" type="number" min="0" step="0.01" />
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Record usage</button>
                    </div>
                </form>
                <hr class="my-2" />
            }

            @if (Model.CanAdvanceStage)
            {
                var buttonLabel = showCounts
                    ? $"Record & {char.ToLowerInvariant(step.Label[0])}{step.Label[1..]}"
                    : step.Label;
                <form method="post" asp-page-handler="RecordAndAdvance" class="row g-2 align-items-end">
                    @if (showCounts && countsView is not null)
                    {
                        <input type="hidden" name="OperationId" value="@countsView.Id" />
                        <div class="col-12 small fw-semibold">
                            Production counts — @countsView.Label
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Good</label>
                            <input name="GoodCount" type="number" min="0" value="@countsView.PrefillGood" class="form-control form-control-sm" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Waste</label>
                            <input name="WasteCount" type="number" min="0" value="@countsView.PrefillWaste" class="form-control form-control-sm" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Time taken (min)</label>
                            <input name="ActualMinutes" type="number" min="0" step="0.5" value="@countsView.PrefillActualMinutes.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small mb-0">Downtime (min)</label>
                            <input name="DowntimeMinutes" type="number" min="0" step="0.5" value="@countsView.PrefillDowntime.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Downtime reason</label>
                            <select name="DowntimeReason" class="form-select form-select-sm">
                                <option value="">—</option>
                                @foreach (var reason in Enum.GetValues<DowntimeReasonCode>())
                                {
                                    <option value="@((int)reason)" selected="@(countsView.Reason == reason)">@reason</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-sm btn-primary w-100">@buttonLabel</button>
                        </div>
                        <div class="col-12">
                            <div class="form-text mt-0">
                                @(countsView.HasRecorded
                                    ? "Adjusting previously recorded values — saving replaces them."
                                    : $"Prefilled with the expected counts and the planned {countsView.PlannedMinutes:N0} min — enter less time if the step ran faster.")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">@step.Label</button>
                        </div>
                    }
                </form>
            }
            else
            {
                <p class="text-muted mb-0">Next: @step.Label</p>
            }

            @if (status == JobStatus.Rewound && Model.CanShip)
            {
                <a asp-page="/Shipments/Record" asp-route-salesOrderId="@Model.Detail!.SalesOrderId" class="btn btn-success btn-sm mt-2">Record shipment</a>
            }
        }
        else
        {
            <p class="text-muted mb-0">This job has completed production.</p>
        }
    </div>
</div>

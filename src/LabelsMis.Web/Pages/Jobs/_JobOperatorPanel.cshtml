@using LabelsMis.Domain.Enums
@using LabelsMis.Web.Pages.Production
@model LabelsMis.Web.Pages.Jobs.DetailModel
@{
    var job = Model.Detail!.Job;
    var status = job.Status;
}
<div class="card mb-4">
    <div class="card-header">
        <strong>Current step: @status</strong>
    </div>
    <div class="card-body">
        <ul class="nav nav-pills mb-3 flex-wrap">
            @foreach (var stage in ProductionStages.All)
            {
                var active = stage.Status == status;
                var done = (int)stage.Status < (int)status;
                <li class="nav-item">
                    <span class="nav-link @(active ? "active" : "") @(done && !active ? "text-success" : "")">
                        @(done ? "✓ " : "")@stage.Label
                    </span>
                </li>
            }
        </ul>

        @if (status == JobStatus.Printed)
        {
            @if (Model.FinishingTasks.Count == 0)
            {
                <p class="text-muted mb-2">No finishing tasks on this job.</p>
                @if (Model.CanAdvanceStage)
                {
                    <form method="post" asp-page-handler="AdvanceStage">
                        <button type="submit" class="btn btn-primary">Mark finished</button>
                    </form>
                }
            }
            else
            {
                var remaining = Model.FinishingTasks.Count(t => !t.IsDone);
                <p class="form-text mb-2">
                    Complete each finishing task. The job moves to Rewinding once all are done (@remaining remaining).
                </p>
                <ul class="list-group list-group-flush mb-0">
                    @foreach (var task in Model.FinishingTasks)
                    {
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>
                                    @task.Label
                                    @if (task.IsLamination)
                                    {
                                        <span class="badge text-bg-info ms-1">Laminate</span>
                                    }
                                </span>
                                @if (task.IsDone)
                                {
                                    <span class="badge text-bg-success">Done</span>
                                }
                                else if (Model.CanAdvanceStage)
                                {
                                    <form method="post" asp-page-handler="CompleteFinishingTask" class="d-inline">
                                        <input type="hidden" name="operationId" value="@task.OperationId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Complete</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@task.Status</span>
                                }
                            </div>
                            @if (task.IsLamination && !task.IsDone && Model.CanOperate)
                            {
                                <form method="post" asp-page-handler="RecordRollUsage" class="row g-2 align-items-end mt-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Laminate roll barcode</label>
                                        <input name="RollBarcode" class="form-control" autocomplete="off" placeholder="Scan or enter barcode" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Linear feet used</label>
                                        <input name="ConsumedLf" class="form-control" type="number" min="0" step="0.01" />
                                    </div>
                                    <div class="col-md-auto">
                                        <button type="submit" class="btn btn-outline-secondary">Record usage</button>
                                    </div>
                                    <div class="col-12"><div class="form-text">Scan the laminate roll and enter linear feet used. Appears under Material usage below.</div></div>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
        }
        else if (status == JobStatus.Queued)
        {
            @if (Model.CanOperate)
            {
                <form method="post" asp-page-handler="RecordRollUsage" class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label asp-for="RollBarcode" class="form-label">Roll barcode</label>
                        <input asp-for="RollBarcode" class="form-control" autocomplete="off" placeholder="Scan or enter barcode" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConsumedLf" class="form-label">Linear feet used</label>
                        <input asp-for="ConsumedLf" class="form-control" type="number" min="0" step="0.01" />
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-outline-secondary">Record usage</button>
                    </div>
                </form>
                <div class="form-text mb-3">Scan a roll and enter the linear feet consumed on this run. Recorded usage appears under Material usage below.</div>
            }
            @if (Model.CanAdvanceStage)
            {
                <form method="post" asp-page-handler="AdvanceStage">
                    <button type="submit" class="btn btn-primary">Mark printed</button>
                </form>
            }
        }
        else if (Model.NextStep is { } step)
        {
            @if (Model.CanAdvanceStage)
            {
                <form method="post" asp-page-handler="AdvanceStage">
                    <button type="submit" class="btn btn-primary">@step.Label</button>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">Next: @step.Label</p>
            }
        }
        else
        {
            <p class="text-muted mb-0">This job has completed production.</p>
        }
    </div>
</div>

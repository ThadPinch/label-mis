@page "/jobs/{id:guid}"
@model LabelsMis.Web.Pages.Jobs.DetailModel
@using LabelsMis.Domain.Enums
@{ ViewData["Title"] = Model.Detail?.Job.JobNumber ?? "Job"; ViewData["BackNav"] = new BackNavModel(); }

@functions {
    private static string PopRow(string label, string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? ""
            : $"<div class='d-flex justify-content-between gap-3'><span class='text-muted'>{System.Net.WebUtility.HtmlEncode(label)}</span><span class='text-end'>{System.Net.WebUtility.HtmlEncode(value)}</span></div>";

    private string DiePopover()
    {
        var die = Model.DieInfo!;
        return PopRow("Type", die.DieType.ToString())
            + PopRow("Shape", die.Shape)
            + PopRow("Label size", $"{die.LabelAcrossIn:0.####}\" × {die.LabelAroundIn:0.####}\"")
            + PopRow("Corner radius", $"{die.CornerRadiusIn:0.####}\"")
            + PopRow("Gutters", $"{die.GutterAcrossIn:0.####}\" × {die.GutterAroundIn:0.####}\"")
            + PopRow("Layout", $"{die.LabelsAcross} across × {die.LabelsAround} around")
            + PopRow("Die repeat", die.DieRepeatIn is { } dieRepeat ? $"{dieRepeat:0.0000}\"" : null)
            + PopRow("Liner spec", die.LinerSpec)
            + PopRow("Web width", $"{die.WebWidthIn:0.####}\"")
            + PopRow("Owner", die.Customer?.Name)
            + PopRow("Supplier", die.Supplier is null ? null : $"{die.Supplier.Name}{(string.IsNullOrWhiteSpace(die.SupplierPartNumber) ? "" : $" · {die.SupplierPartNumber}")}")
            + PopRow("Location", die.Location)
            + PopRow("Usage", die.LastUsedAt is { } used ? $"{die.UsageCount} runs · last {used:MMM d, yyyy}" : $"{die.UsageCount} runs");
    }

    private string SubstratePopover()
    {
        var stock = Model.Detail!.Substrate;
        return PopRow("Code", stock.Code)
            + PopRow("Type", stock.StockType.ToString())
            + PopRow("Face material", stock.FaceMaterial)
            + PopRow("Adhesive", stock.Adhesive)
            + PopRow("Liner", stock.Liner)
            + PopRow("Shrink layflat", stock.ShrinkLayflatIn is { } stockLayflat ? $"{stockLayflat:0.0000}\"" : null)
            + PopRow("Caliper", $"{stock.TotalCaliperMil:0.##} mil")
            + PopRow("Roll width", $"{stock.WidthIn:0.###}\"")
            + PopRow("Supplier part #", stock.SupplierPartNumber);
    }

    private string InkPopover()
    {
        var spec = Model.Detail!.Job.Spec;
        var content = PopRow("Ink set", (spec?.InkSet ?? Model.TicketDetail?.InkSet)?.ToString());
        if (spec is { WhiteHits: > 0 })
        {
            content += PopRow("White", $"{spec.WhiteHits} hit{(spec.WhiteHits == 1 ? "" : "s")} @ {spec.WhiteCoveragePct * 100:0}%");
        }

        foreach (var (ink, hits, coverage) in Model.SpotInkInfo)
        {
            content += PopRow($"{ink.Code} — {ink.Description}", $"{hits} hit{(hits == 1 ? "" : "s")} @ {coverage * 100:0}%{(ink.SpotColor is { } sc ? $" · {sc}" : "")}");
        }

        return content;
    }
}

@if (Model.Detail is null)
{
    <p>Job not found.</p>
}
else
{
    var ticket = Model.TicketDetail;
    var artworkInlineUrl = Url.Page("/Artwork/Download", new { productId = Model.Detail.Job.ProductId, inline = true });

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex flex-wrap align-items-baseline gap-2">
            <h1 class="h3 mb-0">@Model.Detail.Job.JobNumber</h1>
            <span class="badge text-bg-primary">@Model.Detail.Job.Status</span>
            @if (Model.Detail.Job.IsOutsourced)
            {
                <span class="badge text-bg-info">Outsourced</span>
            }
            <span class="text-muted">@Model.Detail.CustomerName — @Model.Detail.ProductDescription</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.CanChangeStatus)
            {
                <form method="post" asp-page-handler="SetStatus" class="d-flex align-items-center gap-1">
                    <select asp-for="StatusInput" class="form-select form-select-sm" style="width: auto" asp-items="Html.GetEnumSelectList<JobStatus>()"></select>
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Set status</button>
                </form>
            }
            <a asp-page="Ticket" asp-route-id="@Model.Detail.Job.Id" class="btn btn-sm btn-outline-secondary text-nowrap">Print ticket</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Detail.Job.IsOutsourced && Model.Detail.Outsource is { } outsource)
    {
        <div class="alert alert-info py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>OUTSOURCED</strong> — made by <strong>@(outsource.VendorName ?? "vendor not set")</strong>@(outsource.QuoteNumber is not null ? $", quote {outsource.QuoteNumber}" : "").
                Expected in <strong>@(outsource.ExpectedIn?.ToString("yyyy-MM-dd") ?? "—")</strong>@(outsource.SentToVendorAt is { } sent ? $" · sent {sent:yyyy-MM-dd}" : " · not yet sent")@(outsource.ReceivedAt is { } rec ? $" · received {rec.ToLocalTime():yyyy-MM-dd}" : outsource.QuantityReceived > 0 ? $" · {outsource.QuantityReceived:N0} received so far" : "").
                No press or finishing steps — the job goes straight to Shipping when received.
                @if (!string.IsNullOrWhiteSpace(outsource.PrivateNotes))
                {
                    <div class="small mt-1"><span class="text-muted">Private notes:</span> @outsource.PrivateNotes</div>
                }
            </div>
            <a asp-page="/Production/Outsourced" asp-route-Search="@Model.Detail.OrderNumber" class="btn btn-sm btn-outline-primary">Send / receive</a>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-lg-7 d-flex flex-column gap-3">
            @{
                var impositionStatusClass = Model.Imposition?.ImposedArtworkFilePath is null
                    ? "text-bg-secondary"
                    : Model.Imposition.ImposedIsStale ? "text-bg-warning" : "text-bg-success";
                var impositionStatusText = Model.Imposition?.ImposedArtworkFilePath is null
                    ? "not run"
                    : Model.Imposition.ImposedIsStale ? "stale" : "imposed";
            }
            <div class="card" id="artwork">
                <div class="card-header py-2">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist" id="artwork-tabs">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="artwork-tab-original-btn" data-bs-toggle="tab" data-bs-target="#artwork-tab-original" type="button" role="tab" aria-controls="artwork-tab-original" aria-selected="true">
                                Original artwork
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="artwork-tab-imposition-btn" data-bs-toggle="tab" data-bs-target="#artwork-tab-imposition" type="button" role="tab" aria-controls="artwork-tab-imposition" aria-selected="false">
                                Imposition
                                @if (Model.Imposition is not null)
                                {
                                    <span class="badge rounded-pill @impositionStatusClass ms-1 fw-normal">@impositionStatusText</span>
                                }
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="artwork-tab-original" role="tabpanel" aria-labelledby="artwork-tab-original-btn">
                        <div class="artwork-toolbar py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                            <span class="text-truncate small">
                                @if (Model.ArtworkFileName is { } artworkFileName)
                                {
                                    <span class="fw-semibold">@artworkFileName</span>
                                    <span class="text-muted ms-1">— the unimposed original on the product</span>
                                }
                                else
                                {
                                    <span class="text-muted">No artwork on file for this product yet.</span>
                                }
                            </span>
                            <div class="d-flex gap-1">
                                @if (Model.HasArtwork)
                                {
                                    @if (Model.ArtworkIsPdf || Model.ArtworkIsImage)
                                    {
                                        <button type="button" id="artwork-expand" class="btn btn-sm btn-outline-secondary">Expand</button>
                                    }
                                    <a href="@artworkInlineUrl" target="_blank" class="btn btn-sm btn-outline-secondary">Open</a>
                                    <a asp-page="/Artwork/Download" asp-route-productId="@Model.Detail.Job.ProductId" class="btn btn-sm btn-outline-secondary">Download</a>
                                }
                            </div>
                        </div>
                        @if (Model.HasArtwork && Model.ArtworkIsPdf)
                        {
                            <div id="artwork-viewer" class="artwork-viewer d-none">
                                <iframe data-src="@artworkInlineUrl" title="Artwork preview" style="width: 100%; height: 100%; border: 0;"></iframe>
                            </div>
                        }
                        else if (Model.HasArtwork && Model.ArtworkIsImage)
                        {
                            <div id="artwork-viewer" class="artwork-viewer d-none overflow-auto d-flex align-items-center justify-content-center bg-light">
                                <img data-src="@artworkInlineUrl" alt="Artwork preview" style="max-width: 100%; max-height: 100%;" />
                            </div>
                        }
                        else if (Model.HasArtwork)
                        {
                            <div class="card-body py-4 text-center text-muted">
                                No in-browser preview for this file type — use Download to view it.
                            </div>
                        }
                        <div class="card-footer py-2">
                            <form id="artwork-upload-form" method="post" asp-page-handler="UploadArtwork" enctype="multipart/form-data" data-product-id="@Model.Detail.Job.ProductId">
                                <div class="input-group input-group-sm">
                                    <input asp-for="ArtworkFile" type="file" class="form-control" accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.tif,.tiff" />
                                    <button type="submit" class="btn btn-outline-primary">Upload</button>
                                </div>
                                <div class="artwork-upload-status d-none mt-1">
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <div class="small artwork-upload-message mt-1 text-muted"></div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="artwork-tab-imposition" role="tabpanel" aria-labelledby="artwork-tab-imposition-btn">
                        <partial name="_JobImpositionPanel" model="Model" />
                    </div>
                </div>
            </div>

            <partial name="_JobOperatorPanel" model="Model" />

            <div class="card">
                <div class="card-header py-2 fw-semibold">Operations</div>
                <table class="table table-sm table-striped small mb-0">
                    <thead>
                        <tr>
                            <th>#</th><th>Step</th><th>Equipment</th><th>Status</th><th class="text-end">Plan min</th><th class="text-end">Actual min</th><th class="text-end">Good</th><th class="text-end">Waste</th><th class="text-end">Downtime</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var op in Model.Detail.Operations)
                    {
                        var actualMinutes = Math.Round(op.Operation.ActualHours * 60m, 0);
                        <tr>
                            <td>@op.Operation.Sequence</td>
                            <td>@op.TypeLabel</td>
                            <td>@(op.EquipmentName ?? "—")</td>
                            <td>@op.Operation.Status</td>
                            <td class="text-end">@op.Operation.PlannedMinutes.ToString("N0")</td>
                            <td class="text-end @(actualMinutes == 0 ? "" : actualMinutes <= op.Operation.PlannedMinutes ? "text-success" : "text-danger")">
                                @(actualMinutes > 0 ? actualMinutes.ToString("N0") : "—")
                            </td>
                            <td class="text-end">@op.Operation.GoodCount.ToString("N0")</td>
                            <td class="text-end">@op.Operation.WasteCount.ToString("N0")</td>
                            <td class="text-end">@op.Operation.DowntimeMinutes.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-5 d-flex flex-column gap-3">
            <div class="card">
                <div class="card-body py-2">
                    <div class="small text-muted mb-1">
                        Order notes
                        <a asp-page="/SalesOrders/Edit" asp-route-id="@Model.Detail.SalesOrderId" class="ms-1">@Model.Detail.OrderNumber</a>
                    </div>
                    @if (Model.CanEditOrderNotes)
                    {
                        <form method="post" asp-page-handler="SaveOrderNotes">
                            <textarea asp-for="OrderNotes" class="form-control form-control-sm mb-1" rows="2" placeholder="Notes from the sales order"></textarea>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Save notes</button>
                        </form>
                    }
                    else
                    {
                        <p class="mb-0 small">@(string.IsNullOrWhiteSpace(Model.Detail.OrderNotes) ? "—" : Model.Detail.OrderNotes)</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body py-2">
                    <div class="row row-cols-4 text-center mb-2">
                        <div class="col">
                            <div class="small text-muted">Ordered</div>
                            <div class="fw-semibold">@Model.Detail.Job.QuantityOrdered.ToString("N0")</div>
                        </div>
                        <div class="col">
                            <div class="small text-muted">Planned</div>
                            <div class="fw-semibold">@Model.Detail.Job.QuantityPlanned.ToString("N0")</div>
                        </div>
                        <div class="col">
                            <div class="small text-muted">Good</div>
                            <div class="fw-semibold text-success">@Model.Detail.Job.TotalGoodCount.ToString("N0")</div>
                        </div>
                        <div class="col">
                            <div class="small text-muted">Waste</div>
                            <div class="fw-semibold text-danger">@Model.Detail.Job.TotalWasteCount.ToString("N0")</div>
                        </div>
                    </div>

                    <table class="table table-sm small mb-0 job-facts">
                        <tbody>
                            <tr>
                                <th class="text-muted fw-normal">Order</th>
                                <td>
                                    <a asp-page="/SalesOrders/Edit" asp-route-id="@Model.Detail.SalesOrderId">@Model.Detail.OrderNumber</a>
                                    @if (!string.IsNullOrWhiteSpace(ticket?.CustomerPoNumber))
                                    {
                                        <span class="text-muted">· PO @ticket.CustomerPoNumber</span>
                                    }
                                </td>
                            </tr>
                            @if (ticket is not null)
                            {
                                <tr><th class="text-muted fw-normal">SKU</th><td>@ticket.ProductSku</td></tr>
                                <tr><th class="text-muted fw-normal">Label size</th><td>@ticket.LabelAcrossIn.ToString("0.####")&quot; × @ticket.LabelAroundIn.ToString("0.####")&quot;</td></tr>
                                <tr>
                                    <th class="text-muted fw-normal">Die</th>
                                    <td>
                                        @if (Model.DieInfo is not null)
                                        {
                                            <span class="entity-pop" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus"
                                                  data-bs-html="true" data-bs-title="Die — @Model.DieInfo.Description" data-bs-content="@DiePopover()">
                                                @(ticket.DieDescription ?? Model.DieInfo.Description)
                                            </span>
                                        }
                                        else
                                        {
                                            @(ticket.DieDescription ?? "—")
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted fw-normal">Ink</th>
                                    <td>
                                        <span class="entity-pop" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus"
                                              data-bs-html="true" data-bs-title="Ink details" data-bs-content="@InkPopover()">
                                            @ticket.InkSet
                                            @if (!string.IsNullOrWhiteSpace(ticket.SpecialInksSummary))
                                            {
                                                <span class="text-muted">· @ticket.SpecialInksSummary</span>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <th class="text-muted fw-normal">Substrate</th>
                                <td>
                                    <span class="entity-pop" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus"
                                          data-bs-html="true" data-bs-title="Substrate — @Model.Detail.Substrate.Code" data-bs-content="@SubstratePopover()">
                                        @Model.Detail.Substrate.Description
                                    </span>
                                </td>
                            </tr>
                            <tr><th class="text-muted fw-normal">Unwind</th><td>@(Model.Detail.Job.Spec?.Unwind?.Label() ?? "—")</td></tr>
                            @if (Model.Detail.Job.Spec?.ShrinkLayflatIn is { } shrinkLayflat)
                            {
                                <tr><th class="text-muted fw-normal">Shrink layflat</th><td>@shrinkLayflat.ToString("0.0000")&quot;</td></tr>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Detail.LineNotes))
                            {
                                <tr><th class="text-muted fw-normal">Line notes</th><td>@Model.Detail.LineNotes</td></tr>
                            }
                            @if (ticket?.RequestedShipDate is { } shipBy)
                            {
                                <tr><th class="text-muted fw-normal">Ship by</th><td>@shipBy.ToString("MMM d, yyyy")</td></tr>
                            }
                            <tr>
                                <th class="text-muted fw-normal">Due</th>
                                <td>@(Model.Detail.Job.DueDate?.ToString("MMM d, yyyy") ?? "—")</td>
                            </tr>
                        </tbody>
                    </table>

                    @if (Model.CanEdit)
                    {
                        <form method="post" asp-page-handler="Schedule" class="mt-2">
                            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                            <label class="small text-muted">Schedule</label>
                            <div class="input-group input-group-sm">
                                <input asp-for="ScheduleInput.ScheduledForDate" class="form-control" type="date" />
                                <select asp-for="ScheduleInput.PressId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["PressOptions"]!)">
                                    <option value="">Unassigned</option>
                                </select>
                                <button type="submit" class="btn btn-outline-primary">Save</button>
                            </div>
                        </form>
                    }
                    else if (Model.Detail.Job.ScheduledForDate is { } scheduled)
                    {
                        <div class="small mt-2">
                            <span class="text-muted">Scheduled:</span>
                            @scheduled.ToString("MMM d, yyyy")@(ticket?.ScheduledPressName is { } press ? $" — {press}" : "")
                        </div>
                    }
                </div>
            </div>

            @if (Model.OrderJobs.Count > 1)
            {
                <div class="card">
                    <div class="card-body py-2">
                        <div class="small text-muted mb-1">
                            Jobs on order
                            <a asp-page="/SalesOrders/Edit" asp-route-id="@Model.Detail.SalesOrderId" class="ms-1">@Model.Detail.OrderNumber</a>
                        </div>
                        <ul class="list-group list-group-flush small">
                            @foreach (var orderJob in Model.OrderJobs)
                            {
                                var isCurrent = orderJob.JobId == Model.Detail.Job.Id;
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between align-items-center gap-2">
                                    <span class="text-truncate">
                                        @if (isCurrent)
                                        {
                                            <strong>@orderJob.JobNumber</strong>
                                        }
                                        else
                                        {
                                            <a asp-page="Detail" asp-route-id="@orderJob.JobId">@orderJob.JobNumber</a>
                                        }
                                        <span class="text-muted">— @orderJob.ProductDescription · @orderJob.QuantityOrdered.ToString("N0")</span>
                                    </span>
                                    <span class="badge @(orderJob.Status == JobStatus.Shipped ? "text-bg-success" : isCurrent ? "text-bg-primary" : "text-bg-secondary") text-nowrap">
                                        @orderJob.Status
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header py-2 fw-semibold">Material usage</div>
                @if (Model.Detail.Job.MaterialUsages.Count == 0)
                {
                    <div class="card-body py-3 small text-muted">No material usage recorded yet.</div>
                }
                else
                {
                    <table class="table table-sm table-striped small mb-0">
                        <thead><tr><th>Stock</th><th class="text-end">Qty (LF)</th><th>Used at</th><th>Notes</th></tr></thead>
                        <tbody>
                        @foreach (var usage in Model.Detail.Job.MaterialUsages.OrderByDescending(m => m.UsedAt))
                        {
                            <tr>
                                <td>@usage.Stock.Description</td>
                                <td class="text-end">@usage.QuantityUsedLf.ToString("N2")</td>
                                <td>@usage.UsedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(usage.Notes ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <style>
        .artwork-viewer {
            height: 78vh;
        }

        .job-facts th {
            width: 6.5rem;
            white-space: nowrap;
        }

        .entity-pop {
            text-decoration: underline dotted;
            text-decoration-color: var(--bs-secondary-color, #6c757d);
            text-underline-offset: 3px;
            cursor: help;
        }

        .entity-pop:hover {
            text-decoration-style: solid;
        }

        .entity-popover {
            --bs-popover-max-width: 22rem;
            font-size: 0.85rem;
        }
    </style>
}

@section Scripts {
    <script src="~/js/artwork-upload.js" asp-append-version="true"></script>
    <script src="~/js/roll-picker.js" asp-append-version="true"></script>
    <script src="~/js/job-imposition.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            LabelsMis.initJobArtworkUpload(document.getElementById('artwork-upload-form'));

            document.querySelectorAll('.entity-pop[data-bs-toggle="popover"]').forEach(el => {
                new bootstrap.Popover(el, { customClass: 'entity-popover' });
            });

            const expandButton = document.getElementById('artwork-expand');
            const viewer = document.getElementById('artwork-viewer');
            if (expandButton && viewer) {
                expandButton.addEventListener('click', () => {
                    const expanded = !viewer.classList.toggle('d-none');
                    expandButton.textContent = expanded ? 'Collapse' : 'Expand';
                    if (expanded) {
                        // The artwork file is only fetched on first expand.
                        const media = viewer.querySelector('[data-src]');
                        if (media && !media.src) {
                            media.src = media.dataset.src;
                        }
                        viewer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                });
            }
        });
    </script>
}

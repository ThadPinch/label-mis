@model LabelsMis.Web.Pages.Jobs.DetailModel
@using LabelsMis.Domain.Enums
@{
    var imposition = Model.Imposition;
    var job = Model.Detail!.Job;
    var canImpose = Model.CanImpose;
    var template = imposition?.Template;
    var imposedInlineUrl = Url.Page("/Jobs/ImposedArtwork", new { id = job.Id, inline = true });
    var imposedDownloadUrl = Url.Page("/Jobs/ImposedArtwork", new { id = job.Id });
    var localImposedAt = imposition?.ImposedAt?.ToLocalTime();
}
@if (imposition is not null && template is not null)
{
    <div id="imposition">
        <div class="artwork-toolbar py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <span class="d-flex flex-wrap align-items-center gap-2 small">
                @if (imposition.ImposedArtworkFilePath is null)
                {
                    <span class="badge text-bg-secondary">Not imposed yet</span>
                }
                else
                {
                    <span class="badge text-bg-success">Imposed @localImposedAt?.ToString("MMM d, HH:mm")</span>
                    @if (imposition.ImposedIsStale)
                    {
                        <span class="badge text-bg-warning" title="The product's artwork was replaced after this imposition was generated.">Artwork changed — re-run</span>
                    }
                }
                <span class="text-muted imposition-summary" data-imposition-summary>
                    @template.LabelsAcross × @template.LabelsAround = @template.LabelsPerFrame per frame ·
                    @template.WebWidthIn.ToString("0.###")&quot; × @template.RepeatLengthIn.ToString("0.###")&quot; repeat
                </span>
            </span>
            <div class="d-flex gap-1">
                @if (imposition.ImposedArtworkFilePath is not null)
                {
                    <button type="button" id="imposition-expand" class="btn btn-sm btn-outline-secondary">Expand</button>
                    <a href="@imposedInlineUrl" target="_blank" class="btn btn-sm btn-outline-secondary">Open</a>
                    <a href="@imposedDownloadUrl" class="btn btn-sm btn-outline-secondary">Download</a>
                }
            </div>
        </div>

        @if (imposition.ImposedArtworkFilePath is not null)
        {
            <div id="imposition-viewer" class="artwork-viewer d-none">
                <iframe data-src="@imposedInlineUrl" title="Imposed frame preview" style="width: 100%; height: 100%; border: 0;"></iframe>
            </div>
        }

        <div class="card-body py-2">
            @if (!string.IsNullOrWhiteSpace(Model.ImpositionMessage))
            {
                <div class="alert alert-success py-2 small mb-2">@Model.ImpositionMessage</div>
            }
            @if (Model.ImpositionWarnings.Count > 0)
            {
                <div class="alert alert-warning py-2 small mb-2">
                    <div class="fw-semibold mb-1">Imposition ran with warnings</div>
                    <ul class="mb-0 ps-3">
                        @foreach (var warning in Model.ImpositionWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ImpositionError))
            {
                <div class="alert alert-danger py-2 small mb-2">@Model.ImpositionError</div>
            }

            @if (imposition.IsSeeded)
            {
                <div class="form-text mb-2">
                    Starting layout seeded from @imposition.SeedSource — adjust anything here without touching the item's spec, then run.
                </div>
            }

            @if (!imposition.ArtworkCanBeImposed)
            {
                <div class="alert alert-secondary py-2 small mb-2">
                    @if (imposition.ArtworkFilePath is null)
                    {
                        <span>Upload the product's artwork above (PDF or PDF-compatible .ai, or PNG/JPEG) to run the imposition.</span>
                    }
                    else
                    {
                        <span>The current artwork (@imposition.ArtworkFileName) isn't a type the imposer can place — upload the label as a PDF (or PDF-compatible .ai) or a PNG/JPEG.</span>
                    }
                </div>
            }

            <form method="post" id="imposition-form" data-imposition-form>
                <div class="row g-2 small">
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Label across (in)</label>
                        <input asp-for="ImpositionForm.LabelAcrossIn" asp-format="{0:0.####}" class="form-control form-control-sm" data-imp="labelAcross" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Label around (in)</label>
                        <input asp-for="ImpositionForm.LabelAroundIn" asp-format="{0:0.####}" class="form-control form-control-sm" data-imp="labelAround" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Corner radius</label>
                        <input asp-for="ImpositionForm.CornerRadiusIn" asp-format="{0:0.####}" class="form-control form-control-sm" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Gutter across</label>
                        <input asp-for="ImpositionForm.GutterAcrossIn" asp-format="{0:0.####}" class="form-control form-control-sm" data-imp="gutterAcross" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Gutter around</label>
                        <input asp-for="ImpositionForm.GutterAroundIn" asp-format="{0:0.####}" class="form-control form-control-sm" data-imp="gutterAround" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Bleed</label>
                        <input asp-for="ImpositionForm.BleedIn" asp-format="{0:0.####}" class="form-control form-control-sm" disabled="@(!canImpose)" />
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Labels across</label>
                        <input asp-for="ImpositionForm.LabelsAcross" type="number" min="1" class="form-control form-control-sm" data-imp="across" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Labels around</label>
                        <input asp-for="ImpositionForm.LabelsAround" type="number" min="1" class="form-control form-control-sm" data-imp="around" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Orientation</label>
                        <select asp-for="ImpositionForm.Orientation" class="form-select form-select-sm" data-imp="orientation" disabled="@(!canImpose)">
                            <option value="@((int)LabelOrientation.AsEntered)">As entered</option>
                            <option value="@((int)LabelOrientation.Rotated)">Rotated 90°</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Web width (in)</label>
                        <input asp-for="ImpositionForm.WebWidthIn" asp-format="{0:0.####}" class="form-control form-control-sm" data-imp="webWidth" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Cross-web offset</label>
                        <input asp-for="ImpositionForm.CrossWebOffsetIn" asp-format="{0:0.####}" class="form-control form-control-sm" data-imp="offset" disabled="@(!canImpose)" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Eye marks</label>
                        <select asp-for="ImpositionForm.EyeMarks" class="form-select form-select-sm" disabled="@(!canImpose)">
                            <option value="@((int)ImpositionMarkSide.None)">None</option>
                            <option value="@((int)ImpositionMarkSide.Left)">Left margin</option>
                            <option value="@((int)ImpositionMarkSide.Right)">Right margin</option>
                            <option value="@((int)ImpositionMarkSide.Both)">Both margins</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Eye mark W × H (in)</label>
                        <div class="input-group input-group-sm">
                            <input asp-for="ImpositionForm.EyeMarkWidthIn" asp-format="{0:0.####}" class="form-control" disabled="@(!canImpose)" aria-label="Eye mark width" />
                            <span class="input-group-text px-1">×</span>
                            <input asp-for="ImpositionForm.EyeMarkHeightIn" asp-format="{0:0.####}" class="form-control" disabled="@(!canImpose)" aria-label="Eye mark height" />
                        </div>
                    </div>
                    <div class="col-6 col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="ImpositionForm.IncludeDieLines" class="form-check-input" disabled="@(!canImpose)" />
                            <label asp-for="ImpositionForm.IncludeDieLines" class="form-check-label small">Die lines (CutContour layer)</label>
                        </div>
                    </div>
                    <div class="col-6 col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="ImpositionForm.IncludeSlug" class="form-check-input" disabled="@(!canImpose)" />
                            <label asp-for="ImpositionForm.IncludeSlug" class="form-check-label small">Slug line</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 d-flex align-items-end">
                        <div class="form-text mb-1" data-imposition-live>
                            Block @template.BlockWidthIn.ToString("0.###")&quot; wide · margins @template.LeftMarginIn.ToString("0.###")&quot; / @template.RightMarginIn.ToString("0.###")&quot; · repeat @template.RepeatLengthIn.ToString("0.###")&quot;
                        </div>
                    </div>
                </div>

                @if (canImpose)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <button type="submit" asp-page-handler="RunImposition" class="btn btn-sm btn-primary" disabled="@(!imposition.ArtworkCanBeImposed)">
                            @(imposition.ImposedArtworkFilePath is null ? "Run imposition" : "Re-run imposition")
                        </button>
                        <button type="submit" asp-page-handler="SaveImposition" class="btn btn-sm btn-outline-primary">Save template</button>
                        <button type="submit" asp-page-handler="ResetImposition" class="btn btn-sm btn-outline-secondary" formnovalidate
                                title="Recompute the template from the job's die / estimate layout">Reset to default</button>
                        <span class="form-text mb-0">Saves the template on this job only — the product and order line keep their own spec.</span>
                    </div>
                }
            </form>
        </div>
    </div>
}

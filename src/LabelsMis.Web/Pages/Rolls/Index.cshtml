@page "/rolls"
@model LabelsMis.Web.Pages.Rolls.IndexModel
@{
    ViewData["Title"] = "Rolls";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["StockId"] = Model.StockId?.ToString(),
        ["StockType"] = Model.StockType?.ToString(),
        ["Status"] = Model.Status?.ToString(),
        ["Location"] = Model.Location,
        ["LotNumber"] = Model.LotNumber,
        ["Sort"] = Model.Sort
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Roll inventory</h1>
    @if (Model.CanEdit)
    {
        <a asp-page="Add" class="btn btn-primary">Add to inventory</a>
    }
</div>
<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-3"><input asp-for="Search" class="form-control" placeholder="Barcode or lot" autofocus /></div>
    <div class="col-md-2">
        <select asp-for="StockId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["StockOptions"]!)"><option value="">All stocks</option></select>
    </div>
    <div class="col-md-2">
        <select asp-for="StockType" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.StockType>()"><option value="">All types</option></select>
    </div>
    <div class="col-md-2">
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.RollStatus>()"><option value="">All statuses</option></select>
    </div>
    <div class="col-md-2"><input asp-for="Location" class="form-control" placeholder="Location" /></div>
    <div class="col-md-1"><button type="submit" class="btn btn-outline-secondary w-100">Filter</button></div>
</form>

<table class="table table-striped">
    <thead>
    <tr>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Barcode", "barcode", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Stock", "stock", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Lot", "lot", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Width", "width", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Remaining LF", "remaining", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Location", "location", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Status", "status", Model.Sort, route))</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr>
            <td>@item.RollBarcode</td><td>@item.StockDescription</td><td>@item.SupplierLotNumber</td>
            <td>@item.WidthIn.ToString("N2")"</td><td>@item.RemainingLengthLf.ToString("N2")</td>
            <td>@(item.Location ?? "—")</td><td>@item.Status</td>
            <td class="text-end"><a asp-page="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount)
{
    Extra = route
})

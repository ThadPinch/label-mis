@using LabelsMis.Web.Services.Outsourcing
@model LabelsMis.Web.Services.Outsourcing.OutsourceActionPanel
@{
    // Rendered into the shared job-action modal (fetched on demand). Forms post back to the
    // Outsourced page; returnUrl is filled in by the modal script with the caller's current URL.
    var item = Model.Item;
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var remaining = item.QuantityRemaining;
}
<div class="modal-header">
    <div>
        <h5 class="modal-title">@item.Description</h5>
        <div class="small text-muted">
            @item.OrderNumber · @item.CustomerName · Qty @item.Quantity.ToString("N0")
            @if (item.JobNumber is not null) { <text>· @item.JobNumber</text> }
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <dl class="row small mb-2">
        <dt class="col-4 col-md-3">Vendor</dt><dd class="col-8 col-md-9">@(item.VendorName ?? "—")</dd>
        <dt class="col-4 col-md-3">Quote #</dt><dd class="col-8 col-md-9">@(item.QuoteNumber ?? "—")</dd>
        <dt class="col-4 col-md-3">Vendor cost</dt><dd class="col-8 col-md-9">@(item.VendorCost?.ToString("C2") ?? "—") <span class="text-muted">· our price @item.Price.ToString("C2")@(item.MarginPct is { } m ? $" · margin {m:P1}" : "")</span></dd>
        <dt class="col-4 col-md-3">Expected in</dt><dd class="col-8 col-md-9">@(item.ExpectedIn?.ToString("yyyy-MM-dd") ?? "—")</dd>
        <dt class="col-4 col-md-3">Sent to vendor</dt><dd class="col-8 col-md-9">@(item.SentToVendorAt?.ToString("yyyy-MM-dd") ?? "not yet")</dd>
        @if (item.PrivateNotes is not null)
        {
            <dt class="col-4 col-md-3">Private notes</dt><dd class="col-8 col-md-9">@item.PrivateNotes</dd>
        }
    </dl>

    @if (Model.Receipts.Count > 0)
    {
        <div class="fw-semibold small mb-1">Received so far — @item.QuantityReceived.ToString("N0") of @item.Quantity.ToString("N0")</div>
        <ul class="list-group list-group-flush small mb-2">
            @foreach (var r in Model.Receipts)
            {
                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                    <span>@r.ReceivedOn.ToString("yyyy-MM-dd")@(r.Notes is not null ? $" — {r.Notes}" : "")</span>
                    <span>@r.Quantity.ToString("N0")</span>
                </li>
            }
        </ul>
    }

    @if (item.Status == OutsourceItemStatus.Received)
    {
        <div class="alert alert-success py-2 mb-0">Received in full on @item.ReceivedAt?.ToLocalTime().ToString("yyyy-MM-dd").@(item.IsLine ? " The job is ready to ship." : "")</div>
    }
    else
    {
        @if (!item.SentToVendorAt.HasValue)
        {
            <form method="post" asp-page-handler="MarkSent" class="row g-2 align-items-end mb-3">
                <input type="hidden" name="itemId" value="@item.Id" />
                <input type="hidden" name="returnUrl" value="" />
                <div class="col-6 col-md-4">
                    <label class="form-label small mb-0">Sent to vendor on</label>
                    <input name="sentOn" type="date" class="form-control form-control-sm" value="@today" />
                </div>
                <div class="col-6 col-md-4">
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">Mark sent to vendor</button>
                </div>
                <div class="col-12"><div class="form-text mt-0">Optional — you can receive straight in without marking it sent.</div></div>
            </form>
            <hr class="my-2" />
        }

        <form method="post" asp-page-handler="Receive" id="outsource-receive-form">
            <input type="hidden" name="itemId" value="@item.Id" />
            <input type="hidden" name="returnUrl" value="" />
            <div class="fw-semibold small mb-1">Receive</div>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-0">Quantity</label>
                    <input name="quantity" type="number" min="1" class="form-control form-control-sm" value="@(remaining > 0 ? remaining : item.Quantity)" required />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-0">Received on</label>
                    <input name="receivedOn" type="date" class="form-control form-control-sm" value="@today" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-0">Notes</label>
                    <input name="notes" class="form-control form-control-sm" placeholder="Packing slip #, condition, shortages…" maxlength="1000" />
                </div>
                <div class="col-12">
                    <label class="form-check small">
                        <input type="checkbox" name="markComplete" value="true" class="form-check-input" />
                        <input type="hidden" name="markComplete" value="false" />
                        <span class="form-check-label">This is the last delivery — mark the item complete even if short</span>
                    </label>
                </div>
            </div>
            <div class="form-text">
                The item completes automatically once @item.Quantity.ToString("N0") have been received@(item.IsLine ? "; the job then moves to Shipping" : "").
            </div>
        </form>
    }
</div>
<div class="modal-footer py-2">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
    @if (item.Status != OutsourceItemStatus.Received)
    {
        @if (item.QuantityReceived > 0)
        {
            <form method="post" asp-page-handler="MarkComplete" class="d-inline">
                <input type="hidden" name="itemId" value="@item.Id" />
                <input type="hidden" name="returnUrl" value="" />
                <button type="submit" class="btn btn-outline-secondary btn-sm">Close out — nothing more coming</button>
            </form>
        }
        <button type="submit" form="outsource-receive-form" class="btn btn-primary btn-sm">Record receipt</button>
    }
</div>

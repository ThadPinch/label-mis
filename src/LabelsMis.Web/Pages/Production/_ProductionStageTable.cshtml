@using LabelsMis.Web.Pages.Shared
@model LabelsMis.Web.Pages.Production.ProductionStageModel
@{
    var sortRoute = new Dictionary<string, string?> { ["Search"] = Model.Search };
}

<partial name="_ProductionStageNav" model="Model" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.StageTitle</h1>
    <span class="text-muted">@Model.Result.TotalCount job(s)</span>
</div>

@if (TempData["JobActionError"] is string actionError)
{
    <div class="alert alert-danger">@actionError</div>
}

<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-4">
        <input asp-for="Search" class="form-control" placeholder="Search job, product, or customer" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Result.Items.Count == 0)
{
    <p class="text-muted">No jobs in this stage.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Job", "number", Model.Sort, sortRoute))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Order", "order", Model.Sort, sortRoute))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Customer", "customer", Model.Sort, sortRoute))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Product", "product", Model.Sort, sortRoute))</th>
                <th class="text-end">@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Qty", "qty", Model.Sort, sortRoute))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Due", "due", Model.Sort, sortRoute))</th>
                @if (Model.ShowImpositionColumn)
                {
                    <th>Imposition</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Result.Items)
        {
            <tr>
                <td class="text-nowrap"><a asp-page="/Jobs/Detail" asp-route-id="@item.Id">@item.JobNumber</a></td>
                <td class="text-nowrap"><a asp-page="/SalesOrders/Edit" asp-route-id="@item.SalesOrderId">@item.OrderNumber</a></td>
                <td>@item.CustomerName</td>
                <td>@item.ProductDescription</td>
                <td class="text-end">@item.QuantityOrdered.ToString("N0")</td>
                <td class="text-nowrap">@(item.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                @if (Model.ShowImpositionColumn)
                {
                    <td class="text-nowrap">
                        @if (item.IsImposed && item.ImposedIsStale)
                        {
                            <a asp-page="/Jobs/Detail" asp-route-id="@item.Id" asp-fragment="imposition" class="badge text-bg-warning text-decoration-none" title="The artwork changed after the imposition was run">Re-run</a>
                        }
                        else if (item.IsImposed)
                        {
                            <a asp-page="/Jobs/Detail" asp-route-id="@item.Id" asp-fragment="imposition" class="badge text-bg-success text-decoration-none">Imposed</a>
                        }
                        else
                        {
                            <a asp-page="/Jobs/Detail" asp-route-id="@item.Id" asp-fragment="imposition" class="badge text-bg-secondary text-decoration-none">Impose…</a>
                        }
                    </td>
                }
                <td class="text-end">
                    @if (Model.CanAdvance && Model.NextStatus is not null)
                    {
                        @if (Model.UseActionModal)
                        {
                            <button type="button" class="btn btn-sm btn-primary"
                                    data-action-panel="?handler=ActionPanel&jobId=@item.Id">
                                @Model.AdvanceLabel…
                            </button>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Advance" class="d-inline">
                                <input type="hidden" name="jobId" value="@item.Id" />
                                <input type="hidden" name="Search" value="@Model.Search" />
                                <input type="hidden" name="Sort" value="@Model.Sort" />
                                <input type="hidden" name="pageNumber" value="@Model.Result.Page" />
                                <button type="submit" class="btn btn-sm btn-primary">@Model.AdvanceLabel</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    @await Html.PartialAsync("Shared/_Pager", new PagerModel(
        Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, Model.Search, Model.Sort))
}

<partial name="_JobActionModalHost" />

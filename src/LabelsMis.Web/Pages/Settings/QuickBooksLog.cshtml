@page "/settings/quickbooks/log"
@using LabelsMis.Domain.QuickBooks
@model LabelsMis.Web.Pages.Settings.QuickBooksLogModel
@{
    ViewData["Title"] = "QuickBooks activity log";
    ViewData["BackNav"] = new BackNavModel();
    var log = Model.Log;
}
<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h1 class="h3 mb-0">QuickBooks activity log</h1>
    <a asp-page="/Settings/QuickBooks" class="btn btn-sm btn-outline-secondary ms-auto">Back to QuickBooks setup</a>
</div>
<p class="text-muted">
    Every time LabelShop talked to QuickBooks, newest first. If Intuit support asks for a trace id, it is the
    last column.
</p>

<ul class="nav nav-tabs mb-3" id="qb-log-tabs">
    <li class="nav-item">
        <a class="nav-link @(log.FailuresOnly ? "" : "active")" asp-page="/Settings/QuickBooksLog">Everything</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(log.FailuresOnly ? "active" : "")" asp-page="/Settings/QuickBooksLog" asp-route-failures="true">Problems only</a>
    </li>
</ul>

@if (log.Total == 0)
{
    <p class="text-muted" id="qb-log-empty">
        @(log.FailuresOnly ? "No problems recorded." : "Nothing yet. Entries appear once QuickBooks is connected.")
    </p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle" id="qb-log-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>What</th>
                    <th>Result</th>
                    <th>Details</th>
                    <th>Invoice</th>
                    <th>By</th>
                    <th class="text-end">Took</th>
                    <th>Intuit trace id</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in log.Rows)
                {
                    <tr class="@(row.Succeeded ? "" : "table-danger")">
                        <td class="text-nowrap">@Model.Local(row.OccurredAt)</td>
                        <td>@QuickBooksOperations.Describe(row.Operation)</td>
                        <td>
                            @if (row.Succeeded)
                            {
                                <span class="badge text-bg-success">OK</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Failed</span>
                            }
                        </td>
                        <td class="small">
                            @{
                                var bits = new List<string>();
                                if (row.ErrorCode is not null)
                                {
                                    bits.Add($"code {row.ErrorCode}");
                                }

                                if (row.HttpStatus is not null && !row.Succeeded)
                                {
                                    bits.Add($"HTTP {row.HttpStatus}");
                                }
                            }
                            @row.Message
                            @if (bits.Count > 0)
                            {
                                <span class="text-muted">(@string.Join(", ", bits))</span>
                            }
                            @if (row.QuickBooksId is not null)
                            {
                                <span class="text-muted">QuickBooks id @row.QuickBooksId</span>
                            }
                        </td>
                        <td>
                            @if (row.InvoiceId is not null)
                            {
                                <a asp-page="/Invoices/Detail" asp-route-id="@row.InvoiceId">@(row.InvoiceNumber ?? "invoice")</a>
                            }
                        </td>
                        <td class="small">@(row.Automatic ? "automatic" : row.Who)</td>
                        <td class="text-end small text-nowrap">@(row.DurationMs is null ? "" : $"{row.DurationMs} ms")</td>
                        <td class="small font-monospace">@row.IntuitTid</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (log.PageCount > 1)
    {
        <nav aria-label="Log pages" id="qb-log-pager">
            <ul class="pagination pagination-sm">
                <li class="page-item @(log.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Settings/QuickBooksLog" asp-route-page="@(log.Page - 1)" asp-route-failures="@(log.FailuresOnly ? "true" : null)">Newer</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @log.Page of @log.PageCount (@log.Total entries)</span></li>
                <li class="page-item @(log.Page >= log.PageCount ? "disabled" : "")">
                    <a class="page-link" asp-page="/Settings/QuickBooksLog" asp-route-page="@(log.Page + 1)" asp-route-failures="@(log.FailuresOnly ? "true" : null)">Older</a>
                </li>
            </ul>
        </nav>
    }
}

@page "/settings/quickbooks/log"
@using LabelsMis.Domain.QuickBooks
@model LabelsMis.Web.Pages.Settings.QuickBooksLogModel
@{
    ViewData["Title"] = "QuickBooks activity log";
    ViewData["BackNav"] = new BackNavModel();
    var log = Model.Log;
}
<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h1 class="h3 mb-0">QuickBooks activity log</h1>
    <a asp-page="/Settings/QuickBooks" class="btn btn-sm btn-outline-secondary ms-auto">Back to QuickBooks setup</a>
</div>
<p class="text-muted">
    Every time LabelShop talked to QuickBooks, newest first. If Intuit support asks for a trace id, it is the
    last column.
</p>

<ul class="nav nav-tabs mb-3" id="qb-log-tabs">
    <li class="nav-item">
        <a class="nav-link @(log.FailuresOnly ? "" : "active")" asp-page="/Settings/QuickBooksLog">Everything</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(log.FailuresOnly ? "active" : "")" asp-page="/Settings/QuickBooksLog" asp-route-failures="true">Problems only</a>
    </li>
</ul>

@if (log.Total == 0)
{
    <p class="text-muted" id="qb-log-empty">
        @(log.FailuresOnly ? "No problems recorded." : "Nothing yet. Entries appear once QuickBooks is connected.")
    </p>
}
else
{
    @await Html.PartialAsync("Shared/_QuickBooksLogTable", new QuickBooksLogTableModel(log.Rows, Model.Local, ShowInvoice: true, TableId: "qb-log-table"))

    @if (log.PageCount > 1)
    {
        <nav aria-label="Log pages" id="qb-log-pager">
            <ul class="pagination pagination-sm">
                <li class="page-item @(log.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Settings/QuickBooksLog" asp-route-page="@(log.Page - 1)" asp-route-failures="@(log.FailuresOnly ? "true" : null)">Newer</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @log.Page of @log.PageCount (@log.Total entries)</span></li>
                <li class="page-item @(log.Page >= log.PageCount ? "disabled" : "")">
                    <a class="page-link" asp-page="/Settings/QuickBooksLog" asp-route-page="@(log.Page + 1)" asp-route-failures="@(log.FailuresOnly ? "true" : null)">Older</a>
                </li>
            </ul>
        </nav>
    }
}

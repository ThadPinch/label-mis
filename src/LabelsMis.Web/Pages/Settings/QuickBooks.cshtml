@page "/settings/quickbooks"
@model LabelsMis.Web.Pages.Settings.QuickBooksModel
@{
    ViewData["Title"] = "QuickBooks";
    ViewData["BackNav"] = new BackNavModel();
}
<h1 class="h3 mb-3">QuickBooks</h1>

<partial name="_QuickBooksConnection" model="Model" />

<partial name="_QuickBooksLists" model="Model" />

<h2 class="h5 mb-1" id="qb-mapping">Mapping</h2>
<p class="text-muted">
    How an invoice line becomes a QuickBooks line on <em>Preview for QuickBooks</em>. Pick the names from the company's
    lists (refresh them above); before the lists are read, type the names exactly as they appear in QuickBooks. Any
    line's item or class can still be changed on the preview.
</p>

@if (TempData["QuickBooksStatus"] is string statusMessage)
{
    <div class="alert alert-success py-2" id="qb-mapping-saved">@statusMessage</div>
}

@if (Model.MissingMappingNames > 0)
{
    <div class="alert alert-warning py-2" id="qb-mapping-missing">
        @(Model.MissingMappingNames == 1 ? "One name below is" : $"{Model.MissingMappingNames} names below are") not in
        QuickBooks. Invoices that use @(Model.MissingMappingNames == 1 ? "it" : "them") can't be sent until it's picked
        from the list or added in QuickBooks.
    </div>
}

<form method="post" id="qb-mapping-form">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-4">
        <div class="col-lg-6">
            <fieldset class="border rounded p-3 h-100">
                <legend class="float-none w-auto px-2 h6 mb-0">QuickBooks item per line type</legend>
                <div class="row g-2">
                    <div class="col-md-6">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("SalesItem", "Sales (product lines)")' />
                    </div>
                    <div class="col-md-6">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("ShippingItem", "Shipping")' />
                    </div>
                    <div class="col-md-4">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("DesignItem", "Design")' />
                    </div>
                    <div class="col-md-4">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("RushItem", "Rush")' />
                    </div>
                    <div class="col-md-4">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("DieCreationItem", "Die creation")' />
                    </div>
                </div>
                <h2 class="h6 mt-3 mb-1">Charge lines</h2>
                <p class="small text-muted mb-2">
                    Charges (die, design time, rush…) have no type in LabelShop, so the description decides: a charge gets
                    the Die creation, Rush or Design item when a keyword starts any word of its description (checked in that
                    order), otherwise the Sales item. Comma-separated.
                </p>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label asp-for="Input.DieCreationKeywords" class="form-label small mb-0"></label>
                        <input asp-for="Input.DieCreationKeywords" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.RushKeywords" class="form-label small mb-0"></label>
                        <input asp-for="Input.RushKeywords" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.DesignKeywords" class="form-label small mb-0"></label>
                        <input asp-for="Input.DesignKeywords" class="form-control form-control-sm" />
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="col-lg-6">
            <fieldset class="border rounded p-3 mb-3">
                <legend class="float-none w-auto px-2 h6 mb-0">Classes</legend>
                <div class="row g-2">
                    <div class="col-md-4">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("RollLabelClass", "Roll label")' />
                    </div>
                    <div class="col-md-4">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("ShrinkSleevesClass", "Shrink sleeves")' />
                    </div>
                    <div class="col-md-4">
                        <partial name="_QuickBooksNamePicker" model='Model.MappingPicker("BuyoutClass", "Buyout")' />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.OutsourcedSubstrateCode" class="form-label small mb-0"></label>
                        <input asp-for="Input.OutsourcedSubstrateCode" class="form-control form-control-sm" />
                    </div>
                </div>
                <ul class="small text-muted mt-2 mb-0">
                    <li>Product line on the buyout substrate code (or an outsourced line) → Buyout.</li>
                    <li>Product line on a <em>shrink</em> stock → Shrink sleeves.</li>
                    <li>Any other product line → Roll label.</li>
                    <li>Charge and shipping lines inherit the job's class (the order's first product line).</li>
                </ul>
            </fieldset>
            <fieldset class="border rounded p-3" id="qb-shipping-settings">
                <legend class="float-none w-auto px-2 h6 mb-0">Shipping line</legend>
                <div class="small">
                    Billed shipping per shipment: pickup and customer account $0 · local delivery
                    <strong>@Model.LocalDeliveryFee.ToString("C2")</strong> flat · carrier cost ×
                    <strong>@Model.CarrierCostMultiplier.ToString("0.####")</strong>.
                </div>
                <div class="small text-muted">
                    @if (Model.CanEditGeneral)
                    {
                        <span>Change the fee and multiplier on <a asp-page="/Settings/General">General settings</a>.</span>
                    }
                    else
                    {
                        <span>An admin changes the fee and multiplier on General settings.</span>
                    }
                </div>
            </fieldset>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save mapping</button>
    </div>
</form>

<partial name="_QuickBooksSending" model="Model" />

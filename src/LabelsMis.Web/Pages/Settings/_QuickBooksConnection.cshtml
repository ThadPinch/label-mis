@using LabelsMis.Domain.Enums
@model LabelsMis.Web.Pages.Settings.QuickBooksModel
@{
    var c = Model.Connection;
    var (stateText, stateClass) = c.State switch
    {
        QuickBooksConnectionState.Connected => ("Connected", "text-bg-success"),
        QuickBooksConnectionState.NeedsReconnect => ("Reconnect needed", "text-bg-danger"),
        QuickBooksConnectionState.NotConnected => ("Not connected", "text-bg-secondary"),
        _ => ("Not set up", "text-bg-secondary")
    };
    var company = string.IsNullOrWhiteSpace(c.CompanyName) ? "a QuickBooks company" : c.CompanyName;
    var check = c.CompanyCheck;
    var redirectUri = Model.RedirectUri;
}
<section class="border rounded p-3 mb-4" id="qb-connection">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h5 mb-0">Connection</h2>
        <span class="badge @stateClass" id="qb-connection-state">@stateText</span>
        @if (c.HasCredentials && c.Environment == QuickBooksEnvironment.Sandbox)
        {
            <span class="badge text-bg-warning" id="qb-connection-sandbox">Sandbox: test company, not the real books</span>
        }
        <a asp-page="/Settings/QuickBooksLog" class="small ms-auto" id="qb-log-link">Activity log</a>
    </div>

    @if (TempData["QuickBooksConnectionStatus"] is string connectionStatus)
    {
        <div class="alert alert-success py-2" id="qb-connection-saved">@connectionStatus</div>
    }
    @if (TempData["QuickBooksConnectionError"] is string connectionError)
    {
        <div class="alert alert-danger py-2" id="qb-connection-error">@connectionError</div>
    }

    @if (!c.CanStoreSecrets)
    {
        <div class="alert alert-warning py-2" id="qb-key-missing">
            QuickBooks can't be connected on this server yet: @c.KeyProblem
            LabelShop stores the QuickBooks sign-in encrypted, and the encryption key is the
            <code>Secrets__Key</code> setting on the server (32 random bytes, base64).
        </div>
    }

    @switch (c.State)
    {
        case QuickBooksConnectionState.Connected:
            <p class="mb-2" id="qb-connection-summary">
                Connected to <strong>@company</strong>
                @if (c.RealmId is not null)
                {
                    <span class="text-muted">(company ID @c.RealmId)</span>
                }
                since @Model.Local(c.ConnectedAt)@(c.ConnectedBy is null ? "" : $", by {c.ConnectedBy}").
            </p>
            @if (c.ReconnectBy is not null)
            {
                <p class="small text-muted mb-2" id="qb-connection-keepalive">
                    QuickBooks keeps this sign-in alive while LabelShop uses it; LabelShop refreshes it daily.
                    Without a refresh it would lapse on @Model.Local(c.ReconnectBy, "MMM d, yyyy").
                    Last refreshed @Model.Local(c.LastRefreshedAt).
                </p>
            }
            @if (c.RefusedSince is not null)
            {
                <p class="small text-danger mb-2" id="qb-connection-refused">
                    QuickBooks refused the saved sign-in on @Model.Local(c.RefusedSince). That also happens during Intuit
                    outages, so LabelShop tries once more a few minutes later before asking for a reconnect.
                </p>
            }
            break;
        case QuickBooksConnectionState.NeedsReconnect:
            <p class="mb-2" id="qb-connection-summary">
                QuickBooks stopped accepting the saved sign-in for <strong>@company</strong>
                on @Model.Local(c.LastErrorAt). Connect again to carry on. If Intuit was having an outage,
                <em>Try the saved sign-in again</em> may be all it takes.
            </p>
            break;
        case QuickBooksConnectionState.NotConnected:
            <p class="mb-2" id="qb-connection-summary">
                The Intuit app keys are saved. No QuickBooks company is connected yet.
                <em>Connect to QuickBooks</em> opens Intuit's sign-in; a QuickBooks admin picks the company and approves.
            </p>
            break;
        default:
            <p class="mb-2" id="qb-connection-summary">
                LabelShop needs the keys of its Intuit developer app before it can connect to QuickBooks.
                @(Model.CanEditKeys ? "Enter them below." : "An admin enters them on this page.")
            </p>
            break;
    }

    @if (!string.IsNullOrWhiteSpace(c.LastError))
    {
        <p class="small text-danger mb-2" id="qb-connection-last-error">
            Last problem (@Model.Local(c.LastErrorAt)): @c.LastError
        </p>
    }

    @if (c.HasCredentials)
    {
        <div class="d-flex flex-wrap gap-2 mb-3" id="qb-connection-actions">
            @if (c.State != QuickBooksConnectionState.Connected)
            {
                <form method="post" asp-page-handler="Connect">
                    <button type="submit" class="btn btn-sm btn-primary" id="qb-connect" disabled="@(!c.CanStoreSecrets)">
                        @(c.State == QuickBooksConnectionState.NeedsReconnect ? "Connect again" : "Connect to QuickBooks")
                    </button>
                </form>
            }
            @if (c.IsLinked)
            {
                <form method="post" asp-page-handler="Test">
                    <button type="submit" class="btn btn-sm btn-outline-primary" id="qb-test">
                        @(c.State == QuickBooksConnectionState.NeedsReconnect ? "Try the saved sign-in again" : "Test connection")
                    </button>
                </form>
                <form method="post" asp-page-handler="Disconnect"
                      onsubmit="return confirm('Disconnect LabelShop from QuickBooks? Invoices already in QuickBooks stay there. The Intuit app keys stay saved.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger" id="qb-disconnect">Disconnect</button>
                </form>
            }
        </div>
    }

    @if (c.IsLinked)
    {
        <div class="border-top pt-3 mb-3" id="qb-company-check">
            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                <h3 class="h6 mb-0">Company check</h3>
                <span class="small text-muted" id="qb-company-checked-at">
                    @(check is null ? "Not read yet. Test connection reads it." : $"Read from QuickBooks {Model.Local(c.CompanyCheckedAt)}. Test connection reads it again.")
                </span>
            </div>
            @if (check is not null)
            {
                <table class="table table-sm align-middle mb-1" id="qb-company-check-table">
                    <tbody>
                        <tr data-check="custom-numbers">
                            <td class="text-nowrap" style="width: 1%">
                                <span class="badge @(check.CustomTransactionNumbers ? "text-bg-success" : "text-bg-danger")">@(check.CustomTransactionNumbers ? "On" : "Off")</span>
                            </td>
                            <td>Custom transaction numbers</td>
                            <td class="small text-muted">
                                @(check.CustomTransactionNumbers
                                    ? "QuickBooks keeps LabelShop's invoice number."
                                    : "QuickBooks would number invoices itself. Turn on under Account and settings, Sales, Sales form content.")
                            </td>
                        </tr>
                        <tr data-check="class-per-line">
                            <td>
                                <span class="badge @(check.ClassTrackingPerLine ? "text-bg-success" : "text-bg-danger")">@(check.ClassTrackingPerLine ? "On" : "Off")</span>
                            </td>
                            <td>Class tracking, one class per row</td>
                            <td class="small text-muted">
                                @if (check.ClassTrackingPerLine)
                                {
                                    <text>Each invoice line carries its own class.</text>
                                }
                                else if (check.ClassTrackingPerTransaction)
                                {
                                    <text>Classes are on, but one per whole transaction. Change it to one per row under Account and settings, Advanced, Categories.</text>
                                }
                                else
                                {
                                    <text>Turn on class tracking, one per row, under Account and settings, Advanced, Categories.</text>
                                }
                            </td>
                        </tr>
                        <tr data-check="sales-tax">
                            <td>
                                <span class="badge @(check.SalesTaxOn ? "text-bg-success" : "text-bg-warning")">@(check.SalesTaxOn ? "On" : "Off")</span>
                            </td>
                            <td>Sales tax</td>
                            <td class="small text-muted">
                                @if (!check.SalesTaxOn)
                                {
                                    <text>QuickBooks will not add tax to invoices until sales tax is set up in it.</text>
                                }
                                else if (check.AutomatedSalesTax)
                                {
                                    <text>QuickBooks works the tax out itself from the ship-to address.</text>
                                }
                                else
                                {
                                    <text>On, without QuickBooks' automated calculation.</text>
                                }
                            </td>
                        </tr>
                        <tr data-check="po-field">
                            <td>
                                <span class="badge @(check.PoNumberField is not null ? "text-bg-success" : "text-bg-warning")">@(check.PoNumberField is not null ? "Found" : check.CustomFields.Count > 0 ? "Not found" : "Not listed")</span>
                            </td>
                            <td>Custom field for the PO number</td>
                            <td class="small text-muted">
                                @if (check.PoNumberField is { } po)
                                {
                                    <text>"@po.Name" (custom field @po.DefinitionId).</text>
                                }
                                else if (check.CustomFields.Count > 0)
                                {
                                    <text>None of the custom fields QuickBooks lists for invoices is named like a PO number (listed: @string.Join(", ", check.CustomFields.Select(f => f.Enabled ? f.Name : $"{f.Name}, switched off"))).</text>
                                }
                                else
                                {
                                    <text>QuickBooks lists no invoice custom field for this company. A field made in its current Custom fields screen does not appear in this list, so this row can't confirm where the PO number goes.</text>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="small mb-0 @(check.ReadyForInvoices ? "text-success" : "text-danger")" id="qb-company-check-verdict">
                    @(check.ReadyForInvoices
                        ? "Invoice numbers and classes are set up the way LabelShop's invoices need."
                        : "Invoices can't be sent until custom transaction numbers and class tracking (one per row) are on in QuickBooks. Then press Test connection.")
                </p>
            }
        </div>
    }

    @if (Model.CanEditKeys)
    {
        <details id="qb-keys" open="@(c.HasCredentials ? null : "open")">
            <summary class="small">Intuit app keys</summary>
            <form method="post" asp-page-handler="SaveKeys" id="qb-keys-form" class="mt-2" autocomplete="off">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label for="Keys_Environment" class="form-label small mb-0">Keys are for</label>
                        <select id="Keys_Environment" name="Keys.Environment" class="form-select form-select-sm">
                            <option value="Sandbox" selected="@(c.Environment == QuickBooksEnvironment.Sandbox)">Sandbox (Development keys)</option>
                            <option value="Production" selected="@(c.Environment == QuickBooksEnvironment.Production)">Production</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="Keys_ClientId" class="form-label small mb-0">Client ID</label>
                        <input id="Keys_ClientId" name="Keys.ClientId" class="form-control form-control-sm" maxlength="200" value="@c.ClientId" />
                    </div>
                    <div class="col-md-4">
                        <label for="Keys_ClientSecret" class="form-label small mb-0">Client secret</label>
                        <input id="Keys_ClientSecret" name="Keys.ClientSecret" type="password" class="form-control form-control-sm" maxlength="200"
                               autocomplete="new-password"
                               placeholder="@(c.HasCredentials ? $"(unchanged{(c.ClientSecretTail.Length > 0 ? ", ends " + c.ClientSecretTail : "")})" : "")" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100" disabled="@(!c.CanStoreSecrets)">Save</button>
                    </div>
                </div>
                <div class="form-text">
                    From developer.intuit.com: the app's <em>Keys and credentials</em> page. Development keys open sandbox
                    companies only; Production keys open the real company. Leave the secret blank to keep the saved one.
                    @if (redirectUri.Length > 0)
                    {
                        <span id="qb-redirect-uri">The same Intuit app must list this redirect URI, exactly: <code>@redirectUri</code></span>
                        <span id="qb-public-address-source">
                            @(Model.PublicAddressConfigured
                                ? "It is built from the App__PublicBaseUrl setting on this server."
                                : "App__PublicBaseUrl is not set on this server, so it is built from the address of this page.")
                        </span>
                    }
                </div>
            </form>
        </details>
    }
</section>

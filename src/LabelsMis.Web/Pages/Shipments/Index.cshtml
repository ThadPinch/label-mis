@page "/shipments"
@model LabelsMis.Web.Pages.Shipments.IndexModel
@{ ViewData["Title"] = "Shipments"; }

<h1 class="h3 mb-3">Shipments</h1>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ReadyActive ? "active" : "")" data-bs-toggle="tab" data-bs-target="#ready-pane" type="button" role="tab">
            Ready to Ship
            @if (Model.ReadyResult.TotalCount > 0)
            {
                <span class="badge text-bg-secondary ms-1">@Model.ReadyResult.TotalCount</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ReadyActive ? "" : "active")" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab">
            History
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade @(Model.ReadyActive ? "show active" : "")" id="ready-pane" role="tabpanel">
        <p class="text-muted">Orders with items finished and ready to ship. Record a shipment to capture packages and tracking.</p>

        @if (TempData["ShipMessage"] is string shipMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @shipMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ShipError"] is string shipError)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @shipError
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="tab" value="ready" />
            <div class="col-md-4"><input asp-for="ReadySearch" class="form-control" placeholder="Search order or customer" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary w-100">Filter</button></div>
        </form>

        @if (Model.ReadyResult.Items.Count == 0)
        {
            <div class="alert alert-light border">Nothing is ready to ship right now.</div>
        }
        else
        {
            <table class="table table-striped align-middle">
                <thead>
                    <tr><th class="text-nowrap">Order #</th><th>Customer</th><th class="text-nowrap">Customer PO</th><th class="text-nowrap">Requested ship</th><th class="text-nowrap">Ship method</th><th>Ready</th><th>Jobs</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var order in Model.ReadyResult.Items)
                {
                    <tr>
                        <td class="text-nowrap">
                            <a asp-page="/SalesOrders/Edit" asp-route-id="@order.SalesOrderId">@order.OrderNumber</a>
                        </td>
                        <td>@order.CustomerName</td>
                        <td>@(order.CustomerPoNumber ?? "—")</td>
                        <td>@(order.RequestedShipDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@(order.ShippingMethodName ?? "—")</td>
                        <td>
                            <span class="badge @(order.ReadyItemCount == order.TotalItemCount ? "bg-success" : "bg-warning text-dark")">
                                @order.ReadyItemCount of @order.TotalItemCount items
                            </span>
                        </td>
                        <td>
                            @foreach (var job in order.ReadyJobs)
                            {
                                <a asp-page="/Jobs/Detail" asp-route-id="@job.JobId" class="d-inline-block me-2 text-nowrap">@job.JobNumber</a>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end align-items-center gap-2 flex-nowrap">
                                @if (Model.CanShip)
                                {
                                    <a asp-page="/Shipments/Record" asp-route-salesOrderId="@order.SalesOrderId" class="btn btn-sm btn-success text-nowrap">Record shipment</a>
                                    var markLabel = order.IsPickup ? "Mark picked up" : "Mark shipped";
                                    var markConfirm = order.IsPickup
                                        ? "Are you sure you want to mark this order picked up without a package?"
                                        : "Are you sure you want to mark this order shipped without a package?";
                                    <form method="post" asp-page-handler="MarkShipped" class="m-0"
                                          onsubmit="return confirm('@markConfirm');">
                                        <input type="hidden" name="salesOrderId" value="@order.SalesOrderId" />
                                        <input type="hidden" name="isPickup" value="@order.IsPickup" />
                                        <input type="hidden" name="ReadySearch" value="@Model.ReadySearch" />
                                        <input type="hidden" name="readyPage" value="@Model.ReadyPage" />
                                        @if (order.ReadyItemCount < order.TotalItemCount)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap" disabled
                                                    title="All items must be ready before the order can be marked @(order.IsPickup ? "picked up" : "shipped")">@markLabel</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">@markLabel</button>
                                        }
                                    </form>
                                }
                                <a asp-page="PackingList" asp-route-salesOrderId="@order.SalesOrderId" class="btn btn-sm btn-outline-secondary text-nowrap">Packing list</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            @await Html.PartialAsync("Shared/_Pager", new PagerModel(
                Model.ReadyResult.Page, Model.ReadyResult.TotalPages, Model.ReadyResult.TotalCount)
            {
                PageParam = "readyPage",
                Extra = new Dictionary<string, string?> { ["tab"] = "ready", ["ReadySearch"] = Model.ReadySearch }
            })
        }
    </div>

    <div class="tab-pane fade @(Model.ReadyActive ? "" : "show active")" id="history-pane" role="tabpanel">
        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="tab" value="history" />
            <div class="col-md-3"><input asp-for="Search" class="form-control" placeholder="Search shipment or tracking" /></div>
            <div class="col-md-2">
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.ShipmentStatus>()"><option value="">All statuses</option></select>
            </div>
            <div class="col-md-3">
                <select asp-for="CustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["CustomerOptions"]!)"><option value="">All customers</option></select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary w-100">Filter</button></div>
        </form>

        <table class="table table-striped">
            <thead><tr><th class="text-nowrap">Shipment #</th><th>Customer</th><th class="text-nowrap">Ship date</th><th>Status</th><th>Carrier</th><th>Tracking</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.Result.Items)
            {
                <tr>
                    <td class="text-nowrap"><a asp-page="Detail" asp-route-id="@item.Id">@item.ShipmentNumber</a></td>
                    <td>@item.CustomerName</td><td>@item.ShipDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Status</td><td>@item.Carrier</td><td>@(item.PrimaryTrackingNumber ?? "—")</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end align-items-center gap-2 flex-nowrap">
                            <a asp-page="PackingList" asp-route-salesOrderId="@item.SalesOrderId" class="btn btn-sm btn-outline-secondary text-nowrap">Packing list</a>
                            <a asp-page="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary text-nowrap">Open</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        @await Html.PartialAsync("Shared/_Pager", new PagerModel(
            Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount)
        {
            PageParam = "historyPage",
            Extra = new Dictionary<string, string?>
            {
                ["tab"] = "history",
                ["Search"] = Model.Search,
                ["Status"] = Model.Status?.ToString(),
                ["CustomerId"] = Model.CustomerId?.ToString()
            }
        })
    </div>
</div>

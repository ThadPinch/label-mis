@page "/shipments/{id:guid}"
@using LabelsMis.Domain.Carriers
@using LabelsMis.Domain.Enums
@model LabelsMis.Web.Pages.Shipments.DetailModel
@{ ViewData["Title"] = Model.Detail?.Shipment.ShipmentNumber ?? "Shipment"; 
    ViewData["BackNav"] = new BackNavModel();
}

@if (Model.Detail is null) { <p>Not found.</p>; return; }

@{
    var s = Model.Detail.Shipment;
    var canPrint = s.LabelState == ShipmentLabelState.Purchased && Model.CanShip;
    var hasTracking = s.Packages.Any(p => p.TrackingStatus is not null);
    var trackingEvents = s.Packages
        .SelectMany(p => p.TrackingEvents.Select(e => (Package: p, Event: e)))
        .OrderByDescending(x => x.Event.EventAt)
        .ThenBy(x => x.Package.PackageNumber)
        .ToList();
    string PrintClass(CarrierLabelFormat format) => format == Model.DefaultLabelFormat ? "btn-primary" : "btn-outline-secondary";
}

<div class="d-flex justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">@s.ShipmentNumber</h1>
        <p class="text-muted mb-0">
            @Model.Detail.CustomerName — <span id="shipment-status">@Model.StatusText</span>
            @if (s.LabelState == ShipmentLabelState.Unconfirmed)
            {
                <span class="badge text-bg-warning" id="label-unconfirmed-badge">Label not confirmed</span>
            }
            @if (s.IsSampleLabel)
            {
                <span class="badge text-bg-warning" id="label-sample-badge">Staging sample label</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Detail.LatestTrackingStatus))
        {
            <p class="text-muted">Latest: @Model.Detail.LatestTrackingStatus</p>
        }
    </div>
    @if (Model.CanInvoice)
    {
        <form method="post" asp-page-handler="GenerateInvoice">
            <button type="submit" class="btn btn-primary">Generate invoice</button>
        </form>
    }
</div>

@{
    var shipFrom = s.ShipFromSnapshot;
}
<div class="row">
    <div class="col-md-6">
        <h2 class="h6">Ship from</h2>
        @if (shipFrom.HasAddress)
        {
            <p>
                @if (!string.IsNullOrWhiteSpace(shipFrom.RecipientName)) { <text>@shipFrom.RecipientName<br /></text> }
                @shipFrom.Street1<br />
                @shipFrom.City, @shipFrom.State @shipFrom.Zip
            </p>
        }
        else if (s.ShipFromAddress is { } from)
        {
            <p>@from.Street1<br />@from.City, @from.State @from.Zip</p>
        }
        else
        {
            <p class="text-muted">—</p>
        }
    </div>
    <div class="col-md-6">
        <h2 class="h6">Ship to</h2>
        @{ var shipTo = s.ShipToSnapshot; }
        @if (shipTo.HasAddress)
        {
            <p>
                @if (!string.IsNullOrWhiteSpace(shipTo.RecipientName)) { <text>@shipTo.RecipientName<br /></text> }
                @shipTo.Street1<br />
                @if (!string.IsNullOrWhiteSpace(shipTo.Street2)) { <text>@shipTo.Street2<br /></text> }
                @shipTo.City, @shipTo.State @shipTo.Zip
                @if (!string.IsNullOrWhiteSpace(s.ShipToContact) || !string.IsNullOrWhiteSpace(s.ShipToPhone))
                {
                    <br /><span class="text-muted" id="ship-to-contact">@s.ShipToContact @s.ShipToPhone@(s.ShipToResidential ? " · residential" : "")</span>
                }
            </p>
        }
        else
        {
            <p class="text-muted">—</p>
        }
    </div>
</div>

<p class="text-muted">
    Carrier: @CarrierNames.For(s.Carrier)@(s.CarrierServiceName is { } service ? $" · {service}" : s.ServiceLevel is { } svc ? $" · {svc}" : "")
    · Ship date: @s.ShipDate.ToString("yyyy-MM-dd")
</p>

@if (TempData["ShipmentStatus"] is string shipmentStatus)
{
    <div class="alert alert-success py-2 small" id="shipment-message">@shipmentStatus</div>
}
@if (TempData["ShipmentWarning"] is string shipmentWarning)
{
    <div class="alert alert-warning py-2 small" id="shipment-warning">@shipmentWarning</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

@if (Model.VoidedAtCarrier)
{
    <div class="alert alert-danger py-2 small" id="voided-at-carrier">
        Worldwide Express reports this label as <strong>voided</strong>, but the shipment still counts as shipped here.
        If the label was voided in SpeedShip, use <strong>Void label</strong> at the bottom of this page so the order can
        ship again.
    </div>
}

@if (s.LabelState == ShipmentLabelState.Unconfirmed)
{
    <div class="card border-warning mb-3" id="label-unconfirmed">
        <div class="card-header py-1 small fw-semibold">Worldwide Express never answered</div>
        <div class="card-body py-2 small">
            <p class="mb-2">
                LabelShop asked for <strong>@s.CarrierServiceName</strong> at @((s.CarrierCost ?? 0m).ToString("C2")) on
                @Model.Local(s.CreatedAt) and no usable answer came back, so it doesn't know whether the label was bought.
                Nothing is recorded as shipped, and the order's jobs and invoice are untouched.
            </p>
            <p class="mb-2">
                <strong>Check with carrier</strong> asks again. If the label was not bought, it is bought now. If it was,
                its tracking numbers were lost with the answer: LabelShop voids that order with Worldwide Express (a void
                costs nothing), removes this shipment, and the shipment is recorded again.
            </p>
            @if (Model.CanShip)
            {
                <form method="post" asp-page-handler="CheckCarrier">
                    <button type="submit" class="btn btn-sm btn-warning" id="check-carrier">Check with carrier</button>
                </form>
            }
        </div>
    </div>
}

@if (s.Status == ShipmentStatus.Voided)
{
    <div class="alert alert-secondary py-2 small" id="shipment-voided">
        <strong>Voided</strong> @Model.Local(s.VoidedAt)@(Model.Detail.VoidedBy is { } who ? $" by {who}" : "")@(s.VoidReason is { } why ? $": {why}." : ".")
        It no longer counts toward what the order has shipped@(s.LabelState == ShipmentLabelState.Voided ? ", and its label was voided with Worldwide Express" : "").
        The tracking numbers stay on file in case the label is ever billed.
    </div>
}

@if (s.LabelState is ShipmentLabelState.Purchased or ShipmentLabelState.Voided)
{
    <div class="card mb-3" id="shipment-label">
        <div class="card-header py-1 small fw-semibold">UPS label</div>
        <div class="card-body py-2 small">
            <div>
                <span class="fw-semibold" id="label-service">@s.CarrierServiceName</span>
                · bought @Model.Local(s.LabelPurchasedAt)
                @if (!string.IsNullOrEmpty(s.CarrierOrderNumber))
                {
                    <text>· Worldwide Express order <span id="label-order-number">@s.CarrierOrderNumber</span></text>
                }
                @if (!string.IsNullOrEmpty(s.CarrierBillToAccount))
                {
                    <text>· billed to UPS account @s.CarrierBillToAccount</text>
                }
            </div>
            @if (s.IsSampleLabel)
            {
                <div class="text-warning-emphasis" id="label-sample-note">
                    Bought with staging keys: a sample label. It can't ship and nothing is billed.
                </div>
            }
            @if (canPrint)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2" id="label-print">
                    <a asp-page="Detail" asp-page-handler="Label" asp-route-id="@s.Id" asp-route-format="PdfLetter"
                       target="_blank" rel="noopener" class="btn btn-sm @PrintClass(CarrierLabelFormat.PdfLetter)" id="print-letter">
                        Print on Letter paper (@(s.Packages.Count == 1 ? "1 label" : $"{s.Packages.Count} labels"))
                    </a>
                    <span class="text-muted">4 × 6 labels and ZPL files are per package, below. Printing again never buys again.</span>
                </div>
            }
            @if (s.LabelState == ShipmentLabelState.Purchased)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2" id="label-tracking">
                    <span>
                        Tracking: <span class="fw-semibold" id="tracking-summary">@Model.TrackingSummary</span>
                        @if (s.TrackingCheckedAt is not null)
                        {
                            <span class="text-muted" id="tracking-checked">· asked @Model.Local(s.TrackingCheckedAt)</span>
                        }
                    </span>
                    @if (Model.CanCheckTracking)
                    {
                        <form method="post" asp-page-handler="Track" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" id="check-tracking">Check tracking now</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}

@if (Model.OrderProgress is { CanMarkShipped: true } progress)
{
    <div class="card border-warning mb-3" id="mark-order-shipped-card">
        <div class="card-header py-1 small fw-semibold">@progress.OrderNumber isn't fully shipped</div>
        <div class="card-body py-2 small">
            @foreach (var line in progress.Lines.Where(l => l.Shipped < l.Ordered))
            {
                <div>Line @line.LineNumber (@line.Description): shipped @line.Shipped.ToString("N0") of @line.Ordered.ToString("N0")</div>
            }
            <div class="text-muted mb-1">If it under-ran and nothing more will ship, mark the order shipped so its invoice can bill.</div>
            @if (Model.CanEditCarrierCost)
            {
                <form method="post" asp-page-handler="MarkOrderShipped"
                      onsubmit="return confirm('Mark @progress.OrderNumber shipped? Nothing more will ship on it.');">
                    <button type="submit" class="btn btn-sm btn-outline-success" id="mark-order-shipped">Mark order shipped</button>
                </form>
            }
        </div>
    </div>
}

<div class="card mb-3" id="shipment-billing">
    <div class="card-header py-1 small fw-semibold">Shipping charges</div>
    <div class="card-body py-2 small">
        @if (Model.CanEditCarrierCost)
        {
            <form method="post" asp-page-handler="CarrierCost" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label asp-for="CarrierCost" class="form-label small mb-0">Carrier cost (what the carrier billed us)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input asp-for="CarrierCost" class="form-control" placeholder="Not entered" inputmode="decimal" />
                    </div>
                    <span asp-validation-for="CarrierCost" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Save</button>
                </div>
                @if (s.LabelState == ShipmentLabelState.Purchased)
                {
                    <div class="col-md-6 text-muted" id="carrier-cost-source">
                        Filled in from the rate the label was bought at. Change it if the Worldwide Express bill differs.
                    </div>
                }
            </form>
        }
        else
        {
            <div>Carrier cost: <span id="carrier-cost-value">@(s.CarrierCost?.ToString("C2") ?? "not entered")</span></div>
        }
        <div class="mt-1">
            Billed shipping:
            @if (s.BilledShipping is { } billed)
            {
                <span class="fw-semibold" id="billed-shipping-value">@billed.ToString("C2")</span>
            }
            else
            {
                <span class="text-warning" id="billed-shipping-value">pending — enter the carrier cost</span>
            }
        </div>
        <div class="text-muted">
            Method: @(Model.Billing?.ShippingMethodName ?? "none on the order") · @Model.Billing?.Rule
        </div>
    </div>
</div>

<h2 class="h6">Lines</h2>
<table class="table table-sm table-striped mb-3">
    <thead><tr><th>Product</th><th>Qty shipped</th></tr></thead>
    <tbody>
    @foreach (var line in s.Lines)
    {
        <tr><td>@line.SalesOrderLine.Product.Description</td><td>@line.QuantityShipped.ToString("N0")</td></tr>
    }
    </tbody>
</table>

<h2 class="h6">Packages</h2>
<table class="table table-sm table-striped align-middle" id="shipment-packages">
    <thead>
        <tr>
            <th>#</th><th>Weight</th><th>Size</th><th>Tracking</th>
            @if (hasTracking)
            {
                <th>Status</th>
            }
            <th>Cost</th>
            @if (canPrint)
            {
                <th>Label</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var pkg in s.Packages.OrderBy(p => p.PackageNumber))
    {
        <tr>
            <td>@pkg.PackageNumber</td>
            <td>@pkg.WeightLb.ToString("N1") lb</td>
            <td>@(pkg.LengthIn > 0 && pkg.WidthIn > 0 && pkg.HeightIn > 0 ? $"{pkg.LengthIn:0.##} × {pkg.WidthIn:0.##} × {pkg.HeightIn:0.##} in" : "—")</td>
            <td>
                @if (pkg.TrackingNumber is null)
                {
                    <text>—</text>
                }
                else if (!s.IsSampleLabel && s.Carrier == Carrier.Ups && UpsServices.LooksLikeTrackingNumber(pkg.TrackingNumber))
                {
                    <a href="@UpsServices.TrackingUrl(pkg.TrackingNumber)" target="_blank" rel="noopener">@pkg.TrackingNumber</a>
                }
                else
                {
                    <text>@pkg.TrackingNumber</text>
                }
            </td>
            @if (hasTracking)
            {
                <td data-tracking-status="@pkg.TrackingStatus">@(pkg.TrackingStatus is { } boxStatus ? CarrierTrackingCodes.Describe(boxStatus) : "—")</td>
            }
            <td>@pkg.ShippingCost.ToString("C2")</td>
            @if (canPrint)
            {
                <td class="text-nowrap">
                    <a asp-page="Detail" asp-page-handler="Label" asp-route-id="@s.Id" asp-route-packageId="@pkg.Id" asp-route-format="Pdf4x6"
                       target="_blank" rel="noopener" class="btn btn-sm @PrintClass(CarrierLabelFormat.Pdf4x6)" data-print="4x6">Print 4 × 6</a>
                    <a asp-page="Detail" asp-page-handler="Label" asp-route-id="@s.Id" asp-route-packageId="@pkg.Id" asp-route-format="Zpl"
                       class="btn btn-sm @PrintClass(CarrierLabelFormat.Zpl)" data-print="zpl">ZPL</a>
                </td>
            }
        </tr>
    }
    </tbody>
</table>

@if (trackingEvents.Count > 0)
{
    <h2 class="h6">Tracking history</h2>
    <table class="table table-sm align-middle mb-3" id="tracking-events">
        <thead><tr><th>When</th><th>Package</th><th>What</th></tr></thead>
        <tbody>
        @foreach (var (package, trackingEvent) in trackingEvents)
        {
            <tr>
                <td class="text-nowrap">@Model.Local(trackingEvent.EventAt)</td>
                <td>@package.PackageNumber</td>
                <td>@trackingEvent.StatusDescription@(string.IsNullOrWhiteSpace(trackingEvent.Location) ? "" : $" · {trackingEvent.Location}")</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.CanVoid)
{
    var boughtHere = s.LabelState == ShipmentLabelState.Purchased;
    <div class="card mb-3" id="shipment-void">
        <div class="card-header py-1 small fw-semibold">@(boughtHere ? "Void label" : "Void shipment")</div>
        <div class="card-body py-2 small">
            @if (Model.VoidBlocker is { } blocker)
            {
                <div id="void-blocked">
                    @blocker.Message
                    @if (blocker.InvoiceId is { } invoiceId)
                    {
                        <a asp-page="/Invoices/Detail" asp-route-id="@invoiceId">Open @blocker.InvoiceNumber</a>
                    }
                </div>
            }
            else
            {
                <p class="mb-2" id="void-explained">
                    @if (boughtHere)
                    {
                        <text>Voids the label with Worldwide Express, so it isn't billed, and takes this shipment back: its
                        items are ready to ship again and its shipping comes off the order's draft invoice. Do it before the
                        box leaves the building.</text>
                    }
                    else
                    {
                        <text>Takes this shipment back: its items are ready to ship again and its shipping comes off the
                        order's draft invoice. Nothing is sent to the carrier: a label made outside LabelShop is voided where
                        it was made.</text>
                    }
                </p>
                <form method="post" asp-page-handler="Void" class="row g-2 align-items-end"
                      onsubmit="return confirm('@(boughtHere ? "Void this label with Worldwide Express and take the shipment back?" : "Take this shipment back?")');">
                    <div class="col-md-6">
                        <label class="form-label small mb-0" for="voidReason">Why (optional)</label>
                        <input id="voidReason" name="voidReason" class="form-control form-control-sm" maxlength="300" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100" id="void-shipment">@(boughtHere ? "Void label" : "Void shipment")</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

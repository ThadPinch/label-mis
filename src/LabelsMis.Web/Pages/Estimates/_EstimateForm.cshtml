@model LabelsMis.Web.Pages.Estimates.EstimatePageInput
@using LabelsMis.Domain.Entities
@using LabelsMis.Domain.Enums
@{
    var isReadOnly = (bool)(ViewData["IsReadOnly"] ?? false);
    var finishingOps = (IReadOnlyList<FinishingOperation>?)ViewData["FinishingOperations"] ?? Array.Empty<FinishingOperation>();
    var substrates = (IEnumerable<SelectListItem>?)ViewData["Substrates"] ?? Enumerable.Empty<SelectListItem>();
}

@if (isReadOnly)
{
    <input type="hidden" asp-for="CustomerId" />
}
<div class="estimate-workspace">
    <div class="estimate-workspace-main">
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" id="customer-select" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Customers"]!)" disabled="@isReadOnly">
            <option value="">Select customer</option>
        </select>
        @if (!isReadOnly)
        {
            <div class="form-text"><a asp-page="/Customers/Create" target="_blank">+ Add new customer</a></div>
        }
    </div>
    <div class="col-md-3">
        <label asp-for="SalesRepId" class="form-label">Sales rep</label>
        <select asp-for="SalesRepId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["SalesRepOptions"]!)" disabled="@isReadOnly">
            <option value="">Unassigned</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="ValidUntilDate" class="form-label">Valid until</label>
        <input asp-for="ValidUntilDate" class="form-control" type="date" readonly="@isReadOnly" />
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label">Header notes</label>
        <textarea asp-for="Notes" class="form-control" rows="2" readonly="@isReadOnly"></textarea>
    </div>
</div>

<h2 class="h5 mt-4 mb-2">Lines</h2>
@if (!isReadOnly)
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label for="product-filter-customer" class="form-label">Pull from existing product — customer</label>
            <select id="product-filter-customer" class="form-select">
                <option value="">All products</option>
                @foreach (var customer in (IEnumerable<SelectListItem>)ViewData["Customers"]!)
                {
                    <option value="@customer.Value">@customer.Text</option>
                }
            </select>
            <div class="form-text">Filter product choices on each line. Defaults to the estimate customer when selected.</div>
        </div>
    </div>
}
<div id="estimate-lines">
    @for (var i = 0; i < Model.Lines.Count; i++)
    {
        var line = Model.Lines[i];
        var selectedFinIds = line.FinishingOperations.Select(f => f.OperationId).ToHashSet();
        <div class="card mb-3 estimate-line" data-line-index="@i">
            <details class="estimate-line-details">
                <summary class="estimate-line-summary card-header">
                    <span class="estimate-line-chevron" aria-hidden="true"></span>
                    <span class="line-title">Line @(i + 1)</span>
                    <span class="line-desc">@(string.IsNullOrWhiteSpace(line.ProductDescription) ? "Untitled line" : line.ProductDescription)</span>
                    <span class="line-price-preview">—</span>
                    @if (!isReadOnly)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger remove-line">Remove</button>
                    }
                </summary>
                <div class="estimate-line-body card-body border-top">
                @if (line.Id.HasValue)
                {
                    <input type="hidden" name="Input.Lines[@i].Id" value="@line.Id" />
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Pull from existing product</label>
                        <select name="Input.Lines[@i].SourceProductId" class="form-select source-product" disabled="@isReadOnly">
                            <option value="">(none — describe below)</option>
                            @if (line.SourceProductId.HasValue)
                            {
                                <option value="@line.SourceProductId" selected>Loading…</option>
                            }
                        </select>
                        <div class="form-text">Selecting a product pre-fills the specs below.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Product description</label>
                        <input name="Input.Lines[@i].ProductDescription" value="@line.ProductDescription" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Label across (in)</label>
                        <input name="Input.Lines[@i].LabelAcrossIn" value="@line.LabelAcrossIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Label around (in)</label>
                        <input name="Input.Lines[@i].LabelAroundIn" value="@line.LabelAroundIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Corner radius (in)</label>
                        <input name="Input.Lines[@i].CornerRadiusIn" value="@line.CornerRadiusIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Gutter across (in)</label>
                        <input name="Input.Lines[@i].GutterAcrossIn" value="@line.GutterAcrossIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Gutter around (in)</label>
                        <input name="Input.Lines[@i].GutterAroundIn" value="@line.GutterAroundIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bleed (in)</label>
                        <input name="Input.Lines[@i].BleedIn" value="@line.BleedIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Substrate</label>
                        <select name="Input.Lines[@i].SubstrateId" class="form-select calc-immediate substrate-select" disabled="@isReadOnly">
                            <option value="">Select substrate</option>
                            @foreach (var s in substrates)
                            {
                                <option value="@s.Value" selected="@(s.Value == line.SubstrateId?.ToString())">@s.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ink set</label>
                        <select name="Input.Lines[@i].InkSet" class="form-select calc-immediate" disabled="@isReadOnly">
                            @foreach (var v in Enum.GetValues<LabelsMis.Domain.Enums.InkSet>())
                            {
                                <option value="@((int)v)" selected="@(v == line.InkSet)">@v</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 form-check align-self-end">
                        <input type="checkbox" name="Input.Lines[@i].WhiteInkUsed" value="true" class="form-check-input calc-immediate" disabled="@isReadOnly" checked="@line.WhiteInkUsed" />
                        <label class="form-check-label">White ink</label>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Setup waste (imp)</label>
                        <input name="Input.Lines[@i].SetupWasteImpressions" value="@line.SetupWasteImpressions" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Running waste %</label>
                        <input name="Input.Lines[@i].RunningWastePct" value="@line.RunningWastePct" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="line-@(i)-max-across">Labels across <span class="form-text d-inline labels-across-max">(auto)</span></label>
                        <select id="line-@(i)-max-across" name="Input.Lines[@i].MaxLabelsAcrossOverride" class="form-select calc-immediate labels-across-select" disabled="@isReadOnly">
                            <option value="" selected="@(!line.MaxLabelsAcrossOverride.HasValue)">Auto</option>
                            @for (var n = 1; n <= 12; n++)
                            {
                                <option value="@n" selected="@(line.MaxLabelsAcrossOverride == n)">@n up</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="line-@(i)-orientation">Orientation</label>
                        <select id="line-@(i)-orientation" name="Input.Lines[@i].LabelOrientationOverride" class="form-select calc-immediate orientation-select" disabled="@isReadOnly">
                            <option value="" selected="@(!line.LabelOrientationOverride.HasValue)">Auto (best fit)</option>
                            <option value="@((int)LabelOrientation.AsEntered)" selected="@(line.LabelOrientationOverride == LabelOrientation.AsEntered)">As entered</option>
                            <option value="@((int)LabelOrientation.Rotated)" selected="@(line.LabelOrientationOverride == LabelOrientation.Rotated)">Rotated 90°</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Finishing operations</label>
                        @if (!isReadOnly)
                        {
                            <div class="finishing-ops">
                                @for (var j = 0; j < finishingOps.Count; j++)
                                {
                                    var op = finishingOps[j];
                                    var selected = selectedFinIds.Contains(op.Id);
                                    var existing = line.FinishingOperations.FirstOrDefault(f => f.OperationId == op.Id);
                                    <div class="border rounded p-2 mb-2">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input finishing-toggle calc-immediate" data-op-id="@op.Id" @(selected ? "checked" : "") />
                                            <label class="form-check-label">@op.Code — @op.Description</label>
                                        </div>
                                        <div class="row g-2 mt-1 finishing-fields @(selected ? "" : "d-none")">
                                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].OperationId" value="@op.Id" class="finishing-op-id" disabled="@(!selected)" />
                                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SortOrder" value="@j" class="finishing-sort" disabled="@(!selected)" />
                                            <div class="col-md-3">
                                                <label class="form-label">Setup min override</label>
                                                <input name="Input.Lines[@i].FinishingOperations[@j].SetupMinutesOverride" value="@existing?.SetupMinutesOverride" class="form-control calc-trigger" disabled="@(!selected)" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Run speed fpm override</label>
                                                <input name="Input.Lines[@i].FinishingOperations[@j].RunSpeedFpmOverride" value="@existing?.RunSpeedFpmOverride" class="form-control calc-trigger" disabled="@(!selected)" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach (var sel in line.FinishingOperations)
                                {
                                    var op = finishingOps.FirstOrDefault(o => o.Id == sel.OperationId);
                                    <li>@(op?.Description ?? sel.OperationId.ToString())</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label">Quantity breaks</label>
                        <div class="form-text mb-1">Enter one to three quantity breaks. Values shift to the first slots automatically.</div>
                        <div class="row g-2 quantity-inputs">
                            @for (var q = 0; q < 3; q++)
                            {
                                var qty = q < line.Quantities.Count ? line.Quantities[q] : 0;
                                <div class="col-md-2">
                                    <input name="Input.Lines[@i].Quantities[@q]" value="@(qty == 0 ? "" : qty)" class="form-control calc-trigger quantity-input" placeholder="Qty" readonly="@isReadOnly" />
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Line notes</label>
                        <textarea name="Input.Lines[@i].LineNotes" class="form-control" rows="2" readonly="@isReadOnly">@line.LineNotes</textarea>
                    </div>
                </div>

                @if (!isReadOnly)
                {
                    <div class="mt-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="form-label mb-0 me-1">Margin</label>
                            <div class="input-group input-group-sm margin-control" style="width: auto;">
                                <button type="button" class="btn btn-outline-secondary margin-decrease" aria-label="Decrease margin">−</button>
                                <input type="text" class="form-control margin-input text-center" style="min-width: 4.5rem; max-width: 5rem;" inputmode="decimal" aria-label="Margin percent" placeholder="—" />
                                <button type="button" class="btn btn-outline-secondary margin-increase" aria-label="Increase margin">+</button>
                            </div>
                            <input type="hidden" name="Input.Lines[@i].MarkupPctOverride" value="@(line.MarkupPctOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" class="markup-override-input" />
                            <span class="form-text mb-0">Type a margin (e.g. 25 or 25%) or use ± for 1% steps</span>
                        </div>
                        <div class="calc-warnings alert alert-warning d-none"></div>
                        <div class="calc-errors alert alert-danger d-none"></div>
                        <table class="table table-sm calc-results">
                            <thead>
                                <tr><th>Qty</th><th>Unit price</th><th>Total</th><th>Margin %</th></tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="mt-3">
                        <input type="hidden" name="Input.Lines[@i].MarkupPctOverride" value="@(line.MarkupPctOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" class="markup-override-input" />
                        @for (var j = 0; j < line.FinishingOperations.Count; j++)
                        {
                            var sel = line.FinishingOperations[j];
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].OperationId" value="@sel.OperationId" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SortOrder" value="@j" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SetupMinutesOverride" value="@(sel.SetupMinutesOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].RunSpeedFpmOverride" value="@(sel.RunSpeedFpmOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                        }
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="form-label mb-0 me-1">Margin</label>
                            <div class="input-group input-group-sm margin-control" style="width: auto;">
                                <button type="button" class="btn btn-outline-secondary margin-decrease" aria-label="Decrease margin">−</button>
                                <input type="text" class="form-control margin-input text-center" style="min-width: 4.5rem; max-width: 5rem;" inputmode="decimal" aria-label="Margin percent" placeholder="—" />
                                <button type="button" class="btn btn-outline-secondary margin-increase" aria-label="Increase margin">+</button>
                            </div>
                            <span class="form-text mb-0">Adjust margin to recalculate pricing for this line</span>
                        </div>
                        <div class="calc-warnings alert alert-warning d-none"></div>
                        <div class="calc-errors alert alert-danger d-none"></div>
                        <table class="table table-sm calc-results">
                            <thead>
                                <tr><th>Qty</th><th>Unit price</th><th>Total</th><th>Margin %</th></tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                }
                </div>
            </details>
        </div>
    }
</div>

@if (!isReadOnly)
{
    <button type="button" id="add-line" class="btn btn-outline-secondary">+ Add line</button>
}
    </div>
    <aside class="estimate-workspace-panel" aria-label="Estimate summary">
        <div class="estimate-panel-card">
            <h2 class="estimate-panel-title">Estimate total</h2>
            <div id="estimate-totals-panel" class="estimate-totals-panel">
                <p class="text-muted small mb-0">Select a customer to calculate pricing.</p>
            </div>
        </div>
        <div class="estimate-panel-card estimate-panel-card--breakdown">
            <h2 class="estimate-panel-title">Calculation breakdown</h2>
            <div id="estimate-breakdown-panel" class="estimate-breakdown-panel estimate-breakdown-panel--empty">
                <p class="text-muted small mb-0">Expand a line to view its calculation breakdown.</p>
            </div>
        </div>
    </aside>
</div>

@model LabelsMis.Web.Pages.Estimates.EstimatePageInput
@using LabelsMis.Domain.Entities
@using LabelsMis.Domain.Enums
@using LabelsMis.Web.Services.Shipping
@using LabelsMis.Web.Pages.Shared
@{
    var isReadOnly = (bool)(ViewData["IsReadOnly"] ?? false);
    var outsourceVendors = (IEnumerable<SelectListItem>?)ViewData["OutsourceVendors"] ?? Enumerable.Empty<SelectListItem>();
    var finishingOps = (IReadOnlyList<FinishingOperation>?)ViewData["FinishingOperations"] ?? Array.Empty<FinishingOperation>();
    var finishingStocks = (IReadOnlyList<Stock>?)ViewData["FinishingStocks"] ?? Array.Empty<Stock>();
    var substrates = (IEnumerable<SelectListItem>?)ViewData["Substrates"] ?? Enumerable.Empty<SelectListItem>();
    var spotInks = (IReadOnlyList<Ink>?)ViewData["SpotInks"] ?? Array.Empty<Ink>();
    var dies = (IReadOnlyList<Die>?)ViewData["Dies"] ?? Array.Empty<Die>();
    var shrinkStocks = (IReadOnlyDictionary<Guid, decimal?>?)ViewData["ShrinkStocks"] ?? new Dictionary<Guid, decimal?>();
    var shippingMethods = (IReadOnlyList<ShippingMethodListItem>?)ViewData["ShippingMethods"] ?? Array.Empty<ShippingMethodListItem>();
}

@if (isReadOnly)
{
    <input type="hidden" asp-for="CustomerId" />
}
@if (!isReadOnly)
{
    <script type="application/json" id="finishing-ops-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(finishingOps.Select(o => new { id = o.Id, code = o.Code, description = o.Description, category = o.OperationType.ToString(), setupMinutes = o.DefaultSetupMinutes, runSpeedFpm = o.DefaultRunSpeedFpm })))</script>
    <script type="application/json" id="spot-inks-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(spotInks.Select(s => new { id = s.Id, code = s.Code, description = s.Description })))</script>
    <script type="application/json" id="finishing-stocks-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(finishingStocks.Select(s => new { id = s.Id, code = s.Code, description = s.Description })))</script>
    <script type="application/json" id="dies-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(dies.Select(d => new { id = d.Id, description = d.Description, setupRating = d.SetupRating, speedRating = d.SpeedRating, labelAcrossIn = d.LabelAcrossIn, labelAroundIn = d.LabelAroundIn, cornerRadiusIn = d.CornerRadiusIn, gutterAcrossIn = d.GutterAcrossIn, gutterAroundIn = d.GutterAroundIn, labelsAcross = d.LabelsAcross, labelsAround = d.LabelsAround })))</script>
    <script type="application/json" id="shrink-stocks-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(shrinkStocks))</script>
}
<div class="estimate-workspace">
    <div class="estimate-workspace-main">
<div class="card mb-2">
    <div class="card-header py-1 small fw-semibold">Estimate</div>
    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-md-6">
                <label asp-for="CustomerId" class="form-label">Customer</label>
                <select asp-for="CustomerId" id="customer-select" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Customers"]!)" disabled="@isReadOnly">
                    <option value="">Select customer</option>
                </select>
                @if (!isReadOnly)
                {
                    <div class="form-text"><a asp-page="/Customers/Create" target="_blank">+ Add new customer</a></div>
                }
            </div>
            <div class="col-md-3">
                <label asp-for="SalesRepId" class="form-label">Sales rep</label>
                <select asp-for="SalesRepId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["SalesRepOptions"]!)" disabled="@isReadOnly">
                    <option value="">Unassigned</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="ValidUntilDate" class="form-label">Valid until</label>
                <input asp-for="ValidUntilDate" class="form-control" type="date" readonly="@isReadOnly" />
            </div>
            <div class="col-md-6">
                <label asp-for="Notes" class="form-label">Header notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2" readonly="@isReadOnly"></textarea>
                <div class="form-text">Internal — carries to the sales order and job ticket, never printed for the customer. Pre-filled from the customer's notes when picked.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="BillingNotes" class="form-label">Billing notes</label>
                <textarea asp-for="BillingNotes" class="form-control" rows="2" readonly="@isReadOnly"></textarea>
                <div class="form-text">Internal — carries to the sales order. Never printed.</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-2 estimate-shipping" id="estimate-shipping">
    <div class="card-header py-1 small fw-semibold">Shipping</div>
    <div class="card-body py-2">
    <div class="row g-2">
        <div class="col-md-3">
            <label asp-for="ShippingMethodId" class="form-label">Method</label>
            <select asp-for="ShippingMethodId" id="shipping-method-select" class="form-select" disabled="@isReadOnly">
                <option value="" data-price="0" data-requires-address="true">No shipping</option>
                @foreach (var m in shippingMethods)
                {
                    <option value="@m.Id" data-price="@m.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-requires-address="@m.RequiresAddress.ToString().ToLowerInvariant()"
                            selected="@(m.Id == Model.ShippingMethodId)">
                        @m.Name — @m.Price.ToString("C2")@(m.IsActive ? "" : " (inactive)")
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ShippingCost" class="form-label">Price</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="ShippingCost" id="shipping-cost-input" class="form-control" readonly="@isReadOnly" />
            </div>
            <span asp-validation-for="ShippingCost" class="text-danger"></span>
        </div>
        @if (!isReadOnly)
        {
            <div class="col-md-6 shipto-group">
                <label for="shipto-source" class="form-label">Ship-to address</label>
                <select id="shipto-source" class="form-select">
                    <option value="custom">Enter manually</option>
                </select>
                <div class="form-text">Pull a billing or shipping address from the customer, or enter one below.</div>
            </div>
        }
        <div class="col-md-6 shipto-group">
            <label asp-for="ShipToName" class="form-label">Recipient / company</label>
            <input asp-for="ShipToName" class="form-control shipto-field" readonly="@isReadOnly" />
        </div>
        <div class="col-md-6 shipto-group">
            <label asp-for="ShipToStreet1" class="form-label">Street</label>
            <input asp-for="ShipToStreet1" class="form-control shipto-field" readonly="@isReadOnly" />
        </div>
        <div class="col-md-6 shipto-group">
            <label asp-for="ShipToStreet2" class="form-label">Street 2</label>
            <input asp-for="ShipToStreet2" class="form-control shipto-field" readonly="@isReadOnly" />
        </div>
        <div class="col-md-3 shipto-group">
            <label asp-for="ShipToCity" class="form-label">City</label>
            <input asp-for="ShipToCity" class="form-control shipto-field" readonly="@isReadOnly" />
        </div>
        <div class="col-md-1 shipto-group">
            <label asp-for="ShipToState" class="form-label">State</label>
            <input asp-for="ShipToState" class="form-control shipto-field" readonly="@isReadOnly" />
        </div>
        <div class="col-md-2 shipto-group">
            <label asp-for="ShipToZip" class="form-label">Zip</label>
            <input asp-for="ShipToZip" class="form-control shipto-field" readonly="@isReadOnly" />
        </div>
        <div class="col-md-2 shipto-group">
            <label asp-for="ShipToCountry" class="form-label">Country</label>
            <input asp-for="ShipToCountry" class="form-control shipto-field" readonly="@isReadOnly" placeholder="US" />
        </div>
    </div>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-3 mb-2">
    <h2 class="h5 mb-0">Lines</h2>
    @if (!isReadOnly)
    {
        <div class="d-flex align-items-center gap-2">
            <label for="product-filter-customer" class="form-label small mb-0 text-muted text-nowrap"
                   title="Filter product choices on each line. Defaults to the estimate customer when selected.">Product filter</label>
            <select id="product-filter-customer" class="form-select form-select-sm" style="min-width: 16rem;">
                <option value="">All products</option>
                <option value="house">House products (no customer)</option>
                @foreach (var customer in (IEnumerable<SelectListItem>)ViewData["Customers"]!)
                {
                    <option value="@customer.Value">@customer.Text</option>
                }
            </select>
        </div>
    }
</div>
<div id="estimate-lines">
    @for (var i = 0; i < Model.Lines.Count; i++)
    {
        var line = Model.Lines[i];
        <div class="card mb-2 estimate-line" data-line-index="@i">
            <details class="estimate-line-details">
                <summary class="estimate-line-summary card-header">
                    <span class="estimate-line-chevron" aria-hidden="true"></span>
                    <span class="line-title">Line @(i + 1)</span>
                    <span class="line-desc">@(string.IsNullOrWhiteSpace(line.ProductDescription) ? "Untitled line" : line.ProductDescription)</span>
                    <span class="line-price-preview">—</span>
                    @if (!isReadOnly)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger remove-line">Remove</button>
                    }
                </summary>
                <div class="estimate-line-body card-body border-top">
                @if (line.Id.HasValue)
                {
                    <input type="hidden" name="Input.Lines[@i].Id" value="@line.Id" />
                }
                <div class="estimate-line-grid">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Pull from existing product</label>
                        <select name="Input.Lines[@i].SourceProductId" class="form-select source-product" disabled="@isReadOnly">
                            <option value="">(none — describe below)</option>
                            @if (line.SourceProductId.HasValue)
                            {
                                <option value="@line.SourceProductId" selected>Loading…</option>
                            }
                        </select>
                        <div class="form-text">Selecting a product pre-fills the specs below.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Product description</label>
                        <input name="Input.Lines[@i].ProductDescription" value="@line.ProductDescription" class="form-control calc-trigger" readonly="@isReadOnly" />
                    </div>
                </div>

                <div class="estimate-line-section">
                    <div class="estimate-line-section-title">Dimensions <span class="text-muted text-lowercase fw-normal">(in)</span></div>
                    <div class="row g-2">
                        <div class="col-6 col-md-2">
                            <label class="form-label">Across</label>
                            <input name="Input.Lines[@i].LabelAcrossIn" value="@line.LabelAcrossIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Around</label>
                            <input name="Input.Lines[@i].LabelAroundIn" value="@line.LabelAroundIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Corner radius</label>
                            <input name="Input.Lines[@i].CornerRadiusIn" value="@line.CornerRadiusIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Gutter across</label>
                            <input name="Input.Lines[@i].GutterAcrossIn" value="@line.GutterAcrossIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Gutter around</label>
                            <input name="Input.Lines[@i].GutterAroundIn" value="@line.GutterAroundIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Bleed</label>
                            <input name="Input.Lines[@i].BleedIn" value="@line.BleedIn" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                    </div>
                </div>

                <div class="estimate-line-section">
                    <div class="estimate-line-section-title">Material &amp; ink</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Substrate</label>
                            <select name="Input.Lines[@i].SubstrateId" class="form-select calc-immediate substrate-select" disabled="@isReadOnly">
                                <option value="">Select substrate</option>
                                @foreach (var s in substrates)
                                {
                                    <option value="@s.Value" selected="@(s.Value == line.SubstrateId?.ToString())">@s.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ink set</label>
                            <select name="Input.Lines[@i].InkSet" class="form-select calc-immediate" disabled="@isReadOnly">
                                @foreach (var v in Enum.GetValues<LabelsMis.Domain.Enums.InkSet>())
                                {
                                    <option value="@((int)v)" selected="@(v == line.InkSet)">@v</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3 shrink-layflat-group @(line.SubstrateId is { } shrinkSubId && shrinkStocks.ContainsKey(shrinkSubId) ? "" : "d-none")">
                            <label class="form-label">Shrink layflat (in)</label>
                            <input name="Input.Lines[@i].ShrinkLayflatIn" value="@(line.ShrinkLayflatIn?.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture))" class="form-control calc-trigger shrink-layflat-input" readonly="@isReadOnly" />
                        </div>
                        <div class="col-12 white-ink-group @(line.InkSet is InkSet.CMYKW or InkSet.CMYKW_PlusSpot or InkSet.EPMW ? "" : "d-none")">
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <label class="form-label">White hits</label>
                                    <select name="Input.Lines[@i].WhiteHits" class="form-select calc-immediate special-hits-select" data-coverage-group="white-coverage-group" disabled="@isReadOnly">
                                        @for (var h = 0; h <= 3; h++)
                                        {
                                            <option value="@h" selected="@(h == line.WhiteHits)">@(h == 0 ? "None" : $"{h} hit{(h == 1 ? "" : "s")}")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6 col-md-3 white-coverage-group @(line.WhiteHits > 0 ? "" : "d-none")">
                                    <label class="form-label">White coverage <span class="coverage-readout">@((int)line.WhiteCoveragePct)%</span></label>
                                    <input type="range" min="0" max="100" step="1" name="Input.Lines[@i].WhiteCoveragePct" value="@((int)line.WhiteCoveragePct)" class="form-range calc-immediate coverage-slider" disabled="@isReadOnly" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 spot-ink-group @(line.InkSet is InkSet.CMYK_PlusSpot or InkSet.CMYKW_PlusSpot ? "" : "d-none")">
                            <label class="form-label">Spot colors</label>
                            @if (!isReadOnly)
                            {
                                <div class="spot-builder row g-2 align-items-end mb-2">
                                    <div class="col-md-6">
                                        <select class="form-select spot-ink-select">
                                            <option value="">Select spot color</option>
                                            @foreach (var si in spotInks)
                                            {
                                                <option value="@si.Id">@si.Code — @si.Description</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-outline-primary spot-add w-100" disabled>Add spot</button>
                                    </div>
                                </div>
                            }
                            <div class="spot-selected">
                                @for (var j = 0; j < line.Spots.Count; j++)
                                {
                                    var sp = line.Spots[j];
                                    var spInk = spotInks.FirstOrDefault(x => x.Id == sp.InkId);
                                    <div class="spot-item border rounded p-2 mb-2" data-ink-id="@sp.InkId">
                                        <div class="d-flex flex-wrap gap-2 align-items-end">
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold spot-name">@(spInk is null ? sp.InkId.ToString() : $"{spInk.Code} — {spInk.Description}")</div>
                                                <input type="hidden" name="Input.Lines[@i].Spots[@j].InkId" value="@sp.InkId" class="spot-ink-id" />
                                                <input type="hidden" name="Input.Lines[@i].Spots[@j].SortOrder" value="@j" class="spot-sort" />
                                            </div>
                                            <div>
                                                <label class="form-label small mb-0">Hits</label>
                                                <select name="Input.Lines[@i].Spots[@j].Hits" class="form-select form-select-sm calc-immediate spot-hits" style="max-width: 7rem;" disabled="@isReadOnly">
                                                    @for (var h = 1; h <= 3; h++)
                                                    {
                                                        <option value="@h" selected="@(h == sp.Hits)">@h hit@(h == 1 ? "" : "s")</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="spot-coverage-group">
                                                <label class="form-label small mb-0">Coverage <span class="coverage-readout">@((int)sp.CoveragePct)%</span></label>
                                                <input type="range" min="0" max="100" step="1" name="Input.Lines[@i].Spots[@j].CoveragePct" value="@((int)sp.CoveragePct)" class="form-range calc-immediate coverage-slider" disabled="@isReadOnly" />
                                            </div>
                                            @if (!isReadOnly)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger spot-remove">Remove</button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="estimate-line-section">
                    <div class="estimate-line-section-title">Imposition &amp; waste</div>
                    <div class="form-text die-layout-note d-none"></div>
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="line-@(i)-max-across">Labels across <span class="form-text d-inline labels-across-max">(auto)</span></label>
                            <select id="line-@(i)-max-across" name="Input.Lines[@i].MaxLabelsAcrossOverride" class="form-select calc-immediate labels-across-select" disabled="@isReadOnly">
                                <option value="" selected="@(!line.MaxLabelsAcrossOverride.HasValue)">Auto</option>
                                @for (var n = 1; n <= 12; n++)
                                {
                                    <option value="@n" selected="@(line.MaxLabelsAcrossOverride == n)">@n up</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="line-@(i)-orientation">Orientation</label>
                            <select id="line-@(i)-orientation" name="Input.Lines[@i].LabelOrientationOverride" class="form-select calc-immediate orientation-select" disabled="@isReadOnly">
                                <option value="" selected="@(!line.LabelOrientationOverride.HasValue)">Auto (best fit)</option>
                                <option value="@((int)LabelOrientation.AsEntered)" selected="@(line.LabelOrientationOverride == LabelOrientation.AsEntered)">As entered</option>
                                <option value="@((int)LabelOrientation.Rotated)" selected="@(line.LabelOrientationOverride == LabelOrientation.Rotated)">Rotated 90°</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="line-@(i)-unwind">Unwind direction</label>
                            <select id="line-@(i)-unwind" name="Input.Lines[@i].Unwind" class="form-select unwind-select" disabled="@isReadOnly">
                                <option value="" selected="@(!line.Unwind.HasValue)">Not specified</option>
                                @foreach (var unwind in Enum.GetValues<UnwindDirection>())
                                {
                                    <option value="@((int)unwind)" selected="@(line.Unwind == unwind)">@unwind.Label()</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Setup waste (imp)</label>
                            <input name="Input.Lines[@i].SetupWasteImpressions" value="@line.SetupWasteImpressions" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Running waste %</label>
                            <input name="Input.Lines[@i].RunningWastePct" value="@line.RunningWastePct" class="form-control calc-trigger" readonly="@isReadOnly" />
                        </div>
                    </div>
                </div>
                    <div class="estimate-line-section">
                        <div class="estimate-line-section-title">Finishing operations</div>
                        @if (!isReadOnly)
                        {
                            <div class="finishing-builder row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">Category</label>
                                    <select class="form-select finishing-category-select">
                                        <option value="">Select category</option>
                                        @foreach (var cat in finishingOps.Select(o => o.OperationType).Distinct())
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label small mb-1">Operation</label>
                                    <select class="form-select finishing-operation-select" disabled>
                                        <option value="">Select operation</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="button" class="btn btn-outline-primary finishing-add w-100" disabled>Add operation</button>
                                </div>
                            </div>
                            <div class="finishing-selected mt-2">
                                @for (var j = 0; j < line.FinishingOperations.Count; j++)
                                {
                                    var sel = line.FinishingOperations[j];
                                    var op = finishingOps.FirstOrDefault(o => o.Id == sel.OperationId);
                                    <div class="finishing-item border rounded p-2 mb-2" data-op-id="@sel.OperationId">
                                        <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].OperationId" value="@sel.OperationId" class="finishing-op-id" />
                                        <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SortOrder" value="@j" class="finishing-sort" />
                                        <div class="d-flex justify-content-between align-items-center gap-2">
                                            <div class="text-truncate">
                                                <span class="fw-semibold">@(op is null ? sel.OperationId.ToString() : $"{op.Code} — {op.Description}")</span>
                                                @if (op is not null)
                                                {
                                                    <span class="badge text-bg-secondary ms-1">@op.OperationType</span>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 finishing-remove">Remove</button>
                                        </div>
                                        <div class="row g-2 mt-0">
                                            @if (op?.OperationType is FinishingOperationType.DieCut)
                                            {
                                                <div class="col-md-4 finishing-die-group">
                                                    <label class="form-label small mb-0">Die</label>
                                                    <select name="Input.Lines[@i].FinishingOperations[@j].DieId" class="form-select form-select-sm finishing-die-select">
                                                        <option value="">No die</option>
                                                        @foreach (var d in dies)
                                                        {
                                                            <option value="@d.Id" selected="@(d.Id == sel.DieId)">@d.Description</option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                            <div class="col-6 col-md-2">
                                                <label class="form-label small mb-0">Setup (min)</label>
                                                <input name="Input.Lines[@i].FinishingOperations[@j].SetupMinutesOverride" value="@(sel.SetupMinutesOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="@op?.DefaultSetupMinutes.ToString("0.##")" class="form-control form-control-sm calc-trigger" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label small mb-0">Speed (fpm)</label>
                                                <input name="Input.Lines[@i].FinishingOperations[@j].RunSpeedFpmOverride" value="@(sel.RunSpeedFpmOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="@op?.DefaultRunSpeedFpm.ToString("0.##")" class="form-control form-control-sm calc-trigger" />
                                            </div>
                                            @if (op?.OperationType is FinishingOperationType.Laminate or FinishingOperationType.Foil)
                                            {
                                                <div class="col-md-4 finishing-stock-group">
                                                    <label class="form-label small mb-0">Material stock</label>
                                                    <select name="Input.Lines[@i].FinishingOperations[@j].StockId" class="form-select form-select-sm finishing-stock-select">
                                                        <option value="">Select stock</option>
                                                        @foreach (var fs in finishingStocks)
                                                        {
                                                            <option value="@fs.Id" selected="@(fs.Id == sel.StockId)">@fs.Code — @fs.Description</option>
                                                        }
                                                    </select>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach (var sel in line.FinishingOperations)
                                {
                                    var op = finishingOps.FirstOrDefault(o => o.Id == sel.OperationId);
                                    <li>@(op?.Description ?? sel.OperationId.ToString())</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="estimate-line-section">
                        <div class="estimate-line-section-title">Quantity breaks</div>
                        <div class="form-text mb-2">Enter up to six quantity breaks. Values shift to the first slots automatically.</div>
                        <div class="row g-2 quantity-inputs">
                            @for (var q = 0; q < 6; q++)
                            {
                                var qty = q < line.Quantities.Count ? line.Quantities[q] : null;
                                <div class="col-4 col-sm-3 col-md-2">
                                    <div class="input-group">
                                        <span class="input-group-text">@(q + 1)</span>
                                        <input name="Input.Lines[@i].Quantities[@q]" value="@(qty is > 0 ? qty : "")" class="form-control calc-trigger quantity-input" placeholder="Qty" readonly="@isReadOnly" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="estimate-line-section">
                        <div class="estimate-line-section-title">Line notes</div>
                        <textarea name="Input.Lines[@i].LineNotes" class="form-control" rows="2" readonly="@isReadOnly">@line.LineNotes</textarea>
                    </div>
                    <div class="estimate-line-section estimate-line-outsource">
                        <div class="estimate-line-section-title">Outsourcing</div>
                        <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel($"Input.Lines[{i}]", outsourceVendors)
                        {
                            IsOutsourced = line.IsOutsourced,
                            VendorId = line.OutsourceVendorId,
                            QuoteNumber = line.OutsourceQuoteNumber,
                            ExpectedIn = line.OutsourceExpectedIn,
                            PrivateNotes = line.OutsourcePrivateNotes,
                            ShowCost = false,
                            PricingJson = line.OutsourcePricingJson,
                            ReadOnly = isReadOnly,
                            ToggleLabel = "Outsource this line",
                            Hint = "Enter the vendor cost and our final price for each quantity in the pricing table below — the in-house calculation stays alongside for comparison."
                        })" />
                    </div>
                </div>

                @if (!isReadOnly)
                {
                    <div class="mt-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="form-label mb-0 me-1">Margin</label>
                            <div class="input-group input-group-sm margin-control" style="width: auto;">
                                <button type="button" class="btn btn-outline-secondary margin-decrease" aria-label="Decrease margin">−</button>
                                <input type="text" class="form-control margin-input text-center" style="min-width: 4.5rem; max-width: 5rem;" inputmode="decimal" aria-label="Margin percent" placeholder="—" />
                                <button type="button" class="btn btn-outline-secondary margin-increase" aria-label="Increase margin">+</button>
                            </div>
                            <input type="hidden" name="Input.Lines[@i].MarkupPctOverride" value="@(line.MarkupPctOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" class="markup-override-input" />
                            <input type="hidden" name="Input.Lines[@i].QuantityMarkupOverridesJson" value="@line.QuantityMarkupOverridesJson" class="qty-markup-json" />
                            <span class="form-text mb-0">Sets the margin for every quantity — adjust a row's margin or type its total below to override one</span>
                        </div>
                        <div class="calc-warnings alert alert-warning d-none"></div>
                        <div class="calc-errors alert alert-danger d-none"></div>
                        <table class="table table-sm calc-results">
                            <thead>
                                <tr><th>Qty</th><th>Unit price</th><th>Total</th><th>Margin %</th></tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="mt-3">
                        <input type="hidden" name="Input.Lines[@i].MarkupPctOverride" value="@(line.MarkupPctOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" class="markup-override-input" />
                        <input type="hidden" name="Input.Lines[@i].QuantityMarkupOverridesJson" value="@line.QuantityMarkupOverridesJson" class="qty-markup-json" />
                        @for (var j = 0; j < line.FinishingOperations.Count; j++)
                        {
                            var sel = line.FinishingOperations[j];
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].OperationId" value="@sel.OperationId" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SortOrder" value="@j" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SetupMinutesOverride" value="@(sel.SetupMinutesOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].RunSpeedFpmOverride" value="@(sel.RunSpeedFpmOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                            <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].StockId" value="@(sel.StockId?.ToString() ?? "")" />
                        }
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="form-label mb-0 me-1">Margin</label>
                            <div class="input-group input-group-sm margin-control" style="width: auto;">
                                <button type="button" class="btn btn-outline-secondary margin-decrease" aria-label="Decrease margin">−</button>
                                <input type="text" class="form-control margin-input text-center" style="min-width: 4.5rem; max-width: 5rem;" inputmode="decimal" aria-label="Margin percent" placeholder="—" />
                                <button type="button" class="btn btn-outline-secondary margin-increase" aria-label="Increase margin">+</button>
                            </div>
                            <span class="form-text mb-0">Adjust margin to recalculate pricing for this line</span>
                        </div>
                        <div class="calc-warnings alert alert-warning d-none"></div>
                        <div class="calc-errors alert alert-danger d-none"></div>
                        <table class="table table-sm calc-results">
                            <thead>
                                <tr><th>Qty</th><th>Unit price</th><th>Total</th><th>Margin %</th></tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                }
                </div>
            </details>
        </div>
    }
</div>

@if (!isReadOnly)
{
    <button type="button" id="add-line" class="btn btn-outline-secondary">+ Add line</button>
}

@if (!isReadOnly || Model.Charges.Count > 0)
{
    <div class="card mb-2 mt-3" id="estimate-charges-card">
        <div class="card-header py-1 small fw-semibold">Additional charges</div>
        <div class="card-body py-2">
            @if (!isReadOnly)
            {
                <div class="form-text mb-2">One-time charges (die creation, design time) and <strong>outsourced items</strong> — promo products, printed pieces, wide format — bought from a vendor. Billed with the order; they never become production jobs, and outsourced items are tracked and received on the production Outsourced page.</div>
            }
            <div id="estimate-charges">
                @for (var c = 0; c < Model.Charges.Count; c++)
                {
                    var charge = Model.Charges[c];
                    <div class="row g-2 align-items-end mb-2 estimate-charge-row">
                        @if (charge.Id.HasValue)
                        {
                            <input type="hidden" name="Input.Charges[@c].Id" value="@charge.Id" />
                        }
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Description</label>
                            <input name="Input.Charges[@c].Description" value="@charge.Description" list="charge-presets"
                                   class="form-control form-control-sm charge-desc" placeholder="e.g. Die charge — 3.5&quot; × 2&quot; rotary die" readonly="@isReadOnly" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small mb-0">Qty</label>
                            <input name="Input.Charges[@c].Quantity" value="@charge.Quantity" class="form-control form-control-sm charge-qty" readonly="@isReadOnly" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small mb-0">Unit price</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">$</span>
                                <input name="Input.Charges[@c].UnitPrice" value="@charge.UnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control charge-price" readonly="@isReadOnly" />
                            </div>
                        </div>
                        <div class="col-4 col-md-2 d-flex align-items-center justify-content-between gap-2 pb-1">
                            <span class="small fw-semibold charge-total">@((charge.UnitPrice * charge.Quantity).ToString("C2"))</span>
                            @if (!isReadOnly)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger charge-remove" aria-label="Remove charge">×</button>
                            }
                        </div>
                        <div class="col-12">
                            <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel($"Input.Charges[{c}]", outsourceVendors)
                            {
                                IsOutsourced = charge.IsOutsourced,
                                VendorId = charge.OutsourceVendorId,
                                QuoteNumber = charge.OutsourceQuoteNumber,
                                VendorCost = charge.OutsourceCost,
                                ExpectedIn = charge.OutsourceExpectedIn,
                                PrivateNotes = charge.OutsourcePrivateNotes,
                                ReadOnly = isReadOnly,
                                ToggleLabel = "Outsourced item (promo, print, wide format)",
                                CostInputClass = "charge-outsource-cost",
                                MarginReadoutClass = "charge-outsource-margin"
                            })" />
                        </div>
                    </div>
                }
            </div>
            @if (!isReadOnly)
            {
                <button type="button" id="add-charge" class="btn btn-sm btn-outline-secondary">+ Add charge</button>
                <datalist id="charge-presets">
                    <option value="Die charge"></option>
                    <option value="Design charge"></option>
                    <option value="Plate charge"></option>
                    <option value="Setup charge"></option>
                    <option value="Promo item"></option>
                    <option value="Printed piece"></option>
                    <option value="Wide format print"></option>
                </datalist>
            }
        </div>
    </div>
}

@if (!isReadOnly)
{
    <template id="charge-row-template">
        <div class="row g-2 align-items-end mb-2 estimate-charge-row">
            <div class="col-md-6">
                <label class="form-label small mb-0">Description</label>
                <input name="Input.Charges[__CHARGE__].Description" list="charge-presets" class="form-control form-control-sm charge-desc" placeholder="e.g. Die charge — 3.5&quot; × 2&quot; rotary die" />
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label small mb-0">Qty</label>
                <input name="Input.Charges[__CHARGE__].Quantity" value="1" class="form-control form-control-sm charge-qty" />
            </div>
            <div class="col-4 col-md-2">
                <label class="form-label small mb-0">Unit price</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">$</span>
                    <input name="Input.Charges[__CHARGE__].UnitPrice" value="" class="form-control charge-price" />
                </div>
            </div>
            <div class="col-4 col-md-2 d-flex align-items-center justify-content-between gap-2 pb-1">
                <span class="small fw-semibold charge-total">—</span>
                <button type="button" class="btn btn-sm btn-outline-danger charge-remove" aria-label="Remove charge">×</button>
            </div>
            <div class="col-12">
                <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel("Input.Charges[__CHARGE__]", outsourceVendors)
                {
                    ToggleLabel = "Outsourced item (promo, print, wide format)",
                    CostInputClass = "charge-outsource-cost",
                    MarginReadoutClass = "charge-outsource-margin"
                })" />
            </div>
        </div>
    </template>
}
    </div>
    <aside class="estimate-workspace-panel" aria-label="Estimate summary">
        <div class="estimate-panel-card">
            <h2 class="estimate-panel-title">Estimate total</h2>
            <div id="estimate-totals-panel" class="estimate-totals-panel">
                <p class="text-muted small mb-0">Select a customer to calculate pricing.</p>
            </div>
        </div>
        <div class="estimate-panel-card estimate-panel-card--breakdown">
            <h2 class="estimate-panel-title">Calculation breakdown</h2>
            <div id="estimate-breakdown-panel" class="estimate-breakdown-panel estimate-breakdown-panel--empty">
                <p class="text-muted small mb-0">Expand a line to view its calculation breakdown.</p>
            </div>
        </div>
    </aside>
</div>

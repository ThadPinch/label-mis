@using LabelsMis.Domain.Entities
@using LabelsMis.Domain.Enums
@{
    var finishingOps = (IReadOnlyList<FinishingOperation>?)ViewData["FinishingOperations"] ?? Array.Empty<FinishingOperation>();
    var substrates = (IEnumerable<SelectListItem>?)ViewData["Substrates"] ?? Enumerable.Empty<SelectListItem>();
    var i = "__INDEX__";
}
<template id="estimate-line-template">
    <div class="card mb-3 estimate-line" data-line-index="@i">
        <details class="estimate-line-details">
            <summary class="estimate-line-summary card-header">
                <span class="estimate-line-chevron" aria-hidden="true"></span>
                <span class="line-title">Line __DISPLAY__</span>
                <span class="line-desc">Untitled line</span>
                <span class="line-price-preview">—</span>
                <button type="button" class="btn btn-sm btn-outline-danger remove-line">Remove</button>
            </summary>
            <div class="estimate-line-body card-body border-top">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Pull from existing product</label>
                    <select name="Input.Lines[@i].SourceProductId" class="form-select source-product">
                        <option value="">(none — describe below)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Product description</label>
                    <input name="Input.Lines[@i].ProductDescription" class="form-control calc-trigger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Label across (in)</label>
                    <input name="Input.Lines[@i].LabelAcrossIn" value="4" class="form-control calc-trigger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Label around (in)</label>
                    <input name="Input.Lines[@i].LabelAroundIn" value="3" class="form-control calc-trigger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Corner radius (in)</label>
                    <input name="Input.Lines[@i].CornerRadiusIn" value="0.125" class="form-control calc-trigger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Gutter across (in)</label>
                    <input name="Input.Lines[@i].GutterAcrossIn" value="0.0625" class="form-control calc-trigger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Gutter around (in)</label>
                    <input name="Input.Lines[@i].GutterAroundIn" value="0.0625" class="form-control calc-trigger" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Bleed (in)</label>
                    <input name="Input.Lines[@i].BleedIn" value="0.0625" class="form-control calc-trigger" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Substrate</label>
                    <select name="Input.Lines[@i].SubstrateId" class="form-select calc-immediate substrate-select">
                        <option value="">Select substrate</option>
                        @foreach (var s in substrates)
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ink set</label>
                    <select name="Input.Lines[@i].InkSet" class="form-select calc-immediate">
                        @foreach (var v in Enum.GetValues<LabelsMis.Domain.Enums.InkSet>())
                        {
                            <option value="@((int)v)">@v</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 form-check align-self-end">
                    <input type="checkbox" name="Input.Lines[@i].WhiteInkUsed" value="true" class="form-check-input calc-immediate" />
                    <label class="form-check-label">White ink</label>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Setup waste (imp)</label>
                    <input name="Input.Lines[@i].SetupWasteImpressions" value="30" class="form-control calc-trigger" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Running waste %</label>
                    <input name="Input.Lines[@i].RunningWastePct" value="0.03" class="form-control calc-trigger" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Labels across <span class="form-text d-inline labels-across-max">(auto)</span></label>
                    <select name="Input.Lines[@i].MaxLabelsAcrossOverride" class="form-select calc-immediate labels-across-select">
                        <option value="" selected>Auto</option>
                        @for (var n = 1; n <= 12; n++)
                        {
                            <option value="@n">@n up</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Orientation</label>
                    <select name="Input.Lines[@i].LabelOrientationOverride" class="form-select calc-immediate orientation-select">
                        <option value="" selected>Auto (best fit)</option>
                        <option value="@((int)LabelOrientation.AsEntered)">As entered</option>
                        <option value="@((int)LabelOrientation.Rotated)">Rotated 90°</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Finishing operations</label>
                    <div class="finishing-ops">
                        @for (var j = 0; j < finishingOps.Count; j++)
                        {
                            var op = finishingOps[j];
                            <div class="border rounded p-2 mb-2">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input finishing-toggle calc-immediate" data-op-id="@op.Id" />
                                    <label class="form-check-label">@op.Code — @op.Description</label>
                                </div>
                                <div class="row g-2 mt-1 finishing-fields d-none">
                                    <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].OperationId" value="@op.Id" class="finishing-op-id" disabled />
                                    <input type="hidden" name="Input.Lines[@i].FinishingOperations[@j].SortOrder" value="@j" class="finishing-sort" disabled />
                                    <div class="col-md-3">
                                        <label class="form-label">Setup min override</label>
                                        <input name="Input.Lines[@i].FinishingOperations[@j].SetupMinutesOverride" class="form-control calc-trigger" disabled />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Run speed fpm override</label>
                                        <input name="Input.Lines[@i].FinishingOperations[@j].RunSpeedFpmOverride" class="form-control calc-trigger" disabled />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Quantity breaks</label>
                    <div class="form-text mb-1">Enter one to three quantity breaks. Values shift to the first slots automatically.</div>
                    <div class="row g-2 quantity-inputs">
                        <div class="col-md-2"><input name="Input.Lines[@i].Quantities[0]" value="" class="form-control calc-trigger quantity-input" placeholder="Qty" /></div>
                        <div class="col-md-2"><input name="Input.Lines[@i].Quantities[1]" value="" class="form-control calc-trigger quantity-input" placeholder="Qty" /></div>
                        <div class="col-md-2"><input name="Input.Lines[@i].Quantities[2]" value="" class="form-control calc-trigger quantity-input" placeholder="Qty" /></div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Line notes</label>
                    <textarea name="Input.Lines[@i].LineNotes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="form-label mb-0 me-1">Margin</label>
                    <div class="input-group input-group-sm margin-control" style="width: auto;">
                        <button type="button" class="btn btn-outline-secondary margin-decrease" aria-label="Decrease margin">−</button>
                        <input type="text" class="form-control margin-input text-center" style="min-width: 4.5rem; max-width: 5rem;" inputmode="decimal" aria-label="Margin percent" placeholder="—" />
                        <button type="button" class="btn btn-outline-secondary margin-increase" aria-label="Increase margin">+</button>
                    </div>
                    <input type="hidden" name="Input.Lines[@i].MarkupPctOverride" value="" class="markup-override-input" />
                    <span class="form-text mb-0">Type a margin (e.g. 25 or 25%) or use ± for 1% steps</span>
                </div>
                <div class="calc-warnings alert alert-warning d-none"></div>
                <div class="calc-errors alert alert-danger d-none"></div>
                <table class="table table-sm calc-results">
                    <thead><tr><th>Qty</th><th>Unit price</th><th>Total</th><th>Margin %</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            </div>
        </details>
    </div>
</template>

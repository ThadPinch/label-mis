@page "/estimates/{id:guid}/edit"
@model LabelsMis.Web.Pages.Estimates.EditModel
@using LabelsMis.Domain.Enums
@{
    ViewData["Title"] = Model.Detail?.Estimate.EstimateNumber ?? "Estimate";
    ViewData["IsReadOnly"] = Model.IsReadOnly;
    ViewData["EstimateNumber"] = Model.Detail?.Estimate.EstimateNumber;
    ViewData["RevisionNumber"] = Model.Detail?.Estimate.RevisionNumber ?? 1;
    ViewData["BackNav"] = new BackNavModel();
}

@if (Model.Detail is null)
{
    <p>Estimate not found.</p>
}
else
{
    @if (TempData["EstimateStatus"] is string statusMessage)
    {
        <div class="alert alert-success">@statusMessage</div>
    }
    @if (TempData["EstimateError"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">@Model.Detail.Estimate.EstimateNumber</h1>
            <p class="text-muted mb-0">Revision @Model.Detail.Estimate.RevisionNumber · @Model.Detail.Estimate.Status</p>
            @if (Model.Detail.SalesOrderId is not null)
            {
                <p class="mb-0 mt-1">
                    <span class="text-muted">Sales order:</span>
                    <a asp-page="/SalesOrders/Edit" asp-route-id="@Model.Detail.SalesOrderId">@(Model.Detail.SalesOrderNumber ?? "View sales order")</a>
                </p>
            }
        </div>
        <div class="text-end">
            @if (Model.Detail.Estimate.PdfFilePath is not null)
            {
                <span class="badge text-bg-secondary">PDF generated</span>
            }
        </div>
    </div>

    @if (Model.Detail.Revisions.Count > 0)
    {
        <div class="mb-3">
            <label class="form-label">Prior revisions</label>
            <select class="form-select w-auto" disabled>
                @foreach (var rev in Model.Detail.Revisions)
                {
                    <option>Revision @rev.RevisionNumber — @rev.CreatedAt.ToString("yyyy-MM-dd")</option>
                }
            </select>
        </div>
    }

    @if (Model.IsReadOnly)
    {
        <div class="estimate-page">
        <div class="estimate-action-bar">
            @if (Model.CanEdit)
            {
                <form method="post" asp-page-handler="Resend" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="hidden" asp-for="Id" />
                    <input asp-for="EmailTo" type="email" class="form-control estimate-action-email" placeholder="Email address" />
                    <a id="estimate-add-contact" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" hidden>+ Add a contact</a>
                    <button type="submit" class="btn btn-success">Resend email</button>
                </form>
                <form method="post" asp-page-handler="CreateRevision" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-primary">Create revision</button>
                </form>
            }
            <a asp-page-handler="Pdf" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary">Open PDF</a>
            @if (Model.Detail.Estimate.Status == EstimateStatus.Won && Model.Detail.SalesOrderId is null && Model.CanEdit)
            {
                <a asp-page="Convert" asp-route-id="@Model.Id" class="btn btn-success">Convert to sales order</a>
            }
            @if (Model.Detail.SalesOrderId is not null)
            {
                <a asp-page="/SalesOrders/Edit" asp-route-id="@Model.Detail.SalesOrderId" class="btn btn-outline-secondary">View sales order @Model.Detail.SalesOrderNumber</a>
            }
            @if (Model.CanAdmin && Model.Detail.Estimate.Status is EstimateStatus.Sent or EstimateStatus.Draft)
            {
                <form method="post" asp-page-handler="MarkWon" class="d-inline">
                    <button type="submit" class="btn btn-outline-success">Mark won</button>
                </form>
            }
            @if (Model.CanAdmin && Model.Detail.Estimate.Status is not EstimateStatus.Won and not EstimateStatus.Lost)
            {
                <form method="post" asp-page-handler="MarkLost" class="d-inline">
                    <input type="hidden" asp-for="LostReason" value="" />
                    <button type="submit" class="btn btn-outline-danger">Mark lost</button>
                </form>
            }
        </div>
        <div id="estimate-readonly-root">
            <partial name="_EstimateForm" model="Model.Input" />
        </div>
        </div>
    }
    else
    {
        <div class="estimate-page">
        <form method="post" id="estimate-form">
            <div class="estimate-action-bar">
                <button type="submit" asp-page-handler="SaveDraft" class="btn btn-primary">Save draft</button>
                <button type="submit" asp-page-handler="Send" class="btn btn-success">Send to customer</button>
                <button type="submit" asp-page-handler="PreviewPdf" formtarget="_blank" formnovalidate class="btn btn-outline-secondary">Open PDF</button>
                <label class="form-check-label ms-2">
                    <input asp-for="SendEmail" class="form-check-input" /> Email PDF
                </label>
                <input asp-for="EmailTo" type="email" class="form-control estimate-action-email" placeholder="Email address" />
                <a id="estimate-add-contact" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" hidden>+ Add a contact</a>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_EstimateForm" for="Input" />
        </form>
        </div>
        <partial name="_EstimateLineTemplate" />
        @if (Model.CanDelete)
        {
            <form method="post" asp-page-handler="Delete" class="mt-3"
                  onsubmit="return confirm('Delete this estimate permanently? This cannot be undone.');">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-outline-danger">Delete estimate</button>
            </form>
        }
    }

    @if (Model.Detail is not null)
    {
        @section Scripts {
            @if (!Model.IsReadOnly)
            {
                <partial name="_ValidationScriptsPartial" />
            }
            <partial name="Estimates/_EstimateCalcScript" />
        }
    }
}

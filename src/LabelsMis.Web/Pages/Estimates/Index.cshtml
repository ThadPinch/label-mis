@page "/estimates"
@model LabelsMis.Web.Pages.Estimates.IndexModel
@{
    ViewData["Title"] = "Estimates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Estimates</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-primary" asp-page="Create">New estimate</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input asp-for="Search" class="form-control" placeholder="Search number, customer, product" />
    </div>
    <div class="col-md-2">
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.EstimateStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="CustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["CustomerOptions"]!)">
            <option value="">All customers</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="SalesRepId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["SalesRepOptions"]!)">
            <option value="">All reps</option>
        </select>
    </div>
    <div class="col-md-1">
        <input asp-for="FromDate" class="form-control" type="date" />
    </div>
    <div class="col-md-1">
        <input asp-for="ToDate" class="form-control" type="date" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Number</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Status</th>
            <th>Total (max qty)</th>
            <th>Created</th>
            <th>Valid until</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr>
            <td>@item.EstimateNumber <span class="text-muted">Rev @item.RevisionNumber</span></td>
            <td>@item.CustomerName</td>
            <td>@item.SummaryDescription</td>
            <td>@item.Status</td>
            <td>@(item.HighestQtyTotal?.ToString("C2") ?? "—")</td>
            <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td>@(item.ValidUntilDate?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount))

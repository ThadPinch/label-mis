@page "/estimates/new"
@model LabelsMis.Web.Pages.Estimates.CreateModel
@{
    ViewData["Title"] = "New estimate";
    ViewData["IsReadOnly"] = false;
    ViewData["EstimateNumber"] = "Draft";
    ViewData["RevisionNumber"] = 1;

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New estimate</h1>
<div class="estimate-page">
<form method="post" id="estimate-form">
    <div class="estimate-action-bar">
        <button type="submit" asp-page-handler="SaveDraft" class="btn btn-primary">Save draft</button>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#emailModal">Save &amp; send to customer</button>
        <button type="submit" asp-page-handler="PreviewPdf" formtarget="_blank" formnovalidate class="btn btn-outline-secondary">Open PDF</button>
    </div>
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_EstimateForm" for="Input" />

    <div class="modal fade" id="emailModal" tabindex="-1" aria-labelledby="emailModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="emailModalLabel">Email estimate to customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Sending saves the estimate and marks it as sent. Clear the address to mark it sent without emailing.</p>
                    <div class="mb-3">
                        <label asp-for="EmailTo" class="form-label">To</label>
                        <input asp-for="EmailTo" type="email" class="form-control" placeholder="Email address" />
                        <select id="estimate-contact-select" class="form-select form-select-sm mt-2" aria-label="Use a customer contact" hidden></select>
                        <a id="estimate-add-contact" class="btn btn-sm btn-outline-primary mt-2" target="_blank" rel="noopener" hidden>+ Add a contact</a>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSubject" class="form-label">Subject</label>
                        <input asp-for="EmailSubject" class="form-control" placeholder="Defaults to the estimate number" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailBody" class="form-label">Message</label>
                        <textarea asp-for="EmailBody" class="form-control" rows="5" placeholder="Defaults to a standard message with the estimate number"></textarea>
                    </div>
                    <div class="form-check">
                        <input asp-for="IncludePdf" class="form-check-input" />
                        <label asp-for="IncludePdf" class="form-check-label">Include PDF as attachment</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" asp-page-handler="SaveAndSend" class="btn btn-success">Save &amp; send to customer</button>
                </div>
            </div>
        </div>
    </div>
</form>
</div>
<partial name="_EstimateLineTemplate" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="Estimates/_EstimateCalcScript" />
    <partial name="Shared/_CustomerNotesScript" model="@("/estimates/customer-notes")" />
}

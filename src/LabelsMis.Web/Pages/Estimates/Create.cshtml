@page "/estimates/new"
@model LabelsMis.Web.Pages.Estimates.CreateModel
@{
    ViewData["Title"] = "New estimate";
    ViewData["IsReadOnly"] = false;
    ViewData["EstimateNumber"] = "Draft";
    ViewData["RevisionNumber"] = 1;

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New estimate</h1>
<div class="estimate-page">
<form method="post" id="estimate-form">
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_EstimateForm" for="Input" />
    <div class="mt-3">
        <button type="submit" asp-page-handler="SaveDraft" class="btn btn-primary">Save draft</button>
    </div>
</form>
</div>
<partial name="_EstimateLineTemplate" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="Estimates/_EstimateCalcScript" />
}

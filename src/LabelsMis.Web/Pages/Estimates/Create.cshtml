@page "/estimates/new"
@model LabelsMis.Web.Pages.Estimates.CreateModel
@{
    ViewData["Title"] = "New estimate";
    ViewData["IsReadOnly"] = false;
    ViewData["EstimateNumber"] = "Draft";
    ViewData["RevisionNumber"] = 1;

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New estimate</h1>
<div class="estimate-page">
<form method="post" id="estimate-form">
    <div class="estimate-action-bar">
        <button type="submit" asp-page-handler="SaveDraft" class="btn btn-primary">Save draft</button>
        <button type="submit" asp-page-handler="SaveAndSend" class="btn btn-success">Save &amp; send to customer</button>
        <button type="submit" asp-page-handler="PreviewPdf" formtarget="_blank" formnovalidate class="btn btn-outline-secondary">Open PDF</button>
        <label class="form-check-label ms-2">
            <input asp-for="SendEmail" class="form-check-input" /> Email PDF
        </label>
        <input asp-for="EmailTo" type="email" class="form-control estimate-action-email" placeholder="Customer email address" />
        <a id="estimate-add-contact" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" hidden>+ Add a contact</a>
    </div>
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_EstimateForm" for="Input" />
</form>
</div>
<partial name="_EstimateLineTemplate" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="Estimates/_EstimateCalcScript" />
}

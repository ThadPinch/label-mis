<script>
(() => {
    const form = document.getElementById('estimate-form');
    const root = form || document.getElementById('estimate-readonly-root');
    const customerSelect = document.getElementById('customer-select');
    const productFilterSelect = document.getElementById('product-filter-customer');
    const linesContainer = document.getElementById('estimate-lines');
    const addLineBtn = document.getElementById('add-line');
    const lineTemplateEl = document.getElementById('estimate-line-template');
    const shippingMethodSelect = document.getElementById('shipping-method-select');
    const shippingCostInput = document.getElementById('shipping-cost-input');
    const shipToSource = document.getElementById('shipto-source');

    if (!root || !linesContainer) return;

    let debounceTimer = null;
    let productsCacheKey = null;
    let productsList = [];
    const lineMarkupCache = new Map();
    const lineResultsCache = new Map();
    const totalsPanel = document.getElementById('estimate-totals-panel');
    const breakdownPanel = document.getElementById('estimate-breakdown-panel');

    const markupToMargin = (markup) => markup / (1 + markup);
    const marginToMarkup = (margin) => margin / (1 - margin);
    const MARGIN_STEP = 0.01;
    const MIN_MARGIN = 0;
    const MAX_MARGIN = 0.85;

    const fmtMoney = (value, decimals = 2) => {
        const n = Number(value);
        if (Number.isNaN(n)) return '—';
        return `$${n.toFixed(decimals)}`;
    };

    const fmtPct = (value) => {
        const n = Number(value);
        if (Number.isNaN(n)) return '—';
        return `${(n * 100).toFixed(1)}%`;
    };

    const fmtQty = (value, decimals = 0) => {
        const n = Number(value);
        if (Number.isNaN(n)) return '—';
        return n.toLocaleString(undefined, {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals
        });
    };

    const escapeHtml = (text) => String(text ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    const renderCostLineRows = (items) => (items || []).map(item => {
        const qty = fmtQty(item.quantity, item.unit === 'MSI' || item.unit === 'minutes' ? 1 : 0);
        const unitCost = fmtMoney(item.unitCost, item.unitCost < 1 ? 4 : 2);
        return `<tr>
            <td>${escapeHtml(item.category)}</td>
            <td>${escapeHtml(item.description)}</td>
            <td class="text-end">${qty}</td>
            <td>${escapeHtml(item.unit)}</td>
            <td class="text-end">${unitCost}</td>
            <td class="text-end">${fmtMoney(item.lineCost)}</td>
        </tr>`;
    }).join('');

    const renderCostLineCards = (items) => (items || []).map(item => {
        const qty = fmtQty(item.quantity, item.unit === 'MSI' || item.unit === 'minutes' ? 1 : 0);
        const unitCost = fmtMoney(item.unitCost, item.unitCost < 1 ? 4 : 2);
        return `<div class="calc-cost-line">
            <div class="calc-cost-line-top">
                <span class="calc-cost-line-category">${escapeHtml(item.category)}</span>
                <span class="calc-cost-line-total">${fmtMoney(item.lineCost)}</span>
            </div>
            <div class="calc-cost-line-desc">${escapeHtml(item.description)}</div>
            <div class="calc-cost-line-meta">${qty} ${escapeHtml(item.unit)} × ${unitCost}</div>
        </div>`;
    }).join('');

    const renderCostBreakdown = (items, totalCost, compact) => {
        if (!items?.length) {
            return '<p class="text-muted small mb-0">No cost lines calculated.</p>';
        }
        if (compact) {
            return `<div class="calc-cost-lines">${renderCostLineCards(items)}</div>
                <div class="calc-cost-lines-total">
                    <span>Total cost</span>
                    <span>${fmtMoney(totalCost)}</span>
                </div>`;
        }
        const costRows = renderCostLineRows(items);
        return `<div class="calc-cost-table-wrap table-responsive">
            <table class="table table-sm table-bordered calc-cost-table mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-end">Qty</th>
                        <th>Unit</th>
                        <th class="text-end">Unit cost</th>
                        <th class="text-end">Line cost</th>
                    </tr>
                </thead>
                <tbody>${costRows}</tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="5">Total cost</td>
                        <td class="text-end">${fmtMoney(totalCost)}</td>
                    </tr>
                </tfoot>
            </table>
        </div>`;
    };

    const renderImpositionDiagram = (layout, imposition, idSuffix = '0') => {
        if (!layout || !imposition) return '';

        const marginPatternId = `impositionMarginHatch-${idSuffix}`;
        const trimPatternId = `impositionTrimHatch-${idSuffix}`;

        const pressWeb = Number(layout.pressWebWidthIn);
        const imageWidth = Number(layout.pressMaxImageWidthIn) || pressWeb;
        const frameRepeat = Number(layout.pressFrameRepeatIn) || Number(imposition.frameRepeatIn);
        const edgeMargin = Number(layout.pressEdgeMarginIn);
        const stockWidth = Number(layout.stockWidthIn);
        const labelAcross = Number(layout.labelAcrossIn);
        const labelAround = Number(layout.labelAroundIn);
        const gutterAcross = Number(layout.gutterAcrossIn);
        const gutterAround = Number(layout.gutterAroundIn);
        const labelsAcross = Number(imposition.labelsAcross);
        const labelsAround = Number(imposition.labelsAround);
        const framesPerImpression = Number(imposition.framesPerImpression) || 1;
        const repeatLength = Number(imposition.repeatLengthIn);
        const layoutRepeat = Number(imposition.layoutRepeatIn) || repeatLength;

        if ([pressWeb, stockWidth, labelAcross, labelAround, repeatLength].some(v => !v || Number.isNaN(v))) {
            return '';
        }

        const canvasWidth = Math.max(stockWidth, pressWeb);
        const canvasHeight = Math.max(repeatLength, frameRepeat || 0.5, 0.5);
        const pressOffsetX = Math.max(0, (stockWidth - pressWeb) / 2);
        const printableLeft = pressOffsetX + Math.max(0, (pressWeb - imageWidth) / 2);
        const printableRight = printableLeft + imageWidth;
        const printableWidth = imageWidth;
        const usedWidth = labelsAcross > 0
            ? (labelsAcross * labelAcross) + (Math.max(labelsAcross - 1, 0) * gutterAcross)
            : 0;
        const wasteSide = Math.max(0, (printableWidth - usedWidth) / 2);
        const labelsStartX = printableLeft + wasteSide;

        const frameAreaHeight = framesPerImpression === 1 && frameRepeat > 0
            ? frameRepeat
            : repeatLength;
        const labelsStartY = Math.max(0, (frameAreaHeight - layoutRepeat) / 2);

        // ViewBox padding (in inches) — leaves room for the bottom stock label,
        // the web-direction arrow on the right, and a touch of breathing room.
        const padL = 0.25;
        const padR = 0.85;
        const padT = 0.3;
        const padB = 0.75;

        const stockRect = `<rect x="0" y="0" width="${stockWidth}" height="${canvasHeight}" class="imposition-stock" fill="#e8e0d4" stroke="#a8a29e" stroke-width="0.04"/>`;
        const pressRect = `<rect x="${pressOffsetX}" y="0" width="${pressWeb}" height="${canvasHeight}" fill="#ffffff" stroke="#525252" stroke-width="0.06"/>`;
        const leftMargin = `<rect x="${pressOffsetX}" y="0" width="${edgeMargin}" height="${canvasHeight}" fill="url(#${marginPatternId})" stroke="none"/>`;
        const rightMargin = `<rect x="${pressOffsetX + pressWeb - edgeMargin}" y="0" width="${edgeMargin}" height="${canvasHeight}" fill="url(#${marginPatternId})" stroke="none"/>`;

        let stockTrim = '';
        if (stockWidth > pressWeb) {
            const trimLeft = pressOffsetX;
            const trimRight = stockWidth - pressOffsetX - pressWeb;
            if (trimLeft > 0.01) {
                stockTrim += `<rect x="0" y="0" width="${trimLeft}" height="${canvasHeight}" fill="url(#${trimPatternId})" stroke="none"/>`;
            }
            if (trimRight > 0.01) {
                stockTrim += `<rect x="${pressOffsetX + pressWeb}" y="0" width="${trimRight}" height="${canvasHeight}" fill="url(#${trimPatternId})" stroke="none"/>`;
            }
        }

        // Unused web — beside and above/below the centered label block.
        let webWaste = '';
        if (wasteSide > 0.05) {
            webWaste += `<rect x="${printableLeft}" y="0" width="${wasteSide}" height="${canvasHeight}" fill="#fef9c3" stroke="none"/>
                         <rect x="${labelsStartX + usedWidth}" y="0" width="${wasteSide}" height="${canvasHeight}" fill="#fef9c3" stroke="none"/>`;
        }
        const wasteTop = labelsStartY;
        const wasteBottom = Math.max(0, frameAreaHeight - labelsStartY - layoutRepeat);
        if (wasteTop > 0.05) {
            webWaste += `<rect x="${printableLeft}" y="0" width="${printableWidth}" height="${wasteTop}" fill="#fef9c3" stroke="none"/>`;
        }
        if (wasteBottom > 0.05) {
            webWaste += `<rect x="${printableLeft}" y="${labelsStartY + layoutRepeat}" width="${printableWidth}" height="${wasteBottom}" fill="#fef9c3" stroke="none"/>`;
        }

        const labelCornerRadius = Math.min(0.08, Math.min(labelAcross, labelAround) * 0.05);
        let frameGuides = '';
        if (frameRepeat > 0) {
            for (let f = 0; f < framesPerImpression; f++) {
                const y = f * frameRepeat;
                frameGuides += `<rect x="${printableLeft}" y="${y}" width="${printableWidth}" height="${frameRepeat}" fill="none" stroke="#2563eb" stroke-width="0.05" stroke-dasharray="0.12 0.08"/>`;
                if (framesPerImpression > 1) {
                    frameGuides += `<text x="${printableLeft + 0.08}" y="${y + 0.22}" font-size="0.22" fill="#1d4ed8" font-weight="600">Frame ${f + 1}</text>`;
                }
            }
        }

        let labels = '';
        for (let row = 0; row < labelsAround; row++) {
            for (let col = 0; col < labelsAcross; col++) {
                const x = labelsStartX + col * (labelAcross + gutterAcross);
                const y = labelsStartY + row * (labelAround + gutterAround);
                labels += `<rect x="${x}" y="${y}" width="${labelAcross}" height="${labelAround}" rx="${labelCornerRadius}" ry="${labelCornerRadius}" fill="rgba(0,93,102,0.35)" stroke="#00474e" stroke-width="0.04"/>`;
                if (labelsAcross * labelsAround <= 24) {
                    labels += `<text x="${x + labelAcross / 2}" y="${y + labelAround / 2}" text-anchor="middle" dominant-baseline="central" font-size="${Math.min(labelAcross, labelAround) * 0.24}" fill="#7c2d12" font-weight="700">${row * labelsAcross + col + 1}</text>`;
                }
            }
        }

        // Web-direction arrow — vertical line + arrowhead to the right of the stock.
        const arrowX = canvasWidth + 0.22;
        const arrowTop = canvasHeight * 0.15;
        const arrowBottom = canvasHeight * 0.85;
        const arrowHeadHalf = 0.08;
        const flowArrow = `
            <g class="imposition-flow">
                <line x1="${arrowX}" y1="${arrowTop}" x2="${arrowX}" y2="${arrowBottom - arrowHeadHalf}" stroke="#737373" stroke-width="0.04" stroke-linecap="round"/>
                <polygon points="${arrowX - arrowHeadHalf},${arrowBottom - arrowHeadHalf * 1.6} ${arrowX + arrowHeadHalf},${arrowBottom - arrowHeadHalf * 1.6} ${arrowX},${arrowBottom}" fill="#737373"/>
            </g>`;

        // Bottom stock-width caliper.
        const dimY = canvasHeight + 0.28;
        const dimText = `
            <g class="imposition-dim" stroke="#737373" stroke-width="0.025">
                <line x1="0" y1="${dimY}" x2="${stockWidth}" y2="${dimY}"/>
                <line x1="0" y1="${dimY - 0.08}" x2="0" y2="${dimY + 0.08}"/>
                <line x1="${stockWidth}" y1="${dimY - 0.08}" x2="${stockWidth}" y2="${dimY + 0.08}"/>
            </g>
            <text x="${stockWidth / 2}" y="${dimY + 0.38}" text-anchor="middle" font-size="0.28" fill="#525252" font-weight="500">${stockWidth.toFixed(2)}" stock</text>`;

        return `
            <div class="imposition-diagram">
                <div class="imposition-caption">One impression (${framesPerImpression} frame${framesPerImpression === 1 ? '' : 's'} × ${frameRepeat ? frameRepeat.toFixed(2) + '"' : 'repeat'}) — top view, arrow is web direction</div>
                <svg viewBox="${-padL} ${-padT} ${canvasWidth + padL + padR} ${canvasHeight + padT + padB}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Imposition diagram showing ${labelsAcross} labels across on ${stockWidth} inch stock">
                    <defs>
                        <pattern id="${marginPatternId}" width="0.15" height="0.15" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                            <rect width="0.15" height="0.15" fill="#fee2e2"/>
                            <line x1="0" y1="0" x2="0" y2="0.15" stroke="#fca5a5" stroke-width="0.04"/>
                        </pattern>
                        <pattern id="${trimPatternId}" width="0.2" height="0.2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                            <rect width="0.2" height="0.2" fill="#f5f5f4"/>
                            <line x1="0" y1="0" x2="0" y2="0.2" stroke="#d6d3d1" stroke-width="0.03"/>
                        </pattern>
                    </defs>
                    ${stockRect}
                    ${stockTrim}
                    ${pressRect}
                    ${leftMargin}
                    ${rightMargin}
                    ${webWaste}
                    ${frameGuides}
                    ${labels}
                    ${flowArrow}
                    ${dimText}
                </svg>
                <div class="imposition-legend">
                    <span><span class="legend-swatch legend-swatch--stock"></span>Stock</span>
                    <span><span class="legend-swatch legend-swatch--press"></span>Press web</span>
                    <span><span class="legend-swatch legend-swatch--margin"></span>Edge margin</span>
                    <span><span class="legend-swatch legend-swatch--label"></span>Label</span>
                    <span><span class="legend-swatch legend-swatch--waste"></span>Unused web</span>
                </div>
            </div>`;
    };

    const renderCalculationBreakdown = (lineEl, lineResult, targetEl) => {
        const container = targetEl || lineEl?.querySelector('.calc-breakdown');
        if (!container) return;

        const breaks = lineResult.quantityBreaks || [];
        const imposition = lineResult.imposition;
        const markupPct = Number(lineResult.markupPctUsed ?? 0);
        const hasErrors = (lineResult.errors || []).length > 0;
        const includeTitle = !targetEl;

        if (hasErrors || breaks.length === 0 || !imposition) {
            if (targetEl) return;
            container.classList.add('d-none');
            container.innerHTML = '';
            return;
        }

        const impositionHtml = `
            <section class="calc-imposition">
                <h4 class="calc-step-title">Step 1 — Imposition</h4>
                ${renderImpositionDiagram(lineResult.impositionLayout, imposition, lineEl.dataset.lineIndex ?? '0')}
                <dl class="calc-dl">
                    <dt>Labels across</dt>
                    <dd>${imposition.labelsAcross}</dd>
                    <dt>Labels around</dt>
                    <dd>${imposition.labelsAround}</dd>
                    <dt>Labels per impression</dt>
                    <dd>${imposition.labelsPerImpression}</dd>
                    <dt>Frames per impression</dt>
                    <dd>${imposition.framesPerImpression ?? 1} × ${fmtQty(imposition.frameRepeatIn ?? 0, 2)}" frame</dd>
                    <dt>Layout repeat</dt>
                    <dd>${fmtQty(imposition.layoutRepeatIn ?? imposition.repeatLengthIn, 4)}"</dd>
                    <dt>Billable repeat</dt>
                    <dd>${fmtQty(imposition.repeatLengthIn, 4)}"</dd>
                    <dt>Web utilization</dt>
                    <dd>${fmtPct(imposition.utilizationPct)}</dd>
                </dl>
            </section>`;

        const compactCost = !!targetEl;

        const qtySections = breaks.map(row => {
            const markupAmount = Number(row.totalPrice) - Number(row.totalCost);
            const costTable = renderCostBreakdown(row.costBreakdown, row.totalCost, compactCost);

            const marginClass = row.belowMinimumMargin ? ' calc-qty-stat--warn' : '';
            const marginSuffix = row.belowMinimumMargin ? ' ⚠' : '';

            return `
                <details class="calc-qty-section" data-qty="${row.quantity}">
                    <summary class="calc-qty-summary">
                        <span class="calc-qty-chevron" aria-hidden="true"></span>
                        <span class="calc-qty-label">
                            <span class="calc-qty-amount">${fmtQty(row.quantity)}</span>
                            <span class="calc-qty-unit">labels</span>
                        </span>
                        <span class="calc-qty-stats">
                            <span class="calc-qty-stat">
                                <span class="calc-qty-stat-label">Unit price</span>
                                <span class="calc-qty-stat-value">${fmtMoney(row.unitPrice, 4)}</span>
                            </span>
                            <span class="calc-qty-stat calc-qty-stat--total">
                                <span class="calc-qty-stat-label">Total</span>
                                <span class="calc-qty-stat-value">${fmtMoney(row.totalPrice)}</span>
                            </span>
                            <span class="calc-qty-stat${marginClass}">
                                <span class="calc-qty-stat-label">Margin</span>
                                <span class="calc-qty-stat-value">${fmtPct(row.marginPct)}${marginSuffix}</span>
                            </span>
                        </span>
                    </summary>
                    <div class="calc-qty-body">
                        <section class="calc-step">
                            <h5 class="calc-step-title">Step 2 — Production</h5>
                            <dl class="calc-dl">
                                <dt>Order quantity</dt>
                                <dd>${fmtQty(row.quantity)} labels</dd>
                                <dt>Impressions</dt>
                                <dd>${fmtQty(row.impressions)} <span class="calc-dl-note">(drum revolutions; includes waste)</span></dd>
                                <dt>Frame slots</dt>
                                <dd>${fmtQty(row.impressions * (imposition.framesPerImpression ?? 1))} <span class="calc-dl-note">(impressions × frames per impression)</span></dd>
                                <dt>Web length</dt>
                                <dd>${fmtQty(row.webLengthFt, 1)} ft</dd>
                                <dt>Press run time</dt>
                                <dd>${fmtQty(row.runTimeMinutes, 2)} min</dd>
                            </dl>
                        </section>
                        <section class="calc-step">
                            <h5 class="calc-step-title">Steps 3–5 — Cost components</h5>
                            ${costTable}
                        </section>
                        <section class="calc-step">
                            <h5 class="calc-step-title">Step 6 — Pricing</h5>
                            <dl class="calc-dl">
                                <dt>Total cost</dt>
                                <dd>${fmtMoney(row.totalCost)}</dd>
                                <dt>Markup (${fmtPct(row.markupPctUsed ?? markupPct)})</dt>
                                <dd>${fmtMoney(markupAmount)}</dd>
                                <dt>Total price</dt>
                                <dd class="fw-semibold">${fmtMoney(row.totalPrice)}</dd>
                                <dt>Unit price</dt>
                                <dd>${fmtMoney(row.unitPrice, 4)} / label</dd>
                                <dt>Price per thousand</dt>
                                <dd>${fmtMoney(row.pricePerThousand)} / M</dd>
                                <dt>Margin</dt>
                                <dd${row.belowMinimumMargin ? ' class="text-warning fw-semibold"' : ''}>
                                    ${fmtPct(row.marginPct)}${row.belowMinimumMargin ? ' (below minimum)' : ''}
                                </dd>
                            </dl>
                        </section>
                    </div>
                </details>`;
        }).join('');

        container.classList.remove('d-none', 'estimate-breakdown-panel--empty');
        const warningsHtml = (lineResult.warnings || []).length
            ? `<div class="alert alert-warning mb-3">${escapeHtml(lineResult.warnings.join('; '))}</div>`
            : '';
        // Remember which quantity sections are expanded so a recalculation doesn't collapse them.
        const openQtys = new Set(
            [...container.querySelectorAll('.calc-qty-section[open]')].map(d => d.dataset.qty));
        container.innerHTML = `
            <div class="calc-breakdown-card">
                ${includeTitle ? '<h3 class="calc-breakdown-title">Calculation breakdown</h3>' : ''}
                ${warningsHtml}
                ${impositionHtml}
                <div class="calc-qty-list">
                    ${qtySections}
                </div>
            </div>`;
        container.querySelectorAll('.calc-qty-section').forEach(d => {
            if (openQtys.has(d.dataset.qty)) d.open = true;
        });
    };

    const updateLineSummary = (lineEl, lineResult) => {
        const descEl = lineEl.querySelector('.line-desc');
        const previewEl = lineEl.querySelector('.line-price-preview');
        const descInput = lineEl.querySelector('[name$=".ProductDescription"]');
        if (descEl) {
            descEl.textContent = (descInput?.value || '').trim() || 'Untitled line';
        }
        if (!previewEl) return;
        const breaks = lineResult?.quantityBreaks || [];
        if (breaks.length === 0) {
            previewEl.textContent = '—';
            return;
        }
        const top = breaks[breaks.length - 1];
        previewEl.textContent = fmtMoney(top.totalPrice);
    };

    const updateEstimateTotals = () => {
        if (!totalsPanel) return;

        const lineEls = [...linesContainer.querySelectorAll('.estimate-line')];
        if (lineEls.length === 0) {
            totalsPanel.innerHTML = '<p class="text-muted small mb-0">Add a line to begin.</p>';
            return;
        }

        const blocks = lineEls.map((lineEl) => {
            const idx = Number(lineEl.dataset.lineIndex);
            const result = lineResultsCache.get(String(idx));
            const breaks = result?.quantityBreaks || [];
            const lineNum = idx + 1;
            const desc = lineEl.querySelector('input[name$=".ProductDescription"]')?.value?.trim();
            const title = desc ? `Line ${lineNum}: ${escapeHtml(desc)}` : `Line ${lineNum}`;

            if (breaks.length === 0) {
                return `<div class="estimate-total-line mb-3">
                    <div class="estimate-total-line-title fw-semibold">${title}</div>
                    <p class="text-muted small mb-0">No pricing yet.</p>
                </div>`;
            }

            const rows = breaks.map(b => `<tr>
                <td>${fmtQty(b.quantity)}</td>
                <td class="text-end">${fmtMoney(b.unitPrice, 4)}</td>
                <td class="text-end">${fmtMoney(b.totalPrice)}</td>
            </tr>`).join('');

            return `<div class="estimate-total-line mb-3">
                <div class="estimate-total-line-title fw-semibold">${title}</div>
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Qty</th><th class="text-end">Unit</th><th class="text-end">Total</th></tr></thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
        }).join('');

        const shipping = getShippingCost();
        let shippingBlock = '';
        if (shipping > 0) {
            const label = getShippingLabel();
            shippingBlock = `<div class="estimate-total-line d-flex justify-content-between">
                <span class="fw-semibold">Shipping${label ? ` (${escapeHtml(label)})` : ''}</span>
                <span>${fmtMoney(shipping)}</span>
            </div>`;
        }

        totalsPanel.innerHTML = blocks + shippingBlock;
    };

    const getShippingCost = () => {
        const value = Number(shippingCostInput?.value);
        return Number.isFinite(value) && value > 0 ? value : 0;
    };

    const getShippingLabel = () => {
        const opt = shippingMethodSelect?.selectedOptions?.[0];
        if (!opt || !shippingMethodSelect.value) return '';
        return (opt.textContent || '').split('—')[0].trim();
    };

    const updateShippingAddressVisibility = () => {
        if (!shippingMethodSelect) return;
        const opt = shippingMethodSelect.selectedOptions?.[0];
        const requires = opt ? opt.dataset.requiresAddress !== 'false' : true;
        root.querySelectorAll('.shipto-group').forEach(el => el.classList.toggle('d-none', !requires));
    };

    const refreshBreakdownPanel = () => {
        if (!breakdownPanel) return;

        const openLine = linesContainer.querySelector('.estimate-line-details[open]')?.closest('.estimate-line');
        if (!openLine) {
            breakdownPanel.className = 'estimate-breakdown-panel estimate-breakdown-panel--empty';
            breakdownPanel.innerHTML = '<p class="text-muted small mb-0">Expand a line to view its calculation breakdown.</p>';
            return;
        }

        const result = lineResultsCache.get(String(openLine.dataset.lineIndex));
        breakdownPanel.className = 'estimate-breakdown-panel';

        if (!result) {
            breakdownPanel.innerHTML = '<p class="text-muted small mb-0">Calculating…</p>';
            return;
        }

        if (result.errors?.length) {
            breakdownPanel.innerHTML = `<div class="alert alert-danger mb-0">${escapeHtml(result.errors.join('; '))}</div>`;
            return;
        }

        renderCalculationBreakdown(openLine, result, breakdownPanel);
    };

    const wireLineAccordion = (lineEl) => {
        const details = lineEl.querySelector('.estimate-line-details');
        if (!details || details.dataset.accordionWired === 'true') return;
        details.dataset.accordionWired = 'true';
        details.addEventListener('toggle', () => {
            if (details.open) {
                linesContainer.querySelectorAll('.estimate-line-details[open]').forEach(other => {
                    if (other !== details) other.open = false;
                });
            }
            refreshBreakdownPanel();
        });
    };

    // Per-quantity markup overrides live in a hidden JSON field ({"1000":0.5}) so they
    // round-trip through both the calculate endpoint and the form post.
    const getQtyMarkupMap = (lineEl) => {
        const raw = lineEl.querySelector('.qty-markup-json')?.value;
        if (!raw) return {};
        try { return JSON.parse(raw) || {}; } catch { return {}; }
    };

    const setQtyMarkupMap = (lineEl, map) => {
        const input = lineEl.querySelector('.qty-markup-json');
        if (!input) return;
        input.value = Object.keys(map).length ? JSON.stringify(map) : '';
    };

    const getEffectiveQtyMarkup = (lineEl, qty) => {
        const value = getQtyMarkupMap(lineEl)[String(qty)];
        return value !== undefined && value !== null && !Number.isNaN(Number(value))
            ? Number(value)
            : getLineMarkup(lineEl);
    };

    const setQtyMargin = (lineEl, qty, margin) => {
        const clamped = Math.min(Math.max(margin, MIN_MARGIN), MAX_MARGIN);
        const map = getQtyMarkupMap(lineEl);
        map[String(qty)] = Number(marginToMarkup(clamped).toFixed(4));
        setQtyMarkupMap(lineEl, map);
        calculate();
    };

    const getLineMarkup = (lineEl) => {
        const input = lineEl.querySelector('.markup-override-input');
        const raw = input?.value?.trim();
        if (raw !== '' && raw !== undefined) {
            const parsed = parseFloat(raw);
            if (!Number.isNaN(parsed)) return parsed;
        }
        const idx = lineEl.dataset.lineIndex;
        if (lineMarkupCache.has(idx)) return lineMarkupCache.get(idx);
        return 0;
    };

    const setLineMarkup = (lineEl, markup) => {
        const clampedMargin = Math.min(Math.max(markupToMargin(markup), MIN_MARGIN), MAX_MARGIN);
        const clampedMarkup = marginToMarkup(clampedMargin);
        const input = lineEl.querySelector('.markup-override-input');
        if (input) input.value = clampedMarkup.toFixed(4);
        updateMarginDisplay(lineEl, clampedMarkup);
        return clampedMarkup;
    };

    const updateMarginDisplay = (lineEl, markup) => {
        const input = lineEl.querySelector('.margin-input');
        if (!input) return;
        if (markup === null || markup === undefined || Number.isNaN(markup)) {
            input.value = '';
            return;
        }
        input.value = `${(markupToMargin(markup) * 100).toFixed(1)}%`;
    };

    const parseMarginInput = (raw) => {
        if (raw === '' || raw === undefined || raw === null) return null;
        const trimmed = String(raw).trim();
        if (!trimmed) return null;
        const hasPercent = trimmed.endsWith('%');
        const parsed = parseFloat(trimmed.replace(/%$/, ''));
        if (Number.isNaN(parsed)) return null;
        const asDecimal = hasPercent || parsed > 1 ? parsed / 100 : parsed;
        return Math.min(Math.max(asDecimal, MIN_MARGIN), MAX_MARGIN);
    };

    const applyMarginInput = (lineEl) => {
        const marginInput = lineEl.querySelector('.margin-input');
        if (!marginInput) return;
        const margin = parseMarginInput(marginInput.value);
        if (margin === null) {
            const idx = lineEl.dataset.lineIndex;
            const cached = lineMarkupCache.get(idx);
            if (cached !== undefined) {
                updateMarginDisplay(lineEl, cached);
            } else {
                marginInput.value = '';
            }
            return;
        }
        setLineMarkup(lineEl, marginToMarkup(margin));
        // The line control sets every quantity: drop per-quantity overrides.
        setQtyMarkupMap(lineEl, {});
        calculate();
    };

    const adjustLineMargin = (lineEl, delta) => {
        const currentMarkup = getLineMarkup(lineEl);
        const currentMargin = markupToMargin(currentMarkup);
        const newMargin = Math.min(Math.max(currentMargin + delta, MIN_MARGIN), MAX_MARGIN);
        setLineMarkup(lineEl, marginToMarkup(newMargin));
        setQtyMarkupMap(lineEl, {});
        calculate();
    };

    const reindexLines = () => {
        const lines = linesContainer.querySelectorAll('.estimate-line');
        const newCache = new Map();
        const newResultsCache = new Map();
        lines.forEach((line, idx) => {
            const oldIdx = line.dataset.lineIndex;
            if (lineMarkupCache.has(oldIdx)) {
                newCache.set(String(idx), lineMarkupCache.get(oldIdx));
            }
            if (lineResultsCache.has(oldIdx)) {
                newResultsCache.set(String(idx), lineResultsCache.get(oldIdx));
            }
            line.dataset.lineIndex = idx;
            const title = line.querySelector('.line-title');
            if (title) title.textContent = `Line ${idx + 1}`;
            line.querySelectorAll('[name^="Input.Lines["]').forEach(el => {
                el.name = el.name.replace(/Input\.Lines\[\d+\]/, `Input.Lines[${idx}]`);
            });
        });
        lineMarkupCache.clear();
        newCache.forEach((v, k) => lineMarkupCache.set(k, v));
        lineResultsCache.clear();
        newResultsCache.forEach((v, k) => lineResultsCache.set(k, v));
        updateEstimateTotals();
        refreshBreakdownPanel();
    };

    const getProductFilterKey = () => {
        if (!productFilterSelect) return 'all';
        const value = productFilterSelect.value;
        return value || 'all';
    };

    const buildProductsUrl = () => {
        const key = getProductFilterKey();
        if (key === 'all') return '/estimates/products';
        if (key === 'house') return '/estimates/products?house=true';
        return `/estimates/products?customerId=${encodeURIComponent(key)}`;
    };

    const loadProducts = async () => {
        const cacheKey = getProductFilterKey();
        if (productsCacheKey === cacheKey) {
            populateProductSelects();
            return;
        }

        const response = await fetch(buildProductsUrl());
        if (!response.ok) return;

        productsList = await response.json();
        productsCacheKey = cacheKey;
        populateProductSelects();
    };

    const populateProductSelects = () => {
        linesContainer.querySelectorAll('.source-product').forEach(sel => {
            const currentVal = sel.value;
            sel.innerHTML = '<option value="">(none — describe below)</option>';
            productsList.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = `${p.internalSku} — ${p.description}`;
                if (p.id === currentVal) opt.selected = true;
                sel.appendChild(opt);
            });
        });
    };

    const syncProductFilterToEstimateCustomer = () => {
        if (!productFilterSelect || !customerSelect?.value) return;
        const matchingOption = [...productFilterSelect.options].some(o => o.value === customerSelect.value);
        if (matchingOption) {
            productFilterSelect.value = customerSelect.value;
            productsCacheKey = null;
        }
    };

    let FINISHING_OPS = [];
    try {
        const finishingDataEl = document.getElementById('finishing-ops-data');
        if (finishingDataEl) FINISHING_OPS = JSON.parse(finishingDataEl.textContent || '[]');
    } catch { FINISHING_OPS = []; }

    let SPOT_INKS = [];
    try {
        const spotDataEl = document.getElementById('spot-inks-data');
        if (spotDataEl) SPOT_INKS = JSON.parse(spotDataEl.textContent || '[]');
    } catch { SPOT_INKS = []; }
    const spotInkById = new Map(SPOT_INKS.map(s => [String(s.id), s]));

    const WHITE_INK_SETS = new Set([3, 4]);
    const SPOT_INK_SETS = new Set([2, 4]);

    const toggleInkGroups = (lineEl) => {
        const inkSetSel = lineEl.querySelector('[name$=".InkSet"]');
        const inkSet = parseInt(inkSetSel?.value, 10);
        const whiteGroup = lineEl.querySelector('.white-ink-group');
        const spotGroup = lineEl.querySelector('.spot-ink-group');
        if (whiteGroup) whiteGroup.classList.toggle('d-none', !WHITE_INK_SETS.has(inkSet));
        if (spotGroup) spotGroup.classList.toggle('d-none', !SPOT_INK_SETS.has(inkSet));
    };

    const renumberSpots = (lineEl) => {
        const lineIdx = lineEl.dataset.lineIndex;
        lineEl.querySelectorAll('.spot-selected .spot-item').forEach((item, j) => {
            item.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/Input\.Lines\[\d+\]\.Spots\[\d+\]/, `Input.Lines[${lineIdx}].Spots[${j}]`);
            });
            const sort = item.querySelector('.spot-sort');
            if (sort) sort.value = String(j);
        });
    };

    const wireSpotRemove = (btn) => {
        if (!btn) return;
        btn.addEventListener('click', () => {
            const lineEl = btn.closest('.estimate-line');
            btn.closest('.spot-item')?.remove();
            if (lineEl) renumberSpots(lineEl);
            calculate();
        });
    };

    const buildSpotItem = (lineEl, ink) => {
        const lineIdx = lineEl.dataset.lineIndex;
        const item = document.createElement('div');
        item.className = 'spot-item border rounded p-2 mb-2';
        item.dataset.inkId = ink.id;
        item.innerHTML = `
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1">
                    <div class="fw-semibold spot-name">${escapeHtml(ink.code)} &mdash; ${escapeHtml(ink.description)}</div>
                    <input type="hidden" name="Input.Lines[${lineIdx}].Spots[0].InkId" value="${escapeHtml(ink.id)}" class="spot-ink-id" />
                    <input type="hidden" name="Input.Lines[${lineIdx}].Spots[0].SortOrder" value="0" class="spot-sort" />
                </div>
                <div>
                    <label class="form-label small mb-0">Hits</label>
                    <select name="Input.Lines[${lineIdx}].Spots[0].Hits" class="form-select form-select-sm calc-immediate spot-hits" style="max-width: 7rem;">
                        <option value="1" selected>1 hit</option>
                        <option value="2">2 hits</option>
                        <option value="3">3 hits</option>
                    </select>
                </div>
                <div class="spot-coverage-group">
                    <label class="form-label small mb-0">Coverage <span class="coverage-readout">100%</span></label>
                    <input type="range" min="0" max="100" step="1" name="Input.Lines[${lineIdx}].Spots[0].CoveragePct" value="100" class="form-range calc-immediate coverage-slider" />
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger spot-remove">Remove</button>
            </div>`;
        return item;
    };

    const wireSpotRow = (item) => {
        wireSpotRemove(item.querySelector('.spot-remove'));
        item.querySelectorAll('.calc-immediate').forEach(el => el.addEventListener('change', calculate));
        const slider = item.querySelector('.coverage-slider');
        const readout = item.querySelector('.coverage-readout');
        if (slider && readout) {
            slider.addEventListener('input', () => { readout.textContent = `${slider.value}%`; });
        }
    };

    const addSpotToLine = (lineEl, ink) => {
        const list = lineEl?.querySelector('.spot-selected');
        if (!list || !ink) return false;
        const item = buildSpotItem(lineEl, ink);
        list.appendChild(item);
        renumberSpots(lineEl);
        wireSpotRow(item);
        return true;
    };
    const finishingById = new Map(FINISHING_OPS.map(o => [String(o.id), o]));

    let FINISHING_STOCKS = [];
    try {
        const finishingStocksEl = document.getElementById('finishing-stocks-data');
        if (finishingStocksEl) FINISHING_STOCKS = JSON.parse(finishingStocksEl.textContent || '[]');
    } catch { FINISHING_STOCKS = []; }

    // Only these finishing categories consume a material stock.
    const MATERIAL_FINISHING_CATEGORIES = new Set(['Laminate', 'Foil']);

    const buildFinishingStockOptions = (selectedId) => ['<option value="">Select stock</option>']
        .concat(FINISHING_STOCKS.map(s =>
            `<option value="${escapeHtml(s.id)}"${String(s.id) === String(selectedId || '') ? ' selected' : ''}>${escapeHtml(s.code)} — ${escapeHtml(s.description)}</option>`))
        .join('');

    const populateFinishingOperations = (categorySel) => {
        const builder = categorySel.closest('.finishing-builder');
        if (!builder) return;
        const opSel = builder.querySelector('.finishing-operation-select');
        const addBtn = builder.querySelector('.finishing-add');
        const category = categorySel.value;
        opSel.innerHTML = '<option value="">Select operation</option>';
        FINISHING_OPS.filter(o => o.category === category).forEach(o => {
            const opt = document.createElement('option');
            opt.value = o.id;
            opt.textContent = `${o.code} — ${o.description}`;
            opSel.appendChild(opt);
        });
        opSel.disabled = !category;
        if (addBtn) addBtn.disabled = true;
    };

    const renumberFinishing = (lineEl) => {
        const lineIdx = lineEl.dataset.lineIndex;
        lineEl.querySelectorAll('.finishing-selected .finishing-item').forEach((item, j) => {
            item.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/Input\.Lines\[\d+\]\.FinishingOperations\[\d+\]/, `Input.Lines[${lineIdx}].FinishingOperations[${j}]`);
            });
            const sort = item.querySelector('.finishing-sort');
            if (sort) sort.value = String(j);
        });
    };

    const wireFinishingRemove = (btn) => {
        if (!btn) return;
        btn.addEventListener('click', () => {
            const lineEl = btn.closest('.estimate-line');
            btn.closest('.finishing-item')?.remove();
            if (lineEl) renumberFinishing(lineEl);
            calculate();
        });
    };

    const buildFinishingItem = (lineEl, op, setupOverride, runOverride, stockId) => {
        const lineIdx = lineEl.dataset.lineIndex;
        const item = document.createElement('div');
        item.className = 'finishing-item border rounded p-2 mb-2';
        item.dataset.opId = op.id;
        const stockBlock = MATERIAL_FINISHING_CATEGORIES.has(op.category)
            ? `<div class="finishing-stock-group">
                    <label class="form-label small mb-0">Material stock</label>
                    <select name="Input.Lines[${lineIdx}].FinishingOperations[0].StockId" class="form-select form-select-sm finishing-stock-select" style="max-width: 14rem;">${buildFinishingStockOptions(stockId)}</select>
                </div>`
            : '';
        item.innerHTML = `
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1">
                    <div class="fw-semibold">${escapeHtml(op.code)} — ${escapeHtml(op.description)}</div>
                    <span class="text-muted small">${escapeHtml(op.category)}</span>
                    <input type="hidden" name="Input.Lines[${lineIdx}].FinishingOperations[0].OperationId" value="${escapeHtml(op.id)}" class="finishing-op-id" />
                    <input type="hidden" name="Input.Lines[${lineIdx}].FinishingOperations[0].SortOrder" value="0" class="finishing-sort" />
                </div>
                <div>
                    <label class="form-label small mb-0">Setup min override</label>
                    <input name="Input.Lines[${lineIdx}].FinishingOperations[0].SetupMinutesOverride" value="${escapeHtml(setupOverride || '')}" class="form-control form-control-sm calc-trigger" style="max-width: 8rem;" />
                </div>
                <div>
                    <label class="form-label small mb-0">Run speed fpm override</label>
                    <input name="Input.Lines[${lineIdx}].FinishingOperations[0].RunSpeedFpmOverride" value="${escapeHtml(runOverride || '')}" class="form-control form-control-sm calc-trigger" style="max-width: 8rem;" />
                </div>
                ${stockBlock}
                <button type="button" class="btn btn-sm btn-outline-danger finishing-remove">Remove</button>
            </div>`;
        return item;
    };

    const addFinishingToLine = (lineEl, op, setupOverride, runOverride, stockId) => {
        const list = lineEl?.querySelector('.finishing-selected');
        if (!list || !op) return false;
        if (list.querySelector(`.finishing-item[data-op-id="${op.id}"]`)) return false;
        const item = buildFinishingItem(lineEl, op, setupOverride, runOverride, stockId);
        list.appendChild(item);
        renumberFinishing(lineEl);
        wireFinishingRemove(item.querySelector('.finishing-remove'));
        item.querySelectorAll('.calc-trigger').forEach(el => {
            el.addEventListener('input', scheduleCalculate);
            el.addEventListener('blur', calculate);
        });
        item.querySelector('.finishing-stock-select')?.addEventListener('change', calculate);
        return true;
    };

    const applyProductToLine = (lineEl, product) => {
        const set = (selector, value) => {
            const el = lineEl.querySelector(selector);
            if (el) {
                if (el.type === 'checkbox') el.checked = !!value;
                else el.value = value ?? '';
            }
        };
        set('[name$=".ProductDescription"]', product.description);
        set('[name$=".LabelAcrossIn"]', product.labelAcrossIn);
        set('[name$=".LabelAroundIn"]', product.labelAroundIn);
        set('[name$=".CornerRadiusIn"]', product.cornerRadiusIn);
        const substrateSel = lineEl.querySelector('.substrate-select');
        if (substrateSel) substrateSel.value = product.substrateId;
        const inkSetSel = lineEl.querySelector('[name$=".InkSet"]');
        if (inkSetSel) inkSetSel.value = product.inkSet;
        toggleInkGroups(lineEl);
        const acrossSel = lineEl.querySelector('.labels-across-select');
        if (acrossSel) acrossSel.value = '';
        const orientationSel = lineEl.querySelector('.orientation-select');
        if (orientationSel) orientationSel.value = '';

        try {
            const finishing = JSON.parse(product.finishingOperationsJson || '[]');
            const list = lineEl.querySelector('.finishing-selected');
            if (list) {
                list.innerHTML = '';
                finishing.forEach(f => {
                    const opId = String(f.OperationId || f.operationId || '');
                    const op = finishingById.get(opId);
                    if (!op) return;
                    const setup = f.SetupMinutesOverride ?? f.setupMinutesOverride;
                    const run = f.RunSpeedFpmOverride ?? f.runSpeedFpmOverride;
                    const stock = f.StockId ?? f.stockId;
                    addFinishingToLine(lineEl, op, setup == null ? '' : String(setup), run == null ? '' : String(run), stock == null ? '' : String(stock));
                });
            }
        } catch { /* ignore */ }
    };

    const readQuantities = (lineEl) => [...lineEl.querySelectorAll('.quantity-input')]
        .map(i => parseInt(i.value, 10))
        .filter(q => !Number.isNaN(q) && q > 0)
        .sort((a, b) => a - b)
        .slice(0, 6);

    const normalizeQuantityInputs = (lineEl) => {
        const inputs = [...lineEl.querySelectorAll('.quantity-input')];
        const values = readQuantities(lineEl);
        inputs.forEach((input, idx) => {
            input.value = values[idx] !== undefined ? String(values[idx]) : '';
        });
        return values;
    };

    // Reordering the quantity slots right after an edit yanks values out from under the
    // user, so it runs on a visible 3-second countdown instead.
    const reorderTimers = new Map();

    const quantitiesNeedReorder = (lineEl) => {
        const inputs = [...lineEl.querySelectorAll('.quantity-input')];
        const target = readQuantities(lineEl);
        return inputs.some((input, idx) => {
            const want = target[idx] !== undefined ? String(target[idx]) : '';
            return input.value.trim() !== want;
        });
    };

    const cancelQuantityReorder = (lineEl) => {
        const timer = reorderTimers.get(lineEl);
        if (!timer) return;
        clearInterval(timer.interval);
        timer.el.remove();
        reorderTimers.delete(lineEl);
    };

    const scheduleQuantityReorder = (lineEl) => {
        if (!lineEl) return;
        cancelQuantityReorder(lineEl);
        if (!quantitiesNeedReorder(lineEl)) return;

        const section = lineEl.querySelector('.quantity-inputs');
        if (!section) return;
        const el = document.createElement('div');
        el.className = 'quantity-reorder-timer form-text text-warning mt-1';
        section.insertAdjacentElement('afterend', el);

        let remaining = 3;
        el.textContent = `Reordering quantities in ${remaining}…`;
        const interval = setInterval(() => {
            // Hold the countdown while a quantity field in this line is still focused.
            const active = document.activeElement;
            if (active?.classList?.contains('quantity-input') && lineEl.contains(active)) {
                return;
            }
            remaining -= 1;
            if (remaining > 0) {
                el.textContent = `Reordering quantities in ${remaining}…`;
                return;
            }
            cancelQuantityReorder(lineEl);
            normalizeQuantityInputs(lineEl);
            calculate();
        }, 1000);
        reorderTimers.set(lineEl, { interval, el });
    };

    const collectLinePayload = (lineEl) => {
        const get = (selector) => lineEl.querySelector(selector);
        const val = (selector) => get(selector)?.value;
        const num = (selector) => {
            const v = val(selector);
            return v === '' || v === undefined ? 0 : parseFloat(v);
        };
        const int = (selector) => {
            const v = val(selector);
            return v === '' || v === undefined ? 0 : parseInt(v, 10);
        };
        const finishing = [];
        let sort = 0;
        const finishingItems = lineEl.querySelectorAll('.finishing-selected .finishing-item');
        if (finishingItems.length > 0) {
            finishingItems.forEach(item => {
                const opId = item.querySelector('.finishing-op-id')?.value;
                if (!opId) return;
                finishing.push({
                    operationId: opId,
                    setupMinutesOverride: item.querySelector('[name*="SetupMinutesOverride"]')?.value || null,
                    runSpeedFpmOverride: item.querySelector('[name*="RunSpeedFpmOverride"]')?.value || null,
                    stockId: item.querySelector('.finishing-stock-select')?.value || null,
                    sortOrder: sort++
                });
            });
        } else {
            // Read-only view posts finishing operations as plain hidden inputs.
            lineEl.querySelectorAll('[name*="FinishingOperations"][name*="OperationId"]').forEach(input => {
                if (input.disabled || !input.value) return;
                const prefix = input.name.replace(/\.OperationId$/, '');
                finishing.push({
                    operationId: input.value,
                    setupMinutesOverride: lineEl.querySelector(`[name="${prefix}.SetupMinutesOverride"]`)?.value || null,
                    runSpeedFpmOverride: lineEl.querySelector(`[name="${prefix}.RunSpeedFpmOverride"]`)?.value || null,
                    stockId: lineEl.querySelector(`[name="${prefix}.StockId"]`)?.value || null,
                    sortOrder: sort++
                });
            });
        }
        finishing.forEach(op => {
            if (typeof op.setupMinutesOverride === 'string' && op.setupMinutesOverride.trim() === '') {
                op.setupMinutesOverride = null;
            }
            if (typeof op.runSpeedFpmOverride === 'string' && op.runSpeedFpmOverride.trim() === '') {
                op.runSpeedFpmOverride = null;
            }
        });
        const spots = [];
        let spotSort = 0;
        lineEl.querySelectorAll('.spot-selected .spot-item').forEach(item => {
            const inkId = item.querySelector('.spot-ink-id')?.value;
            if (!inkId) return;
            const hitsEl = item.querySelector('.spot-hits');
            const coverageEl = item.querySelector('[name*="CoveragePct"]');
            spots.push({
                inkId,
                hits: hitsEl ? (parseInt(hitsEl.value, 10) || 0) : 0,
                coveragePct: coverageEl ? (parseFloat(coverageEl.value) || 0) : 0,
                sortOrder: spotSort++
            });
        });
        const quantities = readQuantities(lineEl);

        return {
            id: val('[name$=".Id"]') || null,
            sourceProductId: val('[name$=".SourceProductId"]') || null,
            productDescription: val('[name$=".ProductDescription"]') || '',
            labelAcrossIn: num('[name$=".LabelAcrossIn"]'),
            labelAroundIn: num('[name$=".LabelAroundIn"]'),
            cornerRadiusIn: num('[name$=".CornerRadiusIn"]'),
            gutterAcrossIn: num('[name$=".GutterAcrossIn"]'),
            gutterAroundIn: num('[name$=".GutterAroundIn"]'),
            bleedIn: num('[name$=".BleedIn"]'),
            substrateId: val('.substrate-select') || null,
            inkSet: int('[name$=".InkSet"]'),
            whiteHits: int('[name$=".WhiteHits"]'),
            whiteCoveragePct: num('[name$=".WhiteCoveragePct"]'),
            spots,
            setupWasteImpressions: num('[name$=".SetupWasteImpressions"]'),
            runningWastePct: num('[name$=".RunningWastePct"]'),
            lineNotes: val('[name$=".LineNotes"]') || null,
            markupPctOverride: (() => {
                const raw = val('.markup-override-input');
                if (raw === '' || raw === undefined || raw === null) return null;
                const parsed = parseFloat(raw);
                return Number.isNaN(parsed) ? null : parsed;
            })(),
            quantityMarkupOverridesJson: val('.qty-markup-json') || null,
            maxLabelsAcrossOverride: (() => {
                const raw = val('.labels-across-select');
                if (raw === '' || raw === undefined || raw === null) return null;
                const parsed = parseInt(raw, 10);
                return Number.isNaN(parsed) ? null : parsed;
            })(),
            labelOrientationOverride: (() => {
                const raw = val('.orientation-select');
                if (raw === '' || raw === undefined || raw === null) return null;
                const parsed = parseInt(raw, 10);
                return Number.isNaN(parsed) ? null : parsed;
            })(),
            finishingOperations: finishing,
            quantities
        };
    };

    const collectPayload = () => {
        const customerId = customerSelect?.value
            || root.querySelector('[name="Input.CustomerId"]')?.value;
        const lines = [...linesContainer.querySelectorAll('.estimate-line')].map(collectLinePayload);
        return {
            customerId,
            salesRepId: root.querySelector('[name="Input.SalesRepId"]')?.value || null,
            notes: root.querySelector('[name="Input.Notes"]')?.value || null,
            validUntilDate: root.querySelector('[name="Input.ValidUntilDate"]')?.value || null,
            lines
        };
    };

    const syncImpositionControls = (lineEl, imposition) => {
        const acrossSel = lineEl.querySelector('.labels-across-select');
        const maxLabel = lineEl.querySelector('.labels-across-max');
        if (acrossSel) {
            const max = Number(imposition?.maxLabelsAcross ?? 0);
            const current = acrossSel.value;
            if (max >= 1) {
                const options = ['<option value="">Auto</option>'];
                for (let n = 1; n <= max; n++) {
                    const sel = current === String(n) ? ' selected' : '';
                    options.push(`<option value="${n}"${sel}>${n} up</option>`);
                }
                acrossSel.innerHTML = options.join('');
                if (current && parseInt(current, 10) > max) {
                    acrossSel.value = '';
                }
                if (maxLabel) maxLabel.textContent = `(max ${max})`;
            } else if (maxLabel) {
                maxLabel.textContent = '(auto)';
            }
        }

        const orientationSel = lineEl.querySelector('.orientation-select');
        const orientationLabel = orientationSel?.previousElementSibling;
        if (orientationLabel) {
            const baseText = 'Orientation';
            const chosen = Number(imposition?.orientation ?? 0);
            const isAuto = orientationSel.value === '' || orientationSel.value === undefined;
            if (isAuto && chosen === 1) {
                orientationLabel.innerHTML = `${baseText} <span class="form-text d-inline">(auto: rotated)</span>`;
            } else if (isAuto) {
                orientationLabel.innerHTML = `${baseText} <span class="form-text d-inline">(auto: as entered)</span>`;
            } else {
                orientationLabel.textContent = baseText;
            }
        }
    };

    const wireRowMarginControls = (lineEl, tbody) => {
        tbody.querySelectorAll('.row-margin-control').forEach(ctrl => {
            const qty = parseInt(ctrl.dataset.qty, 10);
            const input = ctrl.querySelector('.row-margin-input');
            const currentMargin = () => markupToMargin(getEffectiveQtyMarkup(lineEl, qty));
            const apply = () => {
                const margin = parseMarginInput(input.value);
                if (margin === null) {
                    input.value = `${(currentMargin() * 100).toFixed(1)}%`;
                    return;
                }
                setQtyMargin(lineEl, qty, margin);
            };
            input?.addEventListener('blur', apply);
            input?.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    apply();
                    input.blur();
                }
            });
            ctrl.querySelector('.row-margin-decrease')?.addEventListener('click', () =>
                setQtyMargin(lineEl, qty, currentMargin() - MARGIN_STEP));
            ctrl.querySelector('.row-margin-increase')?.addEventListener('click', () =>
                setQtyMargin(lineEl, qty, currentMargin() + MARGIN_STEP));
        });
    };

    const renderLineResults = (lineEl, lineResult) => {
        const warnings = lineEl.querySelector('.calc-warnings');
        const errors = lineEl.querySelector('.calc-errors');
        const tbody = lineEl.querySelector('.calc-results tbody');
        syncImpositionControls(lineEl, lineResult.imposition);
        if (warnings) {
            warnings.classList.toggle('d-none', !lineResult.warnings?.length);
            warnings.textContent = (lineResult.warnings || []).join('; ');
        }
        if (errors) {
            errors.classList.toggle('d-none', !lineResult.errors?.length);
            errors.textContent = (lineResult.errors || []).join('; ');
        }
        if (tbody) {
            tbody.innerHTML = '';
            const overrides = getQtyMarkupMap(lineEl);
            (lineResult.quantityBreaks || []).forEach(row => {
                const tr = document.createElement('tr');
                if (row.belowMinimumMargin) tr.classList.add('table-warning');
                const markupUsed = Number(row.markupPctUsed ?? lineResult.markupPctUsed ?? 0);
                const marginValue = `${(markupToMargin(markupUsed) * 100).toFixed(1)}%`;
                const hasOverride = overrides[String(row.quantity)] !== undefined;
                tr.innerHTML = `<td>${row.quantity.toLocaleString()}</td>
                    <td>${Number(row.unitPrice).toFixed(4)}</td>
                    <td>${Number(row.totalPrice).toFixed(2)}</td>
                    <td>
                        <div class="input-group input-group-sm row-margin-control" data-qty="${row.quantity}" style="max-width: 9.5rem;">
                            <button type="button" class="btn btn-outline-secondary row-margin-decrease" aria-label="Decrease margin for ${row.quantity}">−</button>
                            <input type="text" class="form-control row-margin-input text-center${hasOverride ? ' fw-semibold' : ''}" inputmode="decimal" value="${marginValue}" aria-label="Margin percent for ${row.quantity}" />
                            <button type="button" class="btn btn-outline-secondary row-margin-increase" aria-label="Increase margin for ${row.quantity}">+</button>
                        </div>${row.belowMinimumMargin ? '<span class="text-warning small">below min ⚠</span>' : ''}</td>`;
                tbody.appendChild(tr);
            });
            wireRowMarginControls(lineEl, tbody);
        }
        if (lineResult.markupPctUsed !== undefined && lineResult.markupPctUsed !== null) {
            lineEl.dataset.lineIndex = lineEl.dataset.lineIndex ?? '0';
            lineMarkupCache.set(lineEl.dataset.lineIndex, Number(lineResult.markupPctUsed));
            const hasOverride = lineEl.querySelector('.markup-override-input')?.value?.trim();
            if (!hasOverride) {
                updateMarginDisplay(lineEl, Number(lineResult.markupPctUsed));
            } else {
                updateMarginDisplay(lineEl, getLineMarkup(lineEl));
            }
        }
        lineResultsCache.set(String(lineEl.dataset.lineIndex), lineResult);
        updateLineSummary(lineEl, lineResult);
        updateEstimateTotals();
        if (lineEl.querySelector('.estimate-line-details')?.open) {
            refreshBreakdownPanel();
        }
    };

    const calculate = async () => {
        const payload = collectPayload();
        if (!payload.customerId) return;
        const response = await fetch('/estimates/calculate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(payload)
        });
        if (!response.ok) return;
        const data = await response.json();
        const lineEls = linesContainer.querySelectorAll('.estimate-line');
        (data.lines || []).forEach(lr => {
            const lineEl = lineEls[lr.lineIndex];
            if (lineEl) renderLineResults(lineEl, {
                ...lr,
                markupPctUsed: lr.markupPctUsed,
                impositionLayout: lr.impositionLayout
            });
        });
        refreshBreakdownPanel();
    };

    const scheduleCalculate = () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(calculate, 350);
    };

    const wireUp = (root) => {
        root.querySelectorAll('.quantity-input').forEach(input => {
            input.addEventListener('blur', () => scheduleQuantityReorder(input.closest('.estimate-line')));
            input.addEventListener('input', () => scheduleQuantityReorder(input.closest('.estimate-line')));
        });
        root.querySelectorAll('.calc-trigger').forEach(el => {
            el.addEventListener('input', scheduleCalculate);
            el.addEventListener('blur', calculate);
        });
        root.querySelectorAll('.calc-immediate').forEach(el => {
            el.addEventListener('change', calculate);
        });
        root.querySelectorAll('.special-hits-select').forEach(sel => {
            const sync = () => {
                const line = sel.closest('.estimate-line');
                const group = line?.querySelector('.' + sel.dataset.coverageGroup);
                if (group) group.classList.toggle('d-none', (parseInt(sel.value, 10) || 0) <= 0);
            };
            sel.addEventListener('change', sync);
            sync();
        });
        root.querySelectorAll('.coverage-slider').forEach(sl => {
            const readout = sl.closest('[class*="coverage-group"]')?.querySelector('.coverage-readout');
            sl.addEventListener('input', () => { if (readout) readout.textContent = `${sl.value}%`; });
        });
        root.querySelectorAll('.finishing-category-select').forEach(sel => {
            sel.addEventListener('change', () => populateFinishingOperations(sel));
        });
        root.querySelectorAll('.finishing-operation-select').forEach(sel => {
            sel.addEventListener('change', () => {
                const addBtn = sel.closest('.finishing-builder')?.querySelector('.finishing-add');
                if (addBtn) addBtn.disabled = !sel.value;
            });
        });
        root.querySelectorAll('.finishing-add').forEach(btn => {
            btn.addEventListener('click', () => {
                const builder = btn.closest('.finishing-builder');
                const opSel = builder?.querySelector('.finishing-operation-select');
                const op = finishingById.get(opSel?.value);
                const lineEl = btn.closest('.estimate-line');
                if (op && lineEl && addFinishingToLine(lineEl, op, '', '', '')) {
                    calculate();
                }
                if (opSel) opSel.value = '';
                btn.disabled = true;
            });
        });
        root.querySelectorAll('.finishing-remove').forEach(wireFinishingRemove);
        root.querySelectorAll('.finishing-stock-select').forEach(sel => {
            sel.addEventListener('change', calculate);
        });
        root.querySelectorAll('.spot-ink-select').forEach(sel => {
            sel.addEventListener('change', () => {
                const addBtn = sel.closest('.spot-builder')?.querySelector('.spot-add');
                if (addBtn) addBtn.disabled = !sel.value;
            });
        });
        root.querySelectorAll('.spot-add').forEach(btn => {
            btn.addEventListener('click', () => {
                const builder = btn.closest('.spot-builder');
                const sel = builder?.querySelector('.spot-ink-select');
                const ink = spotInkById.get(sel?.value);
                const lineEl = btn.closest('.estimate-line');
                if (ink && lineEl && addSpotToLine(lineEl, ink)) {
                    calculate();
                }
                if (sel) sel.value = '';
                btn.disabled = true;
            });
        });
        root.querySelectorAll('.spot-remove').forEach(wireSpotRemove);
        root.querySelectorAll('[name$=".InkSet"]').forEach(sel => {
            sel.addEventListener('change', () => toggleInkGroups(sel.closest('.estimate-line')));
        });
        root.querySelectorAll('.estimate-line').forEach(toggleInkGroups);
        root.querySelectorAll('.source-product').forEach(sel => {
            sel.addEventListener('change', () => {
                if (!sel.value) return;
                const product = productsList.find(p => p.id === sel.value);
                if (product) {
                    const lineEl = sel.closest('.estimate-line');
                    applyProductToLine(lineEl, product);
                    calculate();
                }
            });
        });
        root.querySelectorAll('.remove-line').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const lineEl = btn.closest('.estimate-line');
                if (linesContainer.querySelectorAll('.estimate-line').length <= 1) return;
                cancelQuantityReorder(lineEl);
                lineMarkupCache.delete(lineEl.dataset.lineIndex);
                lineResultsCache.delete(String(lineEl.dataset.lineIndex));
                lineEl.remove();
                reindexLines();
                calculate();
            });
        });
        root.querySelectorAll('.margin-decrease').forEach(btn => {
            btn.addEventListener('click', () => adjustLineMargin(btn.closest('.estimate-line'), -MARGIN_STEP));
        });
        root.querySelectorAll('.margin-increase').forEach(btn => {
            btn.addEventListener('click', () => adjustLineMargin(btn.closest('.estimate-line'), MARGIN_STEP));
        });
        root.querySelectorAll('.margin-input').forEach(input => {
            input.addEventListener('blur', () => applyMarginInput(input.closest('.estimate-line')));
            input.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applyMarginInput(input.closest('.estimate-line'));
                    input.blur();
                }
            });
        });
        root.querySelectorAll('.estimate-line').forEach(lineEl => {
            const override = lineEl.querySelector('.markup-override-input')?.value?.trim();
            if (override) updateMarginDisplay(lineEl, parseFloat(override));
            wireLineAccordion(lineEl);
            const descInput = lineEl.querySelector('[name$=".ProductDescription"]');
            descInput?.addEventListener('input', () => {
                const descEl = lineEl.querySelector('.line-desc');
                if (descEl) descEl.textContent = descInput.value.trim() || 'Untitled line';
            });
        });
    };

    if (addLineBtn && lineTemplateEl) {
        addLineBtn.addEventListener('click', () => {
            const idx = linesContainer.querySelectorAll('.estimate-line').length;
            const html = lineTemplateEl.innerHTML
                .replace(/__INDEX__/g, String(idx))
                .replace(/__DISPLAY__/g, String(idx + 1));
            const wrapper = document.createElement('div');
            wrapper.innerHTML = html.trim();
            const newLine = wrapper.firstElementChild;
            newLine.dataset.lineIndex = String(idx);
            linesContainer.appendChild(newLine);
            wireUp(newLine);
            wireLineAccordion(newLine);
            toggleInkGroups(newLine);
            populateProductSelects();
            calculate();
        });
    }

    const shipToFields = () => ({
        name: root.querySelector('[name="Input.ShipToName"]'),
        street1: root.querySelector('[name="Input.ShipToStreet1"]'),
        street2: root.querySelector('[name="Input.ShipToStreet2"]'),
        city: root.querySelector('[name="Input.ShipToCity"]'),
        state: root.querySelector('[name="Input.ShipToState"]'),
        zip: root.querySelector('[name="Input.ShipToZip"]'),
        country: root.querySelector('[name="Input.ShipToCountry"]'),
    });

    let shipToOptions = [];

    const loadShipToAddresses = async () => {
        if (!shipToSource) return;
        const customerId = customerSelect?.value;
        const previous = shipToSource.value;
        shipToSource.innerHTML = '<option value="custom">Enter manually</option>';
        shipToOptions = [];
        if (!customerId) return;

        try {
            const response = await fetch(`/estimates/addresses?customerId=${encodeURIComponent(customerId)}`);
            if (!response.ok) return;
            shipToOptions = await response.json();
        } catch { return; }

        shipToOptions.forEach((a, i) => {
            const opt = document.createElement('option');
            opt.value = String(i);
            opt.textContent = a.label;
            shipToSource.appendChild(opt);
        });
        if ([...shipToSource.options].some(o => o.value === previous)) {
            shipToSource.value = previous;
        }
    };

    const loadContactEmail = async ({ overwrite }) => {
        const emailToInput = document.getElementById('EmailTo');
        const addContactLink = document.getElementById('estimate-add-contact');
        const contactSelect = document.getElementById('estimate-contact-select');
        if (!emailToInput && !addContactLink) return;

        const customerId = customerSelect?.value;
        const hideLink = () => {
            if (addContactLink) addContactLink.hidden = true;
            if (contactSelect) contactSelect.hidden = true;
        };
        if (!customerId) { hideLink(); return; }

        let data;
        try {
            const response = await fetch(`/estimates/contact-email?customerId=${encodeURIComponent(customerId)}`);
            if (!response.ok) { hideLink(); return; }
            data = await response.json();
        } catch { hideLink(); return; }

        if (emailToInput && data.email && (overwrite || !emailToInput.value)) {
            emailToInput.value = data.email;
        }

        if (contactSelect) {
            const contacts = data.contacts || [];
            contactSelect.innerHTML = '';
            if (contacts.length === 0) {
                contactSelect.hidden = true;
            } else {
                contactSelect.hidden = false;
                contactSelect.add(new Option('Use a customer contact…', ''));
                contacts.forEach(c => contactSelect.add(new Option(`${c.name} — ${c.email}`, c.email)));
            }
        }

        if (addContactLink) {
            if (data.email) {
                addContactLink.hidden = true;
            } else {
                addContactLink.href = `/customers/edit/${customerId}`;
                addContactLink.hidden = false;
            }
        }
    };

    document.getElementById('estimate-contact-select')?.addEventListener('change', (event) => {
        const select = event.currentTarget;
        const emailToInput = document.getElementById('EmailTo');
        if (select.value && emailToInput) {
            emailToInput.value = select.value;
        }
        select.selectedIndex = 0;
    });

    shipToSource?.addEventListener('change', () => {
        if (shipToSource.value === 'custom') return;
        const a = shipToOptions[Number(shipToSource.value)];
        if (!a) return;
        const f = shipToFields();
        if (f.name) f.name.value = a.recipientName ?? '';
        if (f.street1) f.street1.value = a.street1 ?? '';
        if (f.street2) f.street2.value = a.street2 ?? '';
        if (f.city) f.city.value = a.city ?? '';
        if (f.state) f.state.value = a.state ?? '';
        if (f.zip) f.zip.value = a.zip ?? '';
        if (f.country) f.country.value = a.country ?? '';
    });

    shippingMethodSelect?.addEventListener('change', () => {
        if (shippingCostInput && !shippingMethodSelect.disabled) {
            const opt = shippingMethodSelect.selectedOptions?.[0];
            const price = Number(opt?.dataset.price);
            shippingCostInput.value = Number.isFinite(price) ? price : 0;
        }
        updateShippingAddressVisibility();
        updateEstimateTotals();
    });

    shippingCostInput?.addEventListener('input', updateEstimateTotals);
    updateShippingAddressVisibility();

    customerSelect?.addEventListener('change', () => {
        syncProductFilterToEstimateCustomer();
        loadShipToAddresses();
        loadContactEmail({ overwrite: true });
        loadProducts().then(calculate);
    });

    productFilterSelect?.addEventListener('change', () => {
        productsCacheKey = null;
        loadProducts().then(calculate);
    });

    wireUp(root);
    syncProductFilterToEstimateCustomer();
    loadShipToAddresses();
    loadContactEmail({ overwrite: false });
    loadProducts().then(() => {
        calculate();
        updateEstimateTotals();
        refreshBreakdownPanel();
    });
})();
</script>

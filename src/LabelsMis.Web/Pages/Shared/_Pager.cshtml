@model LabelsMis.Web.Pages.Shared.PagerModel
@functions {
    // Build a relative query string for the target page. The parameter is `pageNumber`, not `page`:
    // `page` is a reserved Razor Pages route token that always sits in RouteData as the page path, and
    // route values outrank the query string in model binding, so a `?page=N` never reaches the model.
    string PageUrl(int page)
    {
        var parts = new List<string> { $"{Model.PageParam}={page}" };
        if (!string.IsNullOrWhiteSpace(Model.Search)) parts.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (!string.IsNullOrWhiteSpace(Model.Sort)) parts.Add($"sort={Uri.EscapeDataString(Model.Sort)}");
        if (Model.IncludeInactive) parts.Add("includeInactive=true");
        if (!string.IsNullOrWhiteSpace(Model.StockType)) parts.Add($"stockType={Uri.EscapeDataString(Model.StockType)}");
        if (Model.Extra is not null)
        {
            foreach (var kv in Model.Extra)
            {
                if (!string.IsNullOrWhiteSpace(kv.Value))
                {
                    parts.Add($"{kv.Key}={Uri.EscapeDataString(kv.Value)}");
                }
            }
        }
        return "?" + string.Join("&", parts);
    }
}
@{
    var totalPages = Math.Max(Model.TotalPages, 1);
    var current = Math.Clamp(Model.Page, 1, totalPages);

    // A window of up to 10 page links around the current page, clamped to the ends.
    const int windowSize = 10;
    var windowStart = Math.Max(1, current - (windowSize / 2 - 1));
    var windowEnd = Math.Min(totalPages, windowStart + windowSize - 1);
    windowStart = Math.Max(1, windowEnd - windowSize + 1);
}
<nav aria-label="Pagination" class="mt-3 d-flex flex-wrap align-items-center gap-2">
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(current == 1 ? "disabled" : "")">
            <a class="page-link" href="@PageUrl(1)" aria-label="First page">&laquo; First</a>
        </li>
        <li class="page-item @(current == 1 ? "disabled" : "")">
            <a class="page-link" href="@PageUrl(Math.Max(1, current - 1))" aria-label="Previous page">&lsaquo; Prev</a>
        </li>
        @for (var pageNumber = windowStart; pageNumber <= windowEnd; pageNumber++)
        {
            <li class="page-item @(pageNumber == current ? "active" : "")">
                <a class="page-link" href="@PageUrl(pageNumber)">@pageNumber</a>
            </li>
        }
        <li class="page-item @(current == totalPages ? "disabled" : "")">
            <a class="page-link" href="@PageUrl(Math.Min(totalPages, current + 1))" aria-label="Next page">Next &rsaquo;</a>
        </li>
        <li class="page-item @(current == totalPages ? "disabled" : "")">
            <a class="page-link" href="@PageUrl(totalPages)" aria-label="Last page">Last &raquo;</a>
        </li>
    </ul>
    <span class="small text-muted">Page @current of @totalPages · @Model.TotalCount total</span>
</nav>

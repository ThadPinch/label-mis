@model LabelsMis.Web.Pages.Shared.PagerModel
@functions {
    // Build a relative query string for the target page. The parameter is `pageNumber`, not `page`:
    // `page` is a reserved Razor Pages route token that always sits in RouteData as the page path, and
    // route values outrank the query string in model binding, so a `?page=N` never reaches the model.
    string PageUrl(int page)
    {
        var parts = new List<string> { $"{Model.PageParam}={page}" };
        if (!string.IsNullOrWhiteSpace(Model.Search)) parts.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (!string.IsNullOrWhiteSpace(Model.Sort)) parts.Add($"sort={Uri.EscapeDataString(Model.Sort)}");
        if (Model.IncludeInactive) parts.Add("includeInactive=true");
        if (!string.IsNullOrWhiteSpace(Model.StockType)) parts.Add($"stockType={Uri.EscapeDataString(Model.StockType)}");
        if (Model.Extra is not null)
        {
            foreach (var kv in Model.Extra)
            {
                if (!string.IsNullOrWhiteSpace(kv.Value))
                {
                    parts.Add($"{kv.Key}={Uri.EscapeDataString(kv.Value)}");
                }
            }
        }
        return "?" + string.Join("&", parts);
    }
}
<nav aria-label="Pagination" class="mt-3">
    <ul class="pagination">
        @if (Model.Page > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@PageUrl(Model.Page - 1)">Previous</a>
            </li>
        }
        <li class="page-item disabled">
            <span class="page-link">Page @Model.Page of @Math.Max(Model.TotalPages, 1) (@Model.TotalCount total)</span>
        </li>
        @if (Model.Page < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" href="@PageUrl(Model.Page + 1)">Next</a>
            </li>
        }
    </ul>
</nav>

@using LabelsMis.Domain.Enums
@using LabelsMis.Web.Pages.Production
@model IReadOnlyDictionary<JobStatus, int>

@foreach (var stage in ProductionStages.All)
{
    var count = Model.TryGetValue(stage.Status, out var c) ? c : 0;
    <li>
        <a class="dropdown-item d-flex justify-content-between align-items-center" asp-page="@stage.Page">
            <span>@stage.Label</span>
            <span class="badge rounded-pill text-bg-secondary ms-3">@count</span>
        </a>
    </li>
}

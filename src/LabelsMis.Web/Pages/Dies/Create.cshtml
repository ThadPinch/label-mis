@page "/dies/create"
@model LabelsMis.Web.Pages.Dies.CreateModel
@{
    ViewData["Title"] = "New die";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h4 mb-2">New die</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <partial name="_DieForm" model="Model.Input" />
    <div class="d-flex gap-2 mt-1">
        <button type="submit" class="btn btn-sm btn-primary">Create</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

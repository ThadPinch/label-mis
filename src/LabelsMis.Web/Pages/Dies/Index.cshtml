@page "/dies"
@model LabelsMis.Web.Pages.Dies.IndexModel
@{
    ViewData["Title"] = "Dies";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["IncludeInactive"] = Model.IncludeInactive ? "true" : null,
        ["Sort"] = Model.Sort
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0">Dies</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-sm btn-primary" asp-page="Create">New die</a>
    }
</div>

<form method="get" class="row g-2 align-items-center mb-2">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-4 col-lg-3">
        <input asp-for="Search" class="form-control form-control-sm" placeholder="Search description, customer, location" />
    </div>
    <div class="col-auto">
        <div class="form-check small mb-0">
            <input asp-for="IncludeInactive" class="form-check-input" />
            <label asp-for="IncludeInactive" class="form-check-label">Show inactive</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
    </div>
</form>

<div class="card mb-2">
    <table class="table table-sm table-striped small align-middle mb-0">
        <thead>
            <tr>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Description", "description", Model.Sort, route))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Customer", "customer", Model.Sort, route))</th>
                <th class="text-end">@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Label size", "size", Model.Sort, route))</th>
                <th class="text-end">@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Layout", "layout", Model.Sort, route))</th>
                <th class="text-end">@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Die repeat", "repeat", Model.Sort, route))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Location", "location", Model.Sort, route))</th>
                <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Active", "active", Model.Sort, route))</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Result.Items)
        {
            <tr>
                <td>@item.Description</td>
                <td>@(item.CustomerName ?? "—")</td>
                <td class="text-end text-nowrap">@item.LabelAcrossIn.ToString("0.####")&quot; × @item.LabelAroundIn.ToString("0.####")&quot;</td>
                <td class="text-end text-nowrap">@item.LabelsAcross × @item.LabelsAround</td>
                <td class="text-end text-nowrap">@(item.DieRepeatIn is { } repeat ? $"{repeat:0.0000}\"" : "—")</td>
                <td>@(item.Location ?? "—")</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td class="text-end text-nowrap">
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@(Model.CanEdit ? "Edit" : "View")</a>
                    @if (Model.CanEdit)
                    {
                        <a asp-page="Create" asp-route-duplicateFrom="@item.Id" class="btn btn-sm btn-outline-secondary">Duplicate</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount,
    Model.Search,
    Model.Sort,
    IncludeInactive: Model.IncludeInactive))

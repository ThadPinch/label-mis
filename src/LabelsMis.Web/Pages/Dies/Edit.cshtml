@page "/dies/edit/{id:guid}"
@model LabelsMis.Web.Pages.Dies.EditModel
@{
    ViewData["Title"] = "Edit die";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h4 mb-2">Edit die</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <partial name="_DieForm" model="Model.Input" />
    @if (Model.CanEdit)
    {
        <div class="d-flex gap-2 mt-1">
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
            @if (Model.IsActive)
            {
                <button type="submit" asp-page-handler="Deactivate" class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('Deactivate this die?');">Deactivate</button>
            }
        </div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

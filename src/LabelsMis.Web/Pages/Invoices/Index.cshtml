@page "/invoices"
@using LabelsMis.Domain.Enums
@model LabelsMis.Web.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Invoices";
    var showCheckboxes = Model.OnReadyTab && Model.CanEdit;
    var route = Model.FilterRouteValues()
        .Where(kv => kv.Key != "pageNumber")
        .ToDictionary(kv => kv.Key, kv => (string?)kv.Value);
}

@await Component.InvokeAsync("QuickBooksAlert")

<div class="d-flex justify-content-between mb-3">
    <h1 class="h3 mb-0">Invoices</h1>
    @if (Model.CanEdit)
    {
        <a asp-page="/Reports/ArAging" class="btn btn-outline-primary">AR aging</a>
    }
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.OnReadyTab ? "active" : "")" id="tab-ready"
           asp-page="Index" asp-all-route-data="@Model.FilterRouteValues(IndexModel.ReadyTab)">
            Ready to export <span class="badge rounded-pill text-bg-secondary" id="tab-ready-count">@Model.ReadyCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.OnWaitingTab ? "active" : "")" id="tab-waiting"
           asp-page="Index" asp-all-route-data="@Model.FilterRouteValues(IndexModel.WaitingTab)">
            Waiting <span class="badge rounded-pill text-bg-warning" id="tab-waiting-count">@Model.WaitingCount</span>
        </a>
    </li>
    @if (Model.AttentionCount > 0 || Model.OnAttentionTab || Model.QuickBooksConnected)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.OnAttentionTab ? "active" : "")" id="tab-attention"
               asp-page="Index" asp-all-route-data="@Model.FilterRouteValues(IndexModel.AttentionTab)">
                Needs attention
                <span class="badge rounded-pill @(Model.AttentionCount > 0 ? "text-bg-danger" : "text-bg-secondary")" id="tab-attention-count">@Model.AttentionCount</span>
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link @(Model.OnExportedTab ? "active" : "")" id="tab-exported"
           asp-page="Index" asp-all-route-data="@Model.FilterRouteValues(IndexModel.ExportedTab)">
            Exported / closed <span class="badge rounded-pill text-bg-secondary" id="tab-exported-count">@Model.ExportedCount</span>
        </a>
    </li>
</ul>

@if (TempData["ExportMessage"] is string exportMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @exportMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData[QuickBooksUi.MessageKey] is string qbMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="qb-message">
        @qbMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData[QuickBooksUi.ProblemsKey] is string qbProblems)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" id="qb-problems">
        <div class="fw-semibold">Not sent to QuickBooks:</div>
        <ul class="mb-0 small">
            @foreach (var problem in qbProblems.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <li>@problem</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData[QuickBooksUi.ErrorKey] is string qbError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="qb-error">
        @qbError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Tab" />
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-2"><input asp-for="Search" class="form-control" placeholder="Search" /></div>
    <div class="col-md-2">
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.InvoiceStatus>()"><option value="">All statuses</option></select>
    </div>
    <div class="col-md-2">
        <select asp-for="CustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["CustomerOptions"]!)"><option value="">All customers</option></select>
    </div>
    <div class="col-md-2">
        <select asp-for="AgingBucket" class="form-select">
            <option value="">All aging</option>
            <option value="current">Current</option>
            <option value="1-30">1–30 days</option>
            <option value="31-60">31–60 days</option>
            <option value="61-90">61–90 days</option>
            <option value="90+">90+ days</option>
        </select>
    </div>
    <div class="col-md-1"><button type="submit" class="btn btn-outline-secondary w-100">Filter</button></div>
</form>

@if (showCheckboxes)
{
    <div class="alert alert-info py-2 small mb-2" id="qb-send-note">
        @switch (Model.QuickBooksConnection)
        {
            case QuickBooksConnectionState.Connected:
                <span><strong>Send to QuickBooks</strong> puts the ticked invoices in line, and LabelShop creates each one in
                QuickBooks within a minute or so. The QuickBooks column shows how far each one got: sent invoices move to
                <strong>Exported / closed</strong>, and any QuickBooks turns down go to <strong>Needs attention</strong>.
                <strong>Mark selected as exported</strong> is for invoices already keyed into QuickBooks by hand.</span>
                break;
            case QuickBooksConnectionState.NeedsReconnect:
                <span><strong>QuickBooks has to be connected again before LabelShop can send invoices</strong>
                (<a asp-page="/Settings/QuickBooks">Setup → QuickBooks</a>). Until then, key each invoice into QuickBooks from
                its <strong>QB preview</strong>, then mark it exported.</span>
                break;
            default:
                <span><strong>QuickBooks is not connected, so LabelShop does not send invoices.</strong>
                Key each invoice into QuickBooks from its <strong>QB preview</strong>, then mark it exported, or connect
                QuickBooks on <a asp-page="/Settings/QuickBooks">Setup → QuickBooks</a>.</span>
                break;
        }
        The CSV is a list for your own records: QuickBooks' importer does not accept it, and downloading it moves the
        ticked invoices to Exported / closed.
    </div>
    @* Row checkboxes live outside this form in the table below and join it via form="bulk-export-form". *@
    <form method="post" id="bulk-export-form" asp-page-handler="MarkSelectedExported"
          asp-all-route-data="@Model.FilterRouteValues()" class="mb-2 d-flex gap-2">
        @if (Model.QuickBooksConnected)
        {
            <button type="submit" id="bulk-send-button" class="btn btn-sm btn-primary" disabled
                    asp-page-handler="SendSelected" asp-all-route-data="@Model.FilterRouteValues()">
                Send to QuickBooks
            </button>
        }
        <button type="submit" id="bulk-mark-button" class="btn btn-sm btn-outline-success" disabled>
            Mark selected as exported
        </button>
        <button type="submit" id="bulk-qb-button" class="btn btn-sm btn-outline-secondary" disabled
                asp-page-handler="ExportSelected" asp-all-route-data="@Model.FilterRouteValues()">
            Download CSV
        </button>
    </form>
}

@if (Model.OnAttentionTab)
{
    <p class="small text-muted mb-2" id="qb-attention-note">
        QuickBooks turned these down. Fix what the message says, then <strong>Retry</strong>. If you sorted it out in
        QuickBooks yourself, <strong>Settled by hand</strong> takes it off this list.
    </p>
}

<table class="table table-striped">
    <thead>
    <tr>
        @if (showCheckboxes)
        {
            <th style="width: 2rem"><input type="checkbox" id="select-all-invoices" class="form-check-input" aria-label="Select all invoices on this page" /></th>
        }
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Invoice #", "number", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Customer", "customer", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Order", "order", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Date", "date", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Due", "due", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Status", "status", Model.Sort, route))</th>
        @if (!Model.OnAttentionTab)
        {
            <th>Order status</th>
        }
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Total", "total", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Balance", "balance", Model.Sort, route))</th>
        @if (Model.ShowQuickBooksColumn)
        {
            <th>QuickBooks</th>
        }
        @if (Model.OnExportedTab)
        {
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Exported", "exported", Model.Sort, route))</th>
        }
        @if (Model.OnWaitingTab)
        {
            <th>Waiting for</th>
        }
        @if (Model.OnAttentionTab)
        {
            <th>Problem</th>
        }
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        var qbState = Model.QuickBooksStates.GetValueOrDefault(item.Id);
        <tr data-invoice-id="@item.Id">
            @if (showCheckboxes)
            {
                <td>
                    <input type="checkbox" name="selectedIds" value="@item.Id" form="bulk-export-form"
                           class="form-check-input invoice-select" aria-label="Select @item.InvoiceNumber" />
                </td>
            }
            <td>@item.InvoiceNumber</td><td>@item.CustomerName</td>
            <td><a asp-page="/SalesOrders/Edit" asp-route-id="@item.SalesOrderId">@item.OrderNumber</a></td>
            <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td><td>@item.DueDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Status</td>
            @if (!Model.OnAttentionTab)
            {
                <td>
                    @if (item.IsFullyShipped)
                    {
                        <span class="badge bg-success">Shipped @item.ShippedLines/@item.TotalLines</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Shipped @item.ShippedLines/@item.TotalLines</span>
                    }
                </td>
            }
            <td>@item.Total.ToString("C2")</td><td>@item.BalanceDue.ToString("C2")</td>
            @if (Model.ShowQuickBooksColumn)
            {
                <td class="qb-status-cell">@QuickBooksUi.Badge(item.Id, qbState)</td>
            }
            @if (Model.OnExportedTab)
            {
                <td>
                    @if (item.NonBillable)
                    {
                        <span class="badge text-bg-secondary" title="@item.NonBillableReason">Non-billable</span>
                        <div class="text-muted small text-truncate" style="max-width: 16rem">@item.NonBillableReason</div>
                    }
                    @item.QbExportedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    @if (!string.IsNullOrEmpty(item.ExportedBy))
                    {
                        <div class="text-muted small">by @item.ExportedBy</div>
                    }
                </td>
            }
            @if (Model.OnWaitingTab)
            {
                <td class="small waiting-reasons">
                    @foreach (var reason in Model.WaitingReasons.GetValueOrDefault(item.Id) ?? [])
                    {
                        <div class="text-warning-emphasis">@reason</div>
                    }
                </td>
            }
            @if (Model.OnAttentionTab)
            {
                <td class="small qb-problem" style="max-width: 28rem">
                    <div class="text-danger-emphasis">@(qbState?.LastError ?? "QuickBooks did not accept this invoice.")</div>
                    @if (qbState?.FixUrl is { } fixUrl)
                    {
                        <a href="@fixUrl" class="qb-fix-link">Fix it</a>
                    }
                </td>
            }
            <td class="text-end text-nowrap">
                @if (Model.OnAttentionTab && Model.CanEdit)
                {
                    <form method="post" asp-page-handler="QuickBooksRetry"
                          asp-all-route-data="@Model.FilterRouteValues()" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="invoiceNumber" value="@item.InvoiceNumber" />
                        <button type="submit" class="btn btn-sm btn-primary qb-retry">Retry</button>
                    </form>
                    <form method="post" asp-page-handler="QuickBooksCancel"
                          asp-all-route-data="@Model.FilterRouteValues()" class="d-inline"
                          onsubmit="return confirm('Take @item.InvoiceNumber off Needs attention? Do this once it is right in QuickBooks, or does not need to be there.');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="invoiceNumber" value="@item.InvoiceNumber" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary qb-settled">Settled by hand</button>
                    </form>
                }
                @if (Model.OnExportedTab && Model.CanEdit && !item.NonBillable)
                {
                    <form method="post" asp-page-handler="UnmarkExported"
                          asp-all-route-data="@Model.FilterRouteValues()" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Unmark exported</button>
                    </form>
                }
                @if (!Model.OnExportedTab)
                {
                    <a href="/invoices/@item.Id/quickbooks" class="btn btn-sm btn-outline-secondary">QB preview</a>
                }
                <a asp-page="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Result.Items.Any())
{
    <p class="text-muted">
        @(Model.OnExportedTab
            ? "No exported invoices match the current filters."
            : Model.OnWaitingTab
                ? "Nothing is waiting."
                : Model.OnAttentionTab
                    ? "Nothing needs attention."
                    : "No invoices are ready to export.")
    </p>
}

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount)
{
    Extra = route
})

@if (Model.ShowQuickBooksColumn)
{
    <div id="qb-status-poll" hidden
         data-qb-status-url="@Url.Page("/Invoices/Index", "QuickBooksStates")"
         data-qb-tab="@(Model.OnReadyTab ? IndexModel.ReadyTab : Model.Tab)"
         data-qb-interval="@QuickBooksUi.PollIntervalMs"></div>
}

@section Scripts {
    <script src="~/js/invoice-quickbooks-status.js" asp-append-version="true"></script>
}

@if (showCheckboxes)
{
    <script>
        (function () {
            const selectAll = document.getElementById('select-all-invoices');
            const boxes = Array.from(document.querySelectorAll('.invoice-select'));
            const sendButton = document.getElementById('bulk-send-button');
            const qbButton = document.getElementById('bulk-qb-button');
            const markButton = document.getElementById('bulk-mark-button');

            function refresh() {
                const checked = boxes.filter(b => b.checked).length;
                qbButton.disabled = checked === 0;
                markButton.disabled = checked === 0;
                if (sendButton) {
                    sendButton.disabled = checked === 0;
                    sendButton.textContent = checked === 0
                        ? 'Send to QuickBooks'
                        : `Send ${checked} to QuickBooks`;
                }
                qbButton.textContent = checked === 0
                    ? 'Download CSV'
                    : `Download CSV of ${checked}`;
                markButton.textContent = checked === 0
                    ? 'Mark selected as exported'
                    : `Mark ${checked} selected as exported`;
                selectAll.checked = boxes.length > 0 && checked === boxes.length;
                selectAll.indeterminate = checked > 0 && checked < boxes.length;
            }

            selectAll.addEventListener('change', () => {
                boxes.forEach(b => { b.checked = selectAll.checked; });
                refresh();
            });
            boxes.forEach(b => b.addEventListener('change', refresh));
            refresh();

            // The CSV download responds with a file, which doesn't reload the page, so refresh
            // shortly after to move the exported rows off the Ready tab.
            qbButton.addEventListener('click', () => {
                setTimeout(() => window.location.reload(), 1500);
            });
        })();
    </script>
}

@page "/users"
@model LabelsMis.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["Sort"] = Model.Sort
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <a class="btn btn-primary" asp-page="Create">New user</a>
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-6">
        <input asp-for="Search" class="form-control" placeholder="Search email" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Email", "email", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Roles", "roles", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Status", "status", Model.Sort, route))</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>@user.Email</td>
            <td>@string.Join(", ", user.Roles)</td>
            <td>
                @if (user.IsLockedOut)
                {
                    <span class="badge text-bg-danger">Locked</span>
                }
                else if (user.MustChangePassword)
                {
                    <span class="badge text-bg-warning">Must change password</span>
                }
                else
                {
                    <span class="badge text-bg-success">Active</span>
                }
            </td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>

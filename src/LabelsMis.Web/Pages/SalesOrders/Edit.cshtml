@page "/sales-orders/{id:guid}/edit"
@model LabelsMis.Web.Pages.SalesOrders.EditModel
@{ ViewData["Title"] = Model.Order?.OrderNumber ?? "Sales order"; ViewData["BackNav"] = new BackNavModel(); }
<h1 class="h3 mb-1">@Model.Order?.OrderNumber</h1>
<p class="text-muted mb-1">@Model.Order?.Status</p>
@if (Model.SourceEstimateId is not null)
{
    <p class="mb-3">
        <span class="text-muted">Estimate:</span>
        <a asp-page="/Estimates/Edit" asp-route-id="@Model.SourceEstimateId">@(Model.SourceEstimateNumber ?? "View estimate")</a>
    </p>
}
@if (Model.LineJobs.Any(j => j.JobId is not null))
{
    <div class="card mb-3">
        <div class="card-header py-2">Production jobs</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 3rem;">#</th>
                        <th>Product</th>
                        <th>Job</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lineJob in Model.LineJobs)
                    {
                        <tr>
                            <td>@lineJob.LineNumber</td>
                            <td>@lineJob.ProductLabel</td>
                            <td>
                                @if (lineJob.JobId is not null)
                                {
                                    <a asp-page="/Jobs/Detail" asp-route-id="@lineJob.JobId">@lineJob.JobNumber</a>
                                }
                                else
                                {
                                    <span class="text-muted">Not scheduled</span>
                                }
                            </td>
                            <td>
                                @if (lineJob.JobStatus is not null)
                                {
                                    <span class="badge text-bg-secondary">@lineJob.JobStatus</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (Model.Shipments.Any())
{
    <div class="card mb-3">
        <div class="card-header py-2">Shipments</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Shipment</th>
                        <th>Ship date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shipment in Model.Shipments)
                    {
                        <tr>
                            <td><a asp-page="/Shipments/Detail" asp-route-id="@shipment.Id">@shipment.ShipmentNumber</a></td>
                            <td>@shipment.ShipDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge text-bg-secondary">@shipment.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (Model.Invoices.Any())
{
    <div class="card mb-3">
        <div class="card-header py-2">Invoices</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td><a asp-page="/Invoices/Detail" asp-route-id="@invoice.Id">@invoice.InvoiceNumber</a></td>
                            <td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge text-bg-secondary">@invoice.Status</span></td>
                            <td class="text-end">@invoice.Total.ToString("C2")</td>
                            <td class="text-end">@invoice.BalanceDue.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
}
@if (Model.CanSchedule)
{
    <form method="post" asp-page-handler="ScheduleForProduction" class="mb-3">
        <button type="submit" class="btn btn-success">Schedule for production</button>
    </form>
}
@if (Model.IsLocked)
{
    <div class="alert alert-info">This order is locked because production has started.</div>
    <partial name="_SalesOrderForm" for="Input" />
}
else
{
    <form method="post" enctype="multipart/form-data" id="sales-order-form">
        <partial name="_SalesOrderForm" for="Input" />
        <button type="submit" asp-page-handler="Save" class="btn btn-primary">Save</button>
    </form>
}
@if (Model.CanDelete)
{
    <form method="post" asp-page-handler="Delete" class="mt-3"
          onsubmit="return confirm('Delete this sales order permanently? This cannot be undone.');">
        <button type="submit" class="btn btn-outline-danger">Delete order</button>
    </form>
}
@if (Model.CanCancel)
{
    <form method="post" asp-page-handler="Cancel" class="mt-3"
          onsubmit="return confirm('Cancel this order? Its jobs will be closed and unpaid invoices voided.');">
        <button type="submit" class="btn btn-outline-warning">Cancel order</button>
    </form>
}

@section Scripts {
    <script src="~/js/artwork-upload.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            LabelsMis.initSalesOrderArtworkUploads(document.getElementById('sales-order-form'));
        });
    </script>
    <partial name="Shared/_ShipToAddressScript" model="@("?handler=Addresses")" />
    <partial name="Shared/_ShippingPriceScript" />
}

@page "/sales-orders/{id:guid}/edit"
@model LabelsMis.Web.Pages.SalesOrders.EditModel
@{
    ViewData["Title"] = Model.Order?.OrderNumber ?? "Sales order";
    ViewData["BackNav"] = new BackNavModel();
    var lineTotal = Model.Order?.Lines.Sum(l => l.LineTotal) ?? 0m;
    var chargesTotal = Model.Order?.Charges.Sum(c => c.LineTotal) ?? 0m;
    var orderTotal = lineTotal + chargesTotal + (Model.Order?.ShippingCost ?? 0m);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <div class="d-flex flex-wrap align-items-baseline gap-2">
        <h1 class="h3 mb-0">@Model.Order?.OrderNumber</h1>
        <span class="badge text-bg-primary">@Model.Order?.Status</span>
        @if (Model.SourceEstimateId is not null)
        {
            <span class="small text-muted">
                Estimate <a asp-page="/Estimates/Edit" asp-route-id="@Model.SourceEstimateId">@(Model.SourceEstimateNumber ?? "view")</a>
            </span>
        }
        @if (Model.SalesRepName is not null)
        {
            <span class="small text-muted">Rep: @Model.SalesRepName</span>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsLocked && !Model.Unlocked && Model.CanUnlock)
        {
            <a asp-page="Edit" asp-route-id="@Model.Id" asp-route-unlocked="true" class="btn btn-sm btn-outline-warning">Unlock to edit</a>
        }
        @if (Model.IsEditing)
        {
            <button type="submit" form="sales-order-form" class="btn btn-sm btn-primary">Save order</button>
        }
        @if (Model.CanDelete)
        {
            <form method="post" asp-page-handler="Delete"
                  onsubmit="return confirm('Delete this sales order permanently? This cannot be undone.');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        }
        @if (Model.CanCancel)
        {
            <form method="post" asp-page-handler="Cancel"
                  onsubmit="return confirm('Cancel this order? Its jobs will be closed and unpaid invoices voided. The source estimate keeps its status.');">
                <button type="submit" class="btn btn-sm btn-outline-warning">Cancel order</button>
            </form>
        }
        @if (Model.CanCancelEstimate)
        {
            <form method="post" asp-page-handler="CancelEstimate"
                  onsubmit="return confirm('Cancel estimate @Model.SourceEstimateNumber AND this order? This cascades: the estimate is marked Cancelled, the order is cancelled, its jobs are closed, and unpaid invoices are voided.');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel order &amp; estimate</button>
            </form>
        }
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
}
@if (TempData["OrderStatus"] is string orderStatus)
{
    <div class="alert alert-success py-2 mb-2">@orderStatus</div>
}
@if (TempData["OrderWarning"] is string orderWarning)
{
    <div class="alert alert-warning py-2 mb-2">@orderWarning</div>
}
@if (TempData["OrderError"] is string orderError)
{
    <div class="alert alert-danger py-2 mb-2">@orderError</div>
}
@if (Model.IsEditing && Model.Invoices.Any(i => i.QbExportedAt != null))
{
    var exportedInvoices = Model.Invoices.Where(i => i.QbExportedAt != null).ToList();
    <div class="alert alert-danger py-2 mb-2">
        <strong>Already invoiced and exported.</strong>
        @foreach (var invoice in exportedInvoices)
        {
            <span>@invoice.InvoiceNumber was exported to QuickBooks on @invoice.QbExportedAt!.Value.ToLocalTime().ToString("MMM d, yyyy").</span>
        }
        Changes saved here will <em>not</em> update the exported invoice — adjust it in QuickBooks or unmark and re-export it from the invoices page.
    </div>
}
@if (Model.IsLocked && Model.Unlocked && Model.CanUnlock)
{
    <div class="alert alert-warning py-2 mb-2">
        <strong>Unlocked for editing.</strong> This order is in production — saved changes update its
        jobs (spec and quantities) immediately. Lines with jobs keep their product; lines without jobs
        can still be changed freely.
    </div>
}
else if (Model.IsLocked)
{
    <div class="alert alert-info py-2 mb-2">
        This order is locked because production has started.
        @if (Model.CanUnlock)
        {
            <span>Use <strong>Unlock to edit</strong> to make changes — they will flow to the jobs.</span>
        }
    </div>
}

<div class="row g-3">
    <div class="col-xl-9">
        @if (Model.IsEditing)
        {
            <form method="post" asp-page-handler="Save" enctype="multipart/form-data" id="sales-order-form">
                <input type="hidden" asp-for="Unlocked" />
                <partial name="_SalesOrderForm" for="Input" />
                <button type="submit" class="btn btn-primary mt-2">Save order</button>
            </form>
        }
        else
        {
            <partial name="_SalesOrderForm" for="Input" />
        }
    </div>

    <div class="col-xl-3 d-flex flex-column gap-2">
        @{
            var firstSendableInvoice = Model.Invoices.FirstOrDefault(i => i.Status != LabelsMis.Domain.Enums.InvoiceStatus.Void);
            var sendableInvoices = Model.Invoices.Where(i => i.Status != LabelsMis.Domain.Enums.InvoiceStatus.Void).ToList();
            var prepayBlocked = Model.RequiresPrepay && !Model.PrepaySatisfied;
        }
        <div class="card">
            <div class="card-header py-1 small fw-semibold">Actions</div>
            <div class="card-body py-2 d-flex flex-column gap-2">
                @if (Model.CanSchedule)
                {
                    @if (prepayBlocked)
                    {
                        <button type="button" class="btn btn-sm btn-success w-100" disabled
                                title="Prepay customer — the order must be paid in full before scheduling.">
                            Schedule for production
                        </button>
                        <div class="small text-muted lh-sm">
                            Prepay customer — @((Model.OrderTotal - Model.AmountPaid).ToString("C2")) still due before this
                            order can be scheduled.
                        </div>
                        <form method="post" asp-page-handler="ScheduleForProduction"
                              onsubmit="return confirm('This prepay order is not paid in full. Force it into production anyway?');">
                            <input type="hidden" name="force" value="true" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Force to production</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ScheduleForProduction">
                            <input type="hidden" name="force" value="false" />
                            <button type="submit" class="btn btn-sm btn-success w-100">Schedule for production</button>
                        </form>
                    }
                }
                @if (Model.CanSendInvoice && firstSendableInvoice is not null)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#invoiceEmailModal">
                        Email invoice to customer
                    </button>
                    <a asp-page-handler="InvoicePdf" asp-route-id="@Model.Id" asp-route-invoiceId="@firstSendableInvoice.Id"
                       class="btn btn-sm btn-outline-secondary w-100">Download invoice</a>
                }
                @if (Model.CanGenerateInvoice)
                {
                    <form method="post" asp-page-handler="GenerateInvoice">
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Generate invoice</button>
                    </form>
                    @if (Model.Invoices.Any())
                    {
                        <div class="small text-muted lh-sm">
                            All invoices on this order are void — generate a replacement at the current prices.
                        </div>
                    }
                }
                <a asp-page-handler="PackingList" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary w-100">Download packing list</a>
            </div>
        </div>

        <div class="card">
            <div class="card-header py-1 small fw-semibold d-flex justify-content-between align-items-center">
                <span>Documents <span class="badge text-bg-secondary">@Model.Documents.Count</span></span>
                @if (Model.CanManageDocuments)
                {
                    <a class="text-decoration-none" data-bs-toggle="collapse" href="#order-document-upload"
                       role="button" aria-expanded="false" aria-controls="order-document-upload"
                       title="Upload a document">+ Add</a>
                }
            </div>
            @if (Model.CanManageDocuments)
            {
                <div class="collapse" id="order-document-upload">
                    <div class="card-body py-2 border-bottom">
                        <form method="post" asp-page-handler="UploadDocument" enctype="multipart/form-data"
                              asp-route-unlocked="@(Model.Unlocked ? "true" : null)">
                            <input asp-for="DocumentFile" type="file" class="form-control form-control-sm"
                                   accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.doc,.docx,.xls,.xlsx,.csv,.txt,.rtf,.eml,.msg,.zip" required />
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100 mt-1">Upload document</button>
                        </form>
                        <div class="form-text lh-sm">External POs or supporting files. Max 50 MB.</div>
                    </div>
                </div>
            }
            @if (Model.Documents.Any())
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var document in Model.Documents)
                    {
                        var sizeLabel = document.SizeBytes >= 1024 * 1024
                            ? $"{document.SizeBytes / (1024m * 1024m):N1} MB"
                            : $"{Math.Max(1, document.SizeBytes / 1024):N0} KB";
                        <li class="list-group-item py-1 d-flex justify-content-between align-items-center gap-1">
                            <span class="text-truncate" title="@document.FileName — uploaded @document.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")">
                                <a asp-page="Edit" asp-page-handler="Document"
                                   asp-route-id="@Model.Id" asp-route-documentId="@document.Id">@document.FileName</a>
                                <span class="text-muted">· @sizeLabel</span>
                            </span>
                            @if (Model.CanManageDocuments)
                            {
                                <form method="post" asp-page-handler="DeleteDocument"
                                      asp-route-documentId="@document.Id"
                                      asp-route-unlocked="@(Model.Unlocked ? "true" : null)"
                                      onsubmit="return confirm('Delete @document.FileName? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete document">&times;</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="card-body py-2 small text-muted">No documents yet.</div>
            }
        </div>

        @if (Model.RequiresPrepay)
        {
            var paidPct = Model.OrderTotal <= 0 ? 100 : (int)Math.Clamp(Math.Round(Model.AmountPaid / Model.OrderTotal * 100m), 0, 100);
            <div class="card">
                <div class="card-header py-1 small fw-semibold d-flex justify-content-between align-items-center">
                    <span>Prepayment</span>
                    <span class="badge @(Model.PrepaySatisfied ? "text-bg-success" : "text-bg-warning")">
                        @(Model.PrepaySatisfied ? "Paid in full" : "Payment due")
                    </span>
                </div>
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Paid</span><span>@Model.AmountPaid.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Order total</span><span>@Model.OrderTotal.ToString("C2")</span>
                    </div>
                    <div class="progress mt-1" style="height: 6px;" role="progressbar" aria-valuenow="@paidPct" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @(Model.PrepaySatisfied ? "bg-success" : "bg-warning")" style="width: @(paidPct)%;"></div>
                    </div>
                    @if (!Model.PrepaySatisfied)
                    {
                        <div class="d-flex justify-content-between small mt-1 fw-semibold">
                            <span>Remaining</span><span>@((Model.OrderTotal - Model.AmountPaid).ToString("C2"))</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between small"><span class="text-muted">Lines</span><span>@lineTotal.ToString("C2")</span></div>
                @if (chargesTotal > 0)
                {
                    <div class="d-flex justify-content-between small"><span class="text-muted">Charges</span><span>@chargesTotal.ToString("C2")</span></div>
                }
                <div class="d-flex justify-content-between small"><span class="text-muted">Shipping</span><span>@((Model.Order?.ShippingCost ?? 0m).ToString("C2"))</span></div>
                <div class="d-flex justify-content-between fw-semibold border-top mt-1 pt-1"><span>Order total</span><span>@orderTotal.ToString("C2")</span></div>
            </div>
        </div>

        @if (Model.LineJobs.Any(j => j.JobId is not null))
        {
            <div class="card">
                <div class="card-header py-1 small fw-semibold">Production jobs</div>
                <ul class="list-group list-group-flush small">
                    @foreach (var lineJob in Model.LineJobs.Where(j => j.JobId is not null))
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between align-items-center gap-1">
                            <span class="text-truncate">
                                <a asp-page="/Jobs/Detail" asp-route-id="@lineJob.JobId">@lineJob.JobNumber</a>
                                <span class="text-muted">· L@(lineJob.LineNumber)</span>
                            </span>
                            <span class="badge text-bg-secondary">@lineJob.JobStatus</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.Shipments.Any())
        {
            <div class="card">
                <div class="card-header py-1 small fw-semibold">Shipments</div>
                <ul class="list-group list-group-flush small">
                    @foreach (var shipment in Model.Shipments)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between align-items-center gap-1">
                            <span class="text-truncate">
                                <a asp-page="/Shipments/Detail" asp-route-id="@shipment.Id">@shipment.ShipmentNumber</a>
                                <span class="text-muted">· @shipment.ShipDate.ToString("MM-dd")</span>
                            </span>
                            <span class="badge text-bg-secondary">@shipment.Status</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.Invoices.Any())
        {
            <div class="card">
                <div class="card-header py-1 small fw-semibold">Invoices</div>
                <ul class="list-group list-group-flush small">
                    @foreach (var invoice in Model.Invoices)
                    {
                        <li class="list-group-item py-1 d-flex justify-content-between align-items-center gap-1">
                            <span class="text-truncate">
                                <a asp-page="/Invoices/Detail" asp-route-id="@invoice.Id">@invoice.InvoiceNumber</a>
                                <span class="text-muted">· @invoice.BalanceDue.ToString("C0") due</span>
                            </span>
                            <span class="text-nowrap">
                                @if (invoice.QbExportedAt is not null)
                                {
                                    <span class="badge text-bg-warning">Exported</span>
                                }
                                <span class="badge text-bg-secondary">@invoice.Status</span>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@{
    var modalInvoices = Model.Invoices.Where(i => i.Status != LabelsMis.Domain.Enums.InvoiceStatus.Void).ToList();
    var modalDefaultInvoice = modalInvoices.FirstOrDefault();
}
@if (Model.CanSendInvoice && modalDefaultInvoice is not null)
{
    <div class="modal fade" id="invoiceEmailModal" tabindex="-1" aria-labelledby="invoiceEmailModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="SendInvoice" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="invoiceEmailModalLabel">Email invoice to customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (modalInvoices.Count > 1)
                    {
                        <div class="mb-3">
                            <label asp-for="SendInvoiceId" class="form-label">Invoice</label>
                            <select asp-for="SendInvoiceId" id="send-invoice-select" class="form-select">
                                @foreach (var invoice in modalInvoices)
                                {
                                    <option value="@invoice.Id" data-number="@invoice.InvoiceNumber">
                                        @invoice.InvoiceNumber — @invoice.Total.ToString("C2") (@invoice.BalanceDue.ToString("C2") due)
                                    </option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="SendInvoiceId" value="@modalDefaultInvoice.Id" />
                        <div class="mb-3 small text-muted">
                            @modalDefaultInvoice.InvoiceNumber — @modalDefaultInvoice.Total.ToString("C2")
                            (@modalDefaultInvoice.BalanceDue.ToString("C2") due)
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="EmailTo" class="form-label">To</label>
                        <input asp-for="EmailTo" type="email" class="form-control" placeholder="Email address" value="@Model.DefaultInvoiceEmail" />
                        @if (Model.CustomerContacts.Count > 0)
                        {
                            <select id="invoice-contact-select" class="form-select form-select-sm mt-2" aria-label="Use a customer contact">
                                <option value="">Use a customer contact…</option>
                                @foreach (var contact in Model.CustomerContacts)
                                {
                                    <option value="@contact.Email">@contact.Name — @contact.Email</option>
                                }
                            </select>
                        }
                        else if (Model.Order is not null)
                        {
                            <a class="btn btn-sm btn-outline-primary mt-2" target="_blank" rel="noopener"
                               href="/customers/edit/@Model.Order.CustomerId">+ Add a contact</a>
                        }
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailSubject" class="form-label">Subject</label>
                        <input asp-for="EmailSubject" class="form-control" value="Invoice @modalDefaultInvoice.InvoiceNumber" data-template="Invoice {number}" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmailBody" class="form-label">Message</label>
                        <textarea name="EmailBody" id="EmailBody" class="form-control" rows="5" data-template="Please find attached invoice {number}.">Please find attached invoice @modalDefaultInvoice.InvoiceNumber.</textarea>
                    </div>
                    <div class="form-check">
                        <input asp-for="IncludePdf" class="form-check-input" />
                        <label asp-for="IncludePdf" class="form-check-label">Include PDF as attachment</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Send email</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/artwork-upload.js" asp-append-version="true"></script>
    <script>
        (function () {
            document.getElementById('invoice-contact-select')?.addEventListener('change', (event) => {
                const select = event.currentTarget;
                const emailToInput = document.getElementById('EmailTo');
                if (select.value && emailToInput) {
                    emailToInput.value = select.value;
                }
                select.selectedIndex = 0;
            });

            // When there are several invoices, keep the default subject/body in sync with the pick.
            document.getElementById('send-invoice-select')?.addEventListener('change', (event) => {
                const number = event.currentTarget.selectedOptions[0]?.dataset.number;
                if (!number) return;
                document.querySelectorAll('#invoiceEmailModal [data-template]').forEach(el => {
                    el.value = el.dataset.template.replace('{number}', number);
                });
            });
        })();
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            LabelsMis.initSalesOrderArtworkUploads(document.getElementById('sales-order-form'));
        });
    </script>
    <partial name="Shared/_ShipToAddressScript" model="@("?handler=Addresses")" />
    <partial name="Shared/_ShippingPriceScript" />
}

@page "/sales-orders/new"
@model LabelsMis.Web.Pages.SalesOrders.CreateModel
@{ ViewData["Title"] = "New sales order"; ViewData["BackNav"] = new BackNavModel(); }
<h1 class="h3 mb-3">New sales order</h1>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<form method="post" enctype="multipart/form-data" id="sales-order-form">
    <partial name="_SalesOrderForm" for="Input" />
    <button type="submit" class="btn btn-primary">Save order</button>
</form>

@section Scripts {
<script src="~/js/artwork-upload.js" asp-append-version="true"></script>
<script src="~/js/so-product-picker.js" asp-append-version="true"></script>
<script>
(() => {
    document.addEventListener('DOMContentLoaded', () => {
        LabelsMis.initSalesOrderArtworkUploads(document.getElementById('sales-order-form'));
    });

    // Create-only: seed the unit price from the product's price breaks when the product or
    // quantity changes. Edits keep the price the order was saved with.
    const updateSuggestedPrice = async (row) => {
        const productId = row.querySelector('.product-select')?.value;
        const qty = row.querySelector('.line-qty')?.value;
        if (!productId || !qty) return;
        const res = await fetch(`?handler=SuggestedPrice&productId=${productId}&quantity=${qty}`);
        const data = await res.json();
        if (data.unitPrice != null) row.querySelector('.line-price').value = data.unitPrice;
    };

    document.addEventListener('change', e => {
        if (e.target.matches('.line-qty, .product-select')) {
            const row = e.target.closest('.order-line');
            if (row) updateSuggestedPrice(row);
        }
    });
})();
</script>
<partial name="Shared/_ShipToAddressScript" model="@("?handler=Addresses")" />
<partial name="Shared/_CustomerNotesScript" model="@("?handler=CustomerNotes")" />
<partial name="Shared/_ProductLineNotesScript" model="@("?handler=ProductNotes")" />
<partial name="Shared/_ShippingPriceScript" />
}

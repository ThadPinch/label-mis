@page "/sales-orders/new"
@model LabelsMis.Web.Pages.SalesOrders.CreateModel
@{ ViewData["Title"] = "New sales order"; ViewData["BackNav"] = new BackNavModel(); }
<h1 class="h3 mb-3">New sales order</h1>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<form method="post" enctype="multipart/form-data" id="sales-order-form">
    <partial name="_SalesOrderForm" for="Input" />
    <button type="submit" class="btn btn-primary">Save order</button>
</form>

@section Scripts {
<script src="~/js/artwork-upload.js" asp-append-version="true"></script>
<script>
(() => {
    document.addEventListener('DOMContentLoaded', () => {
        LabelsMis.initSalesOrderArtworkUploads(document.getElementById('sales-order-form'));
    });

    const customerSelect = document.getElementById('customer-select');
    const productFilterSelect = document.getElementById('product-filter-customer');
    if (!productFilterSelect) return;

    let productsCacheKey = null;
    let productsList = [];

    const getProductFilterKey = () => {
        const value = productFilterSelect.value;
        return value || 'all';
    };

    const buildProductsUrl = () => {
        const key = getProductFilterKey();
        return key === 'all'
            ? '?handler=Products'
            : `?handler=Products&customerId=${encodeURIComponent(key)}`;
    };

    const populateProductSelects = () => {
        document.querySelectorAll('.product-select').forEach(sel => {
            const currentVal = sel.value;
            sel.innerHTML = '<option value="">Select product</option>';
            productsList.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.id;
                opt.textContent = `${p.internalSku} — ${p.description}`;
                if (p.id === currentVal) opt.selected = true;
                sel.appendChild(opt);
            });
        });
    };

    const loadProducts = async () => {
        const cacheKey = getProductFilterKey();
        if (productsCacheKey === cacheKey) {
            populateProductSelects();
            return;
        }

        const response = await fetch(buildProductsUrl());
        if (!response.ok) return;

        productsList = await response.json();
        productsCacheKey = cacheKey;
        populateProductSelects();
    };

    const syncProductFilterToOrderCustomer = () => {
        if (!customerSelect?.value) return;
        const matchingOption = [...productFilterSelect.options].some(o => o.value === customerSelect.value);
        if (matchingOption) {
            productFilterSelect.value = customerSelect.value;
            productsCacheKey = null;
        }
    };

    const updateSuggestedPrice = async (row) => {
        const productId = row.querySelector('.product-select')?.value;
        const qty = row.querySelector('.line-qty')?.value;
        if (!productId || !qty) return;
        const res = await fetch(`?handler=SuggestedPrice&productId=${productId}&quantity=${qty}`);
        const data = await res.json();
        if (data.unitPrice != null) row.querySelector('.line-price').value = data.unitPrice;
    };

    customerSelect?.addEventListener('change', () => {
        syncProductFilterToOrderCustomer();
        loadProducts();
    });

    productFilterSelect.addEventListener('change', () => {
        productsCacheKey = null;
        loadProducts();
    });

    document.querySelectorAll('.line-qty, .product-select').forEach(el => {
        el.addEventListener('change', () => updateSuggestedPrice(el.closest('.order-line')));
    });

    syncProductFilterToOrderCustomer();
    loadProducts();
})();
</script>
<partial name="Shared/_ShipToAddressScript" model="@("?handler=Addresses")" />
<partial name="Shared/_ShippingPriceScript" />
}

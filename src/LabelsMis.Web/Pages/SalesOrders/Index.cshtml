@page "/sales-orders"
@using LabelsMis.Domain.Enums
@model LabelsMis.Web.Pages.SalesOrders.IndexModel
@{
    ViewData["Title"] = "Sales orders";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["Status"] = Model.Status?.ToString(),
        ["CustomerId"] = Model.CustomerId?.ToString(),
        ["ShipFrom"] = Model.ShipFrom?.ToString("yyyy-MM-dd"),
        ["ShipTo"] = Model.ShipTo?.ToString("yyyy-MM-dd"),
        ["Sort"] = Model.Sort
    };
}
<div class="d-flex justify-content-between mb-3">
    <h1 class="h3 mb-0">Sales orders</h1>
    @if (Model.CanEdit) { <a class="btn btn-primary" asp-page="Create">New order</a> }
</div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="row g-2 mb-3 align-items-end">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-3">
        <label asp-for="Search" class="form-label">Search</label>
        <input asp-for="Search" class="form-control" placeholder="Order #, PO #, customer" />
    </div>
    <div class="col-md-2">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<SalesOrderStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["CustomerOptions"]!)">
            <option value="">All customers</option>
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="ShipFrom" class="form-label">Ship from</label>
        <input asp-for="ShipFrom" class="form-control" type="date" />
    </div>
    <div class="col-md-2">
        <label asp-for="ShipTo" class="form-label">Ship to</label>
        <input asp-for="ShipTo" class="form-control" type="date" />
    </div>
    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-page="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<table class="table table-striped-pairs so-list">
    <thead>
    <tr>
        <th class="so-toggle-cell"><span class="visually-hidden">Items</span></th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Order #", "number", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Customer", "customer", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("PO #", "po", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Ship date", "ship", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Status", "status", Model.Sort, route))</th>
        <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Total", "total", Model.Sort, route))</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        var detailId = $"so-lines-{item.Id}";
        <tr>
            <td class="so-toggle-cell">
                <button type="button" class="btn btn-link btn-sm p-0 lh-1 so-toggle"
                        data-lines-toggle="?handler=Lines&id=@item.Id"
                        aria-expanded="false" aria-controls="@detailId"
                        title="Show items" aria-label="Show items on order @item.OrderNumber">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
            </td>
            <td>@item.OrderNumber</td><td>@item.CustomerName</td><td>@(item.CustomerPoNumber ?? "—")</td>
            <td>@(item.RequestedShipDate?.ToString("yyyy-MM-dd") ?? "—")</td><td>@item.Status</td>
            <td>@item.OrderTotal.ToString("C2")</td>
            <td class="text-end text-nowrap">
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a>
                @if (Model.CanEdit)
                {
                    <form method="post" asp-page-handler="Copy" class="d-inline"
                          onsubmit="return confirm('Copy order @item.OrderNumber to a new order? Lines, charges, and shipping details are carried over; the PO number and ship date start blank.');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Copy</button>
                    </form>
                }
                @if (Model.CanDelete && item.Status == SalesOrderStatus.Open)
                {
                    <form method="post" asp-page-handler="Delete" class="d-inline"
                          onsubmit="return confirm('Delete order @item.OrderNumber and all its line items? This cannot be undone.');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
                @if (Model.CanCancel
                    && item.Status != SalesOrderStatus.Cancelled
                    && item.Status != SalesOrderStatus.Closed)
                {
                    <form method="post" asp-page-handler="Cancel" class="d-inline"
                          onsubmit="return confirm('Cancel order @item.OrderNumber? This closes its jobs and voids unpaid invoices.');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-warning">Cancel</button>
                    </form>
                }
            </td>
        </tr>
        @* Expander row: always rendered (so pair-striping stays aligned), shown by the toggle and
           filled with the _SalesOrderLines partial on first open. *@
        <tr id="@detailId" class="so-detail" hidden>
            <td class="so-toggle-cell"></td>
            <td colspan="7" class="pt-0 pb-2">
                <div data-lines-body></div>
            </td>
        </tr>
    }
    @if (Model.Result.Items.Count == 0)
    {
        <tr><td colspan="8" class="text-center text-muted py-4">No sales orders match your filters.</td></tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount)
{
    Extra = route
})

@section Scripts {
    <script src="~/js/sales-order-lines.js" asp-append-version="true"></script>
}

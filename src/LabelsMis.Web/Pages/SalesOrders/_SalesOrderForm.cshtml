@using LabelsMis.Web.Services.Shipping
@model LabelsMis.Web.Pages.SalesOrders.SalesOrderPageInput
@{
    var isLocked = ViewData["IsLocked"] as bool? ?? false;
    var products = (IEnumerable<SelectListItem>?)ViewData["Products"] ?? Enumerable.Empty<SelectListItem>();
    var shippingMethods = (IReadOnlyList<ShippingMethodListItem>?)ViewData["ShippingMethods"] ?? Array.Empty<ShippingMethodListItem>();
}
<div class="row g-3">
    <div class="col-md-4">
        <label class="form-label">Customer</label>
        <select asp-for="CustomerId" id="customer-select" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Customers"]!)" disabled="@isLocked">
            <option value="">Select customer</option>
        </select>
    </div>
    <div class="col-md-4"><label asp-for="CustomerPoNumber" class="form-label">Customer PO #</label><input asp-for="CustomerPoNumber" class="form-control" readonly="@isLocked" /></div>
    <div class="col-md-4"><label asp-for="RequestedShipDate" class="form-label">Requested ship date</label><input asp-for="RequestedShipDate" type="date" class="form-control" readonly="@isLocked" /></div>
    <div class="col-12"><label asp-for="Notes" class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" readonly="@isLocked"></textarea></div>
</div>

<fieldset class="border rounded p-3 mt-4 order-shipping" id="order-shipping">
    <legend class="float-none w-auto px-2 h6 mb-0">Shipping</legend>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="ShippingMethodId" class="form-label">Method</label>
            <select asp-for="ShippingMethodId" id="shipping-method-select" class="form-select" disabled="@isLocked">
                <option value="" data-price="0" data-requires-address="true">No shipping</option>
                @foreach (var m in shippingMethods)
                {
                    <option value="@m.Id" data-price="@m.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-requires-address="@m.RequiresAddress.ToString().ToLowerInvariant()"
                            selected="@(m.Id == Model.ShippingMethodId)">
                        @m.Name — @m.Price.ToString("C2")@(m.IsActive ? "" : " (inactive)")
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ShippingCost" class="form-label">Price</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="ShippingCost" id="shipping-cost-input" class="form-control" readonly="@isLocked" />
            </div>
            <span asp-validation-for="ShippingCost" class="text-danger"></span>
        </div>
        @if (!isLocked)
        {
            <div class="col-md-6 shipto-group">
                <label for="shipto-source" class="form-label">Ship-to address</label>
                <select id="shipto-source" class="form-select">
                    <option value="custom">Enter manually</option>
                </select>
                <div class="form-text">Pull a billing or shipping address from the customer, or enter one below.</div>
            </div>
        }
        <div class="col-md-6 shipto-group"><label asp-for="ShipToName" class="form-label">Recipient / company</label><input asp-for="ShipToName" class="form-control shipto-field" readonly="@isLocked" /></div>
        <div class="col-md-6 shipto-group"><label asp-for="ShipToStreet1" class="form-label">Street</label><input asp-for="ShipToStreet1" class="form-control shipto-field" readonly="@isLocked" /></div>
        <div class="col-md-6 shipto-group"><label asp-for="ShipToStreet2" class="form-label">Street 2</label><input asp-for="ShipToStreet2" class="form-control shipto-field" readonly="@isLocked" /></div>
        <div class="col-md-3 shipto-group"><label asp-for="ShipToCity" class="form-label">City</label><input asp-for="ShipToCity" class="form-control shipto-field" readonly="@isLocked" /></div>
        <div class="col-md-1 shipto-group"><label asp-for="ShipToState" class="form-label">State</label><input asp-for="ShipToState" class="form-control shipto-field" readonly="@isLocked" /></div>
        <div class="col-md-2 shipto-group"><label asp-for="ShipToZip" class="form-label">Zip</label><input asp-for="ShipToZip" class="form-control shipto-field" readonly="@isLocked" /></div>
    </div>
</fieldset>

<h2 class="h5 mt-4">Line items</h2>
@if (ViewData["ShowProductFilter"] as bool? == true)
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label for="product-filter-customer" class="form-label">Pull from existing product — customer</label>
            <select id="product-filter-customer" class="form-select">
                <option value="">All products</option>
                @foreach (var customer in (IEnumerable<SelectListItem>)ViewData["Customers"]!)
                {
                    <option value="@customer.Value">@customer.Text</option>
                }
            </select>
            <div class="form-text">Filter product choices on each line. Defaults to the order customer when selected.</div>
        </div>
    </div>
}
<div class="row g-2 mb-1 text-muted small">
    <div class="col-md-4">Product</div>
    <div class="col-md-2">Qty</div>
    <div class="col-md-2">Unit price</div>
    <div class="col-md-2">Artwork</div>
    <div class="col-md-2">Line notes</div>
</div>
@for (var i = 0; i < Model.Lines.Count; i++)
{
    var line = Model.Lines[i];
    <div class="row g-2 mb-2 order-line">
        <div class="col-md-4">
            <select asp-for="Lines[@i].ProductId" class="form-select product-select" asp-items="products" disabled="@isLocked"><option value="">Select product</option></select>
        </div>
        <div class="col-md-2"><input name="Input.Lines[@i].Quantity" value="@line.Quantity" class="form-control line-qty" readonly="@isLocked" /></div>
        <div class="col-md-2"><input name="Input.Lines[@i].UnitPrice" value="@line.UnitPrice" class="form-control line-price" readonly="@isLocked" /></div>
        <div class="col-md-2 artwork-upload-cell">
            @if (line.HasArtwork && line.ProductId != Guid.Empty)
            {
                <a asp-page="/Artwork/Download" asp-route-productId="@line.ProductId" target="_blank" class="small d-block mb-1 artwork-download-link">Download</a>
            }
            @if (!isLocked)
            {
                <input type="file" name="Input.Lines[@i].ArtworkFile" class="form-control form-control-sm artwork-file-input" accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.tif,.tiff" />
                <div class="artwork-upload-status d-none">
                    <div class="progress mt-1" style="height: 6px;">
                        <div class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="small artwork-upload-message mt-1 text-muted"></div>
                </div>
            }
        </div>
        <div class="col-md-2"><input name="Input.Lines[@i].LineNotes" value="@line.LineNotes" class="form-control" placeholder="Notes" readonly="@isLocked" /></div>
    </div>
}

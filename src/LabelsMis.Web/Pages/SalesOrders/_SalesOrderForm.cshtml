@using LabelsMis.Domain.Entities
@using LabelsMis.Domain.Enums
@using LabelsMis.Web.Services.Shipping
@using LabelsMis.Web.Pages.SalesOrders
@using LabelsMis.Web.Pages.Shared
@model LabelsMis.Web.Pages.SalesOrders.SalesOrderPageInput
@{
    var isLocked = ViewData["IsLocked"] as bool? ?? false;
    var outsourceVendors = (IEnumerable<SelectListItem>?)ViewData["OutsourceVendors"] ?? Enumerable.Empty<SelectListItem>();
    const string outsourceLineHint = "The job for this line is routed to the vendor instead of the press and moves to ready-to-ship when received. Track it on Production → Outsourced.";
    var products = (IEnumerable<SelectListItem>?)ViewData["Products"] ?? Enumerable.Empty<SelectListItem>();
    var shippingMethods = (IReadOnlyList<ShippingMethodListItem>?)ViewData["ShippingMethods"] ?? Array.Empty<ShippingMethodListItem>();
    var substrates = (IEnumerable<SelectListItem>?)ViewData["Substrates"] ?? Enumerable.Empty<SelectListItem>();
    var dies = (IReadOnlyList<Die>?)ViewData["Dies"] ?? Array.Empty<Die>();
    var spotInks = ((IEnumerable<SelectListItem>?)ViewData["SpotInks"] ?? Enumerable.Empty<SelectListItem>()).ToList();
    var finishingOps = ((IReadOnlyList<FinishingOperation>?)ViewData["FinishingOperations"] ?? Array.Empty<FinishingOperation>()).ToList();
    var finishingStocks = ((IEnumerable<SelectListItem>?)ViewData["FinishingStocks"] ?? Enumerable.Empty<SelectListItem>()).ToList();
    var shrinkStocks = (IReadOnlyDictionary<Guid, decimal?>?)ViewData["ShrinkStocks"] ?? new Dictionary<Guid, decimal?>();
}
<script type="application/json" id="shrink-stocks-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(shrinkStocks))</script>
<script type="application/json" id="so-finishing-ops-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(finishingOps.Select(o => new { id = o.Id, code = o.Code, description = o.Description, category = o.OperationType.ToString(), setupMinutes = o.DefaultSetupMinutes, runSpeedFpm = o.DefaultRunSpeedFpm })))</script>
<script type="application/json" id="so-dies-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(dies.Select(d => new { id = d.Id, description = d.Description, setupRating = d.SetupRating, speedRating = d.SpeedRating })))</script>
<script type="application/json" id="so-finishing-stocks-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(finishingStocks.Select(s => new { id = s.Value, label = s.Text })))</script>

<div class="row g-2">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header py-1 small fw-semibold">Order</div>
            <div class="card-body py-2">
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small mb-0">Customer</label>
                        <select asp-for="CustomerId" id="customer-select" class="form-select form-select-sm" asp-items="@((IEnumerable<SelectListItem>)ViewData["Customers"]!)" disabled="@isLocked">
                            <option value="">Select customer</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerPoNumber" class="form-label small mb-0">Customer PO #</label>
                        <input asp-for="CustomerPoNumber" class="form-control form-control-sm" readonly="@isLocked" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RequestedShipDate" class="form-label small mb-0">Requested ship date</label>
                        <input asp-for="RequestedShipDate" type="date" class="form-control form-control-sm" readonly="@isLocked" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label small mb-0">Notes</label>
                        <textarea asp-for="Notes" class="form-control form-control-sm" rows="3" readonly="@isLocked"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="BillingNotes" class="form-label small mb-0">Billing notes</label>
                        <textarea asp-for="BillingNotes" class="form-control form-control-sm" rows="2" readonly="@isLocked"></textarea>
                        <div class="form-text">Internal — never printed.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100" id="order-shipping">
            <div class="card-header py-1 small fw-semibold">Shipping</div>
            <div class="card-body py-2">
                <div class="row g-2">
                    <div class="col-md-7">
                        <label asp-for="ShippingMethodId" class="form-label small mb-0">Method</label>
                        <select asp-for="ShippingMethodId" id="shipping-method-select" class="form-select form-select-sm" disabled="@isLocked">
                            <option value="" data-price="0" data-requires-address="true">No shipping</option>
                            @foreach (var m in shippingMethods)
                            {
                                <option value="@m.Id" data-price="@m.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-requires-address="@m.RequiresAddress.ToString().ToLowerInvariant()"
                                        selected="@(m.Id == Model.ShippingMethodId)">
                                    @m.Name — @m.Price.ToString("C2")@(m.IsActive ? "" : " (inactive)")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="ShippingCost" class="form-label small mb-0">Price</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">$</span>
                            <input asp-for="ShippingCost" id="shipping-cost-input" class="form-control" readonly="@isLocked" />
                        </div>
                        <span asp-validation-for="ShippingCost" class="text-danger small"></span>
                    </div>
                    @if (!isLocked)
                    {
                        <div class="col-12 shipto-group">
                            <label for="shipto-source" class="form-label small mb-0">Ship-to address</label>
                            <select id="shipto-source" class="form-select form-select-sm">
                                <option value="custom">Enter manually</option>
                            </select>
                        </div>
                    }
                    <div class="col-md-6 shipto-group">
                        <label asp-for="ShipToName" class="form-label small mb-0">Recipient / company</label>
                        <input asp-for="ShipToName" class="form-control form-control-sm shipto-field" readonly="@isLocked" />
                    </div>
                    <div class="col-md-6 shipto-group">
                        <label asp-for="ShipToStreet1" class="form-label small mb-0">Street</label>
                        <input asp-for="ShipToStreet1" class="form-control form-control-sm shipto-field" readonly="@isLocked" />
                    </div>
                    <div class="col-md-4 shipto-group">
                        <label asp-for="ShipToStreet2" class="form-label small mb-0">Street 2</label>
                        <input asp-for="ShipToStreet2" class="form-control form-control-sm shipto-field" readonly="@isLocked" />
                    </div>
                    <div class="col-md-4 shipto-group">
                        <label asp-for="ShipToCity" class="form-label small mb-0">City</label>
                        <input asp-for="ShipToCity" class="form-control form-control-sm shipto-field" readonly="@isLocked" />
                    </div>
                    <div class="col-md-2 shipto-group">
                        <label asp-for="ShipToState" class="form-label small mb-0">State</label>
                        <input asp-for="ShipToState" class="form-control form-control-sm shipto-field" readonly="@isLocked" />
                    </div>
                    <div class="col-md-2 shipto-group">
                        <label asp-for="ShipToZip" class="form-label small mb-0">Zip</label>
                        <input asp-for="ShipToZip" class="form-control form-control-sm shipto-field" readonly="@isLocked" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<h2 class="h6 mt-3 mb-1">Line items</h2>
@if (ViewData["ShowProductFilter"] as bool? == true)
{
    <div class="row g-2 mb-2">
        <div class="col-md-5">
            <select id="product-filter-customer" class="form-select form-select-sm">
                <option value="">Pull products from: all customers</option>
                @foreach (var customer in (IEnumerable<SelectListItem>)ViewData["Customers"]!)
                {
                    <option value="@customer.Value">Pull products from: @customer.Text</option>
                }
            </select>
        </div>
    </div>
}
<div id="order-lines">
@for (var i = 0; i < Model.Lines.Count; i++)
{
    var line = Model.Lines[i];
    var collapseId = $"order-line-spec-{i}";
    var hasSpec = !string.IsNullOrWhiteSpace(line.SpecJson);
    var productLocked = isLocked || line.HasJob;
    var lineTotal = line.Quantity * line.UnitPrice;
    <div class="card mb-2 order-line" data-line-index="@i">
        <div class="card-header py-1 px-2 d-flex align-items-center gap-2">
            <span class="fw-semibold small order-line-label">Line @(i + 1)</span>
            @if (line.HasJob)
            {
                <span class="badge text-bg-secondary" title="This line has a production job — the product is pinned.">@(line.JobNumber ?? "In production")</span>
            }
            @if (line.IsOutsourced)
            {
                <span class="badge text-bg-info">Outsourced@(line.OutsourceStatusLabel is { } osl ? $" · {osl}" : "")</span>
            }
            <span class="ms-auto small text-muted">@line.Quantity.ToString("N0") × @line.UnitPrice.ToString("C4")</span>
            <span class="small fw-semibold">@lineTotal.ToString("C2")</span>
            @if (!isLocked && !line.HasJob)
            {
                <button type="button" class="btn btn-sm btn-outline-danger order-line-remove" aria-label="Remove line" title="Remove line">×</button>
            }
        </div>
        <div class="card-body py-2">
            <input type="hidden" name="Input.Lines[@i].Id" value="@(line.Id?.ToString())" />
            <input type="hidden" name="Input.Lines[@i].SourceEstimateLineId" value="@(line.SourceEstimateLineId?.ToString())" />
            <input type="hidden" name="Input.Lines[@i].SpecJson" value="@line.SpecJson" />
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-0">Product</label>
                    <select asp-for="Lines[@i].ProductId" class="form-select form-select-sm product-select" asp-items="products" disabled="@productLocked"><option value="">Select product</option></select>
                    @if (line.HasJob)
                    {
                        <input type="hidden" name="Input.Lines[@i].ProductId" value="@line.ProductId" />
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">Description</label>
                    <input name="Input.Lines[@i].Description" value="@line.Description" class="form-control form-control-sm" placeholder="As quoted" readonly="@isLocked" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label small mb-0">Qty</label>
                    <input name="Input.Lines[@i].Quantity" value="@line.Quantity" class="form-control form-control-sm line-qty" readonly="@isLocked" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label small mb-0">Unit price</label>
                    <input name="Input.Lines[@i].UnitPrice" value="@line.UnitPrice" class="form-control form-control-sm line-price" readonly="@isLocked" />
                </div>
                <div class="col-md-2 artwork-upload-cell">
                    <label class="form-label small mb-0">Artwork</label>
                    @if (line.HasArtwork && line.ProductId != Guid.Empty)
                    {
                        <a asp-page="/Artwork/Download" asp-route-productId="@line.ProductId" target="_blank" class="small d-block text-truncate artwork-download-link"
                           title="@line.ArtworkFileName">@(line.ArtworkFileName ?? "Download")</a>
                    }
                    @if (!isLocked)
                    {
                        <input type="file" name="Input.Lines[@i].ArtworkFile" class="form-control form-control-sm artwork-file-input" accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.tif,.tiff" />
                        <div class="artwork-upload-status d-none">
                            <div class="progress mt-1" style="height: 6px;">
                                <div class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="small artwork-upload-message mt-1 text-muted"></div>
                        </div>
                    }
                </div>
                <div class="col-12">
                    <label class="form-label small mb-0">Line notes</label>
                    <textarea name="Input.Lines[@i].LineNotes" class="form-control form-control-sm" rows="2" placeholder="Notes" readonly="@isLocked">@line.LineNotes</textarea>
                </div>
            </div>

            <div class="mt-2 order-line-outsource">
                <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel($"Input.Lines[{i}]", outsourceVendors)
                {
                    IsOutsourced = line.IsOutsourced,
                    VendorId = line.OutsourceVendorId,
                    QuoteNumber = line.OutsourceQuoteNumber,
                    VendorCost = line.OutsourceCost,
                    ExpectedIn = line.OutsourceExpectedIn,
                    PrivateNotes = line.OutsourcePrivateNotes,
                    ReadOnly = isLocked,
                    ToggleLocked = line.OutsourceLocked,
                    StatusLabel = line.OutsourceStatusLabel,
                    ToggleLabel = "Outsource this line",
                    CostInputClass = "order-line-outsource-cost",
                    MarginReadoutClass = "order-line-outsource-margin",
                    Hint = outsourceLineHint
                })" />
            </div>

            @if (!hasSpec && !isLocked)
            {
                <div class="form-text mt-1">Spec is seeded from the product when the order is saved; reopen the order to edit it.</div>
            }
        </div>
        @if (hasSpec)
        {
            var chips = new List<string>();
            if (line.LabelAcrossIn is { } sizeAcross && line.LabelAroundIn is { } sizeAround)
            {
                chips.Add($"{sizeAcross:0.###}″ × {sizeAround:0.###}″");
            }
            var substrateText = substrates.FirstOrDefault(s => s.Value == line.SubstrateId?.ToString())?.Text;
            if (substrateText is not null)
            {
                chips.Add(substrateText.Split(" — ")[0]);
            }
            if (line.InkSet is { } inkSet)
            {
                chips.Add(inkSet + (line.Spots.Count > 0 ? $" +{line.Spots.Count} spot{(line.Spots.Count == 1 ? "" : "s")}" : ""));
            }
            if (line.Unwind is { } unwindChip)
            {
                chips.Add($"Unwind #{(int)unwindChip}");
            }
            if (line.ShrinkLayflatIn is { } layflatChip)
            {
                chips.Add($"Layflat {layflatChip:0.####}″");
            }
            chips.Add(line.Finishing.Count == 0
                ? "No finishing"
                : $"{line.Finishing.Count} finishing op{(line.Finishing.Count == 1 ? "" : "s")}");

            <input type="hidden" name="Input.Lines[@i].SpecEdited" value="true" />
            <button type="button" class="spec-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                <svg class="spec-chevron" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.5 3.5 10 8l-4.5 4.5V3.5z"/></svg>
                <span class="fw-semibold">Spec &amp; finishing</span>
                <span class="spec-chips">
                    @foreach (var chip in chips)
                    {
                        <span class="spec-chip">@chip</span>
                    }
                </span>
            </button>
            <div class="collapse" id="@collapseId">
                <div class="spec-body">
                    <div class="spec-section">
                        <div class="spec-section-title">Dimensions</div>
                        <div class="row g-2">
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Across (in)</label>
                                <input name="Input.Lines[@i].LabelAcrossIn" value="@(line.LabelAcrossIn?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Around (in)</label>
                                <input name="Input.Lines[@i].LabelAroundIn" value="@(line.LabelAroundIn?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Corner radius</label>
                                <input name="Input.Lines[@i].CornerRadiusIn" value="@(line.CornerRadiusIn?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Gutter across</label>
                                <input name="Input.Lines[@i].GutterAcrossIn" value="@(line.GutterAcrossIn?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Gutter around</label>
                                <input name="Input.Lines[@i].GutterAroundIn" value="@(line.GutterAroundIn?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Bleed</label>
                                <input name="Input.Lines[@i].BleedIn" value="@(line.BleedIn?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                        </div>
                    </div>

                    <div class="spec-section">
                        <div class="spec-section-title">Material &amp; tooling</div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Substrate</label>
                                <select name="Input.Lines[@i].SubstrateId" class="form-select form-select-sm spec-substrate-select" disabled="@isLocked">
                                    <option value="">Select substrate</option>
                                    @foreach (var s in substrates)
                                    {
                                        <option value="@s.Value" selected="@(s.Value == line.SubstrateId?.ToString())">@s.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Die</label>
                                <select name="Input.Lines[@i].DieId" class="form-select form-select-sm so-line-die" disabled="@isLocked">
                                    <option value="">No die assigned</option>
                                    @foreach (var d in dies)
                                    {
                                        <option value="@d.Id" selected="@(d.Id == line.DieId)">@d.Description</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 shrink-layflat-group @(line.SubstrateId is { } specShrinkSub && shrinkStocks.ContainsKey(specShrinkSub) ? "" : "d-none")">
                                <label class="form-label small mb-0">Shrink layflat (in)</label>
                                <input name="Input.Lines[@i].ShrinkLayflatIn" value="@(line.ShrinkLayflatIn?.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture))" class="form-control form-control-sm shrink-layflat-input" readonly="@isLocked" />
                            </div>
                        </div>
                    </div>

                    <div class="spec-section">
                        <div class="spec-section-title">Inks</div>
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Ink set</label>
                                <select name="Input.Lines[@i].InkSet" class="form-select form-select-sm inkset-select" disabled="@isLocked">
                                    @foreach (var v in Enum.GetValues<InkSet>())
                                    {
                                        <option value="@((int)v)" selected="@(v == line.InkSet)">@v</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-1 white-ink-group @(line.InkSet is InkSet.CMYKW or InkSet.CMYKW_PlusSpot or InkSet.EPMW ? "" : "d-none")">
                                <label class="form-label small mb-0">White hits</label>
                                <select name="Input.Lines[@i].WhiteHits" class="form-select form-select-sm" disabled="@isLocked">
                                    @for (var h = 0; h <= 3; h++)
                                    {
                                        <option value="@h" selected="@(h == (line.WhiteHits ?? 0))">@h</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-1 white-ink-group @(line.InkSet is InkSet.CMYKW or InkSet.CMYKW_PlusSpot or InkSet.EPMW ? "" : "d-none")">
                                <label class="form-label small mb-0">White %</label>
                                <input name="Input.Lines[@i].WhiteCoveragePct" value="@(line.WhiteCoveragePct?.ToString("0"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>

                            <div class="col-12 spot-ink-group @(line.InkSet is InkSet.CMYK_PlusSpot or InkSet.CMYKW_PlusSpot ? "" : "d-none")">
                                <label class="form-label small mb-0 d-block">Spot colors</label>
                                <div class="spot-rows">
                                    @for (var j = 0; j < line.Spots.Count; j++)
                                    {
                                        var spot = line.Spots[j];
                                        <div class="row g-1 mb-1 spot-row align-items-center">
                                            <div class="col-md-4">
                                                <select name="Input.Lines[@i].Spots[@j].InkId" class="form-select form-select-sm spot-ink" disabled="@isLocked">
                                                    <option value="">Select spot color</option>
                                                    @foreach (var ink in spotInks)
                                                    {
                                                        <option value="@ink.Value" selected="@(ink.Value == spot.InkId.ToString())">@ink.Text</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4 col-md-2">
                                                <select name="Input.Lines[@i].Spots[@j].Hits" class="form-select form-select-sm spot-hits" disabled="@isLocked">
                                                    @for (var h = 1; h <= 3; h++)
                                                    {
                                                        <option value="@h" selected="@(h == spot.Hits)">@h hit@(h == 1 ? "" : "s")</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4 col-md-2">
                                                <div class="input-group input-group-sm">
                                                    <input name="Input.Lines[@i].Spots[@j].CoveragePct" value="@spot.CoveragePct.ToString("0")" class="form-control spot-coverage" readonly="@isLocked" />
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                            @if (!isLocked)
                                            {
                                                <div class="col-4 col-md-1">
                                                    <button type="button" class="btn btn-sm btn-outline-danger spot-remove">×</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (!isLocked)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary spot-add" data-line-index="@i">Add spot color</button>
                                }
                            </div>

                        </div>
                    </div>

                    <div class="spec-section">
                        <div class="spec-section-title">Finishing</div>
                        @if (!isLocked)
                        {
                            <div class="finishing-builder row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Category</label>
                                    <select class="form-select form-select-sm so-finishing-category">
                                        <option value="">Select category</option>
                                        @foreach (var cat in finishingOps.Select(o => o.OperationType).Distinct())
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label small mb-0">Operation</label>
                                    <select class="form-select form-select-sm so-finishing-operation" disabled>
                                        <option value="">Select operation</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary so-finishing-add w-100" disabled>Add operation</button>
                                </div>
                            </div>
                        }
                        <div class="so-finishing-selected mt-2">
                            @for (var j = 0; j < line.Finishing.Count; j++)
                            {
                                var selection = line.Finishing[j];
                                var op = finishingOps.FirstOrDefault(o => o.Id == selection.OperationId);
                                <div class="finishing-item border rounded p-2 mb-2" data-op-id="@selection.OperationId">
                                    <input type="hidden" name="Input.Lines[@i].Finishing[@j].OperationId" value="@selection.OperationId" />
                                    <input type="hidden" name="Input.Lines[@i].Finishing[@j].Include" value="true" />
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <div class="text-truncate">
                                            <span class="fw-semibold small">@(op is null ? selection.OperationId.ToString() : $"{op.Code} — {op.Description}")</span>
                                            @if (op is not null)
                                            {
                                                <span class="badge text-bg-secondary ms-1">@op.OperationType</span>
                                            }
                                        </div>
                                        @if (!isLocked)
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 so-finishing-remove">Remove</button>
                                        }
                                    </div>
                                    <div class="row g-2 mt-0">
                                        @if (op?.OperationType is FinishingOperationType.DieCut)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label small mb-0">Die</label>
                                                <select name="Input.Lines[@i].Finishing[@j].DieId" class="form-select form-select-sm so-finishing-die" disabled="@isLocked">
                                                    <option value="">No die</option>
                                                    @foreach (var d in dies)
                                                    {
                                                        <option value="@d.Id" selected="@(d.Id == selection.DieId)">@d.Description</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="Input.Lines[@i].Finishing[@j].DieId" value="@(selection.DieId?.ToString())" />
                                        }
                                        <div class="col-6 col-md-3">
                                            <label class="form-label small mb-0">Setup (min)</label>
                                            <input name="Input.Lines[@i].Finishing[@j].SetupMinutesOverride" value="@(selection.SetupMinutesOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="@op?.DefaultSetupMinutes.ToString("0.##")" class="form-control form-control-sm" readonly="@isLocked" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label small mb-0">Speed (fpm)</label>
                                            <input name="Input.Lines[@i].Finishing[@j].RunSpeedFpmOverride" value="@(selection.RunSpeedFpmOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="@op?.DefaultRunSpeedFpm.ToString("0.##")" class="form-control form-control-sm" readonly="@isLocked" />
                                        </div>
                                        @if (op?.OperationType is FinishingOperationType.Laminate or FinishingOperationType.Foil)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label small mb-0">Material stock</label>
                                                <select name="Input.Lines[@i].Finishing[@j].StockId" class="form-select form-select-sm" disabled="@isLocked">
                                                    <option value="">Select stock</option>
                                                    @foreach (var stock in finishingStocks)
                                                    {
                                                        <option value="@stock.Value" selected="@(stock.Value == selection.StockId?.ToString())">@stock.Text</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="Input.Lines[@i].Finishing[@j].StockId" value="@(selection.StockId?.ToString())" />
                                        }
                                    </div>
                                </div>
                            }
                            @if (line.Finishing.Count == 0)
                            {
                                <div class="text-muted small so-finishing-empty">No finishing operations.</div>
                            }
                        </div>
                    </div>

                    <div class="spec-section">
                        <div class="spec-section-title">Waste &amp; imposition</div>
                        <div class="row g-2">
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Setup waste (imp)</label>
                                <input name="Input.Lines[@i].SetupWasteImpressions" value="@(line.SetupWasteImpressions?.ToString("0.##"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Running waste %</label>
                                <input name="Input.Lines[@i].RunningWastePct" value="@(line.RunningWastePct?.ToString("0.####"))" class="form-control form-control-sm" readonly="@isLocked" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Labels across</label>
                                <select name="Input.Lines[@i].MaxLabelsAcrossOverride" class="form-select form-select-sm" disabled="@isLocked">
                                    <option value="" selected="@(!line.MaxLabelsAcrossOverride.HasValue)">Auto</option>
                                    @for (var n = 1; n <= 12; n++)
                                    {
                                        <option value="@n" selected="@(line.MaxLabelsAcrossOverride == n)">@n up</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small mb-0">Orientation</label>
                                <select name="Input.Lines[@i].LabelOrientationOverride" class="form-select form-select-sm" disabled="@isLocked">
                                    <option value="" selected="@(!line.LabelOrientationOverride.HasValue)">Auto</option>
                                    <option value="@((int)LabelOrientation.AsEntered)" selected="@(line.LabelOrientationOverride == LabelOrientation.AsEntered)">As entered</option>
                                    <option value="@((int)LabelOrientation.Rotated)" selected="@(line.LabelOrientationOverride == LabelOrientation.Rotated)">Rotated 90°</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Unwind direction</label>
                                <select name="Input.Lines[@i].Unwind" class="form-select form-select-sm" disabled="@isLocked">
                                    <option value="" selected="@(!line.Unwind.HasValue)">Not specified</option>
                                    @foreach (var unwind in Enum.GetValues<UnwindDirection>())
                                    {
                                        <option value="@((int)unwind)" selected="@(line.Unwind == unwind)">@unwind.Label()</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>

@if (!isLocked)
{
    <button type="button" id="add-order-line" class="btn btn-sm btn-outline-secondary mb-2">+ Add line</button>

    <template id="order-line-row-template">
        <div class="card mb-2 order-line" data-line-index="__LINE__">
            <div class="card-header py-1 px-2 d-flex align-items-center gap-2">
                <span class="fw-semibold small order-line-label">Line</span>
                <button type="button" class="btn btn-sm btn-outline-danger ms-auto order-line-remove" aria-label="Remove line" title="Remove line">×</button>
            </div>
            <div class="card-body py-2">
                <input type="hidden" name="Input.Lines[__LINE__].Id" value="" />
                <input type="hidden" name="Input.Lines[__LINE__].SourceEstimateLineId" value="" />
                <input type="hidden" name="Input.Lines[__LINE__].SpecJson" value="" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Product</label>
                        <select name="Input.Lines[__LINE__].ProductId" class="form-select form-select-sm product-select">
                            <option value="">Select product</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.Value">@p.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Description</label>
                        <input name="Input.Lines[__LINE__].Description" value="" class="form-control form-control-sm" placeholder="As quoted" />
                    </div>
                    <div class="col-6 col-md-1">
                        <label class="form-label small mb-0">Qty</label>
                        <input name="Input.Lines[__LINE__].Quantity" value="1000" class="form-control form-control-sm line-qty" />
                    </div>
                    <div class="col-6 col-md-1">
                        <label class="form-label small mb-0">Unit price</label>
                        <input name="Input.Lines[__LINE__].UnitPrice" value="0" class="form-control form-control-sm line-price" />
                    </div>
                    <div class="col-md-2 artwork-upload-cell">
                        <label class="form-label small mb-0">Artwork</label>
                        <input type="file" name="Input.Lines[__LINE__].ArtworkFile" class="form-control form-control-sm artwork-file-input" accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.tif,.tiff" />
                        <div class="artwork-upload-status d-none">
                            <div class="progress mt-1" style="height: 6px;">
                                <div class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="small artwork-upload-message mt-1 text-muted"></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-0">Line notes</label>
                        <textarea name="Input.Lines[__LINE__].LineNotes" class="form-control form-control-sm" rows="2" placeholder="Notes"></textarea>
                    </div>
                </div>
                <div class="mt-2 order-line-outsource">
                    <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel("Input.Lines[__LINE__]", outsourceVendors)
                    {
                        ToggleLabel = "Outsource this line",
                        CostInputClass = "order-line-outsource-cost",
                        MarginReadoutClass = "order-line-outsource-margin",
                        Hint = outsourceLineHint
                    })" />
                </div>
                <div class="form-text mt-1">Spec is seeded from the product when the order is saved; reopen the order to edit it.</div>
            </div>
        </div>
    </template>
    <script>
        (function () {
            const container = document.getElementById('order-lines');
            const addBtn = document.getElementById('add-order-line');
            const template = document.getElementById('order-line-row-template');
            if (!container || !addBtn || !template) return;

            const reindexLines = () => {
                const rows = container.querySelectorAll('.order-line');
                rows.forEach((lineEl, index) => {
                    lineEl.dataset.lineIndex = index;
                    const label = lineEl.querySelector('.order-line-label');
                    if (label) label.textContent = `Line ${index + 1}`;
                    lineEl.querySelectorAll('[name]').forEach(input => {
                        input.name = input.name.replace(/Lines\[\d+\]|Lines\[__LINE__\]/, `Lines[${index}]`);
                    });
                    // At least one line is required, so the sole remaining row keeps its remove button hidden.
                    const removeBtn = lineEl.querySelector('.order-line-remove');
                    if (removeBtn) removeBtn.classList.toggle('d-none', rows.length === 1);
                });
            };

            addBtn.addEventListener('click', () => {
                const row = template.content.firstElementChild.cloneNode(true);
                container.appendChild(row);
                reindexLines();
                document.dispatchEvent(new CustomEvent('order-line-added', { detail: { row } }));
            });

            container.addEventListener('click', e => {
                const removeBtn = e.target.closest('.order-line-remove');
                if (!removeBtn) return;
                if (container.querySelectorAll('.order-line').length <= 1) return;
                removeBtn.closest('.order-line')?.remove();
                reindexLines();
            });

            reindexLines();
        })();
    </script>
}

@if (!isLocked || Model.Charges.Count > 0)
{
    <h2 class="h6 mt-3 mb-1">Additional charges</h2>
    <div class="card mb-2">
        <div class="card-body py-2">
            @if (!isLocked)
            {
                <div class="form-text mb-2">One-time charges (die creation, design time) and <strong>outsourced items</strong> — promo products, printed pieces, wide format — bought from a vendor. Billed on the invoice and shown on the job ticket; never scheduled as production jobs. Outsourced items are tracked and received on Production → Outsourced.</div>
            }
            <div id="order-charges">
                @for (var c = 0; c < Model.Charges.Count; c++)
                {
                    var charge = Model.Charges[c];
                    <div class="row g-2 align-items-end mb-2 order-charge-row">
                        @if (charge.Id.HasValue)
                        {
                            <input type="hidden" name="Input.Charges[@c].Id" value="@charge.Id" />
                        }
                        @if (charge.SourceEstimateChargeId.HasValue)
                        {
                            <input type="hidden" name="Input.Charges[@c].SourceEstimateChargeId" value="@charge.SourceEstimateChargeId" />
                        }
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Description</label>
                            <input name="Input.Charges[@c].Description" value="@charge.Description" list="order-charge-presets"
                                   class="form-control form-control-sm order-charge-desc" readonly="@isLocked" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small mb-0">Qty</label>
                            <input name="Input.Charges[@c].Quantity" value="@charge.Quantity" class="form-control form-control-sm order-charge-qty" readonly="@isLocked" />
                        </div>
                        <div class="col-4 col-md-2">
                            <label class="form-label small mb-0">Unit price</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">$</span>
                                <input name="Input.Charges[@c].UnitPrice" value="@charge.UnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control order-charge-price" readonly="@isLocked" />
                            </div>
                        </div>
                        <div class="col-4 col-md-2 d-flex align-items-center justify-content-between gap-2 pb-1">
                            <span class="small fw-semibold order-charge-total">@((charge.UnitPrice * charge.Quantity).ToString("C2"))</span>
                            @if (!isLocked && !charge.OutsourceLocked)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger order-charge-remove" aria-label="Remove charge">×</button>
                            }
                        </div>
                        <div class="col-12">
                            <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel($"Input.Charges[{c}]", outsourceVendors)
                            {
                                IsOutsourced = charge.IsOutsourced,
                                VendorId = charge.OutsourceVendorId,
                                QuoteNumber = charge.OutsourceQuoteNumber,
                                VendorCost = charge.OutsourceCost,
                                ExpectedIn = charge.OutsourceExpectedIn,
                                PrivateNotes = charge.OutsourcePrivateNotes,
                                ReadOnly = isLocked,
                                ToggleLocked = charge.OutsourceLocked,
                                StatusLabel = charge.OutsourceStatusLabel,
                                ToggleLabel = "Outsourced item (promo, print, wide format)",
                                CostInputClass = "order-charge-outsource-cost",
                                MarginReadoutClass = "order-charge-outsource-margin"
                            })" />
                        </div>
                    </div>
                }
                @if (isLocked && Model.Charges.Count == 0)
                {
                    <div class="text-muted small">No charges.</div>
                }
            </div>
            @if (!isLocked)
            {
                <button type="button" id="add-order-charge" class="btn btn-sm btn-outline-secondary">+ Add charge</button>
                <datalist id="order-charge-presets">
                    <option value="Die charge"></option>
                    <option value="Design charge"></option>
                    <option value="Plate charge"></option>
                    <option value="Setup charge"></option>
                    <option value="Promo item"></option>
                    <option value="Printed piece"></option>
                    <option value="Wide format print"></option>
                </datalist>
            }
        </div>
    </div>

    @if (!isLocked)
    {
        <template id="order-charge-row-template">
            <div class="row g-2 align-items-end mb-2 order-charge-row">
                <div class="col-md-6">
                    <label class="form-label small mb-0">Description</label>
                    <input name="Input.Charges[__CHARGE__].Description" list="order-charge-presets" class="form-control form-control-sm order-charge-desc" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label small mb-0">Qty</label>
                    <input name="Input.Charges[__CHARGE__].Quantity" value="1" class="form-control form-control-sm order-charge-qty" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label small mb-0">Unit price</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input name="Input.Charges[__CHARGE__].UnitPrice" value="" class="form-control order-charge-price" />
                    </div>
                </div>
                <div class="col-4 col-md-2 d-flex align-items-center justify-content-between gap-2 pb-1">
                    <span class="small fw-semibold order-charge-total">—</span>
                    <button type="button" class="btn btn-sm btn-outline-danger order-charge-remove" aria-label="Remove charge">×</button>
                </div>
                <div class="col-12">
                    <partial name="Shared/_OutsourceFields" model="@(new OutsourceFieldsModel("Input.Charges[__CHARGE__]", outsourceVendors)
                    {
                        ToggleLabel = "Outsourced item (promo, print, wide format)",
                        CostInputClass = "order-charge-outsource-cost",
                        MarginReadoutClass = "order-charge-outsource-margin"
                    })" />
                </div>
            </div>
        </template>
        <script>
            (function () {
                const container = document.getElementById('order-charges');
                const addBtn = document.getElementById('add-order-charge');
                const template = document.getElementById('order-charge-row-template');
                if (!container || !addBtn || !template) return;

                const reindex = () => {
                    container.querySelectorAll('.order-charge-row').forEach((row, index) => {
                        row.querySelectorAll('[name]').forEach(input => {
                            input.name = input.name.replace(/Charges\[\d+\]|Charges\[__CHARGE__\]/, `Charges[${index}]`);
                        });
                    });
                };

                const updateRowTotals = () => {
                    container.querySelectorAll('.order-charge-row').forEach(row => {
                        const qtyRaw = Number(row.querySelector('.order-charge-qty')?.value);
                        const qty = Number.isFinite(qtyRaw) && qtyRaw > 0 ? qtyRaw : 1;
                        const priceRaw = Number(row.querySelector('.order-charge-price')?.value);
                        const totalEl = row.querySelector('.order-charge-total');
                        if (totalEl) totalEl.textContent = Number.isFinite(priceRaw)
                            ? `$${(qty * priceRaw).toFixed(2)}`
                            : '—';
                    });
                };

                addBtn.addEventListener('click', () => {
                    container.appendChild(template.content.firstElementChild.cloneNode(true));
                    reindex();
                });

                container.addEventListener('click', e => {
                    if (e.target.closest('.order-charge-remove')) {
                        e.target.closest('.order-charge-row')?.remove();
                        reindex();
                    }
                });

                container.addEventListener('input', updateRowTotals);
            })();
        </script>
    }
}

@{
    // Blank spot-row template, cloned by the add button; __LINE__/__SPOT__ are replaced by JS.
    var spotTemplate = $@"<div class=""row g-1 mb-1 spot-row align-items-center"">
  <div class=""col-md-4""><select name=""Input.Lines[__LINE__].Spots[__SPOT__].InkId"" class=""form-select form-select-sm spot-ink""><option value="""">Select spot color</option>{string.Join("", spotInks.Select(x => $@"<option value=""{x.Value}"">{System.Net.WebUtility.HtmlEncode(x.Text)}</option>"))}</select></div>
  <div class=""col-4 col-md-2""><select name=""Input.Lines[__LINE__].Spots[__SPOT__].Hits"" class=""form-select form-select-sm spot-hits""><option value=""1"">1 hit</option><option value=""2"">2 hits</option><option value=""3"">3 hits</option></select></div>
  <div class=""col-4 col-md-2""><div class=""input-group input-group-sm""><input name=""Input.Lines[__LINE__].Spots[__SPOT__].CoveragePct"" value=""100"" class=""form-control spot-coverage"" /><span class=""input-group-text"">%</span></div></div>
  <div class=""col-4 col-md-1""><button type=""button"" class=""btn btn-sm btn-outline-danger spot-remove"">×</button></div>
</div>";
}
<script type="text/template" id="spot-row-template">@Html.Raw(spotTemplate)</script>
<script>
    (function () {
        function reindexSpots(lineEl) {
            const lineIndex = lineEl.dataset.lineIndex;
            lineEl.querySelectorAll('.spot-row').forEach((row, spotIndex) => {
                row.querySelectorAll('[name]').forEach(input => {
                    input.name = input.name
                        .replace(/Lines\[\d+\]/, `Lines[${lineIndex}]`)
                        .replace(/Spots\[\d+\]|Spots\[__SPOT__\]/, `Spots[${spotIndex}]`)
                        .replace(/Lines\[__LINE__\]/, `Lines[${lineIndex}]`);
                });
            });
        }

        document.addEventListener('click', e => {
            const addButton = e.target.closest('.spot-add');
            if (addButton) {
                const lineEl = addButton.closest('.order-line');
                const rows = lineEl.querySelector('.spot-rows');
                const template = document.getElementById('spot-row-template').textContent;
                const holder = document.createElement('div');
                holder.innerHTML = template.trim();
                rows.appendChild(holder.firstElementChild);
                reindexSpots(lineEl);
            }

            const removeButton = e.target.closest('.spot-remove');
            if (removeButton) {
                const lineEl = removeButton.closest('.order-line');
                removeButton.closest('.spot-row').remove();
                reindexSpots(lineEl);
            }
        });

        document.addEventListener('change', e => {
            const inkSetSelect = e.target.closest('.inkset-select');
            if (!inkSetSelect) return;
            const lineEl = inkSetSelect.closest('.order-line');
            const value = inkSetSelect.options[inkSetSelect.selectedIndex]?.text ?? '';
            const hasWhite = value.startsWith('CMYKW') || value === 'EPMW';
            const hasSpot = value.includes('PlusSpot');
            lineEl.querySelectorAll('.white-ink-group').forEach(el => el.classList.toggle('d-none', !hasWhite));
            lineEl.querySelectorAll('.spot-ink-group').forEach(el => el.classList.toggle('d-none', !hasSpot));
        });

        // Shrink substrates expose the layflat input, seeded from the stock's default.
        let SHRINK_STOCKS = {};
        try {
            SHRINK_STOCKS = JSON.parse(document.getElementById('shrink-stocks-data')?.textContent || '{}');
        } catch { SHRINK_STOCKS = {}; }

        document.addEventListener('change', e => {
            const substrateSelect = e.target.closest('.spec-substrate-select');
            if (!substrateSelect) return;
            const body = substrateSelect.closest('.spec-body');
            const group = body?.querySelector('.shrink-layflat-group');
            const input = body?.querySelector('.shrink-layflat-input');
            if (!group || !input) return;
            const isShrink = Object.prototype.hasOwnProperty.call(SHRINK_STOCKS, substrateSelect.value);
            group.classList.toggle('d-none', !isShrink);
            input.value = isShrink ? (SHRINK_STOCKS[substrateSelect.value] ?? '') : '';
        });

        // Finishing builder in the line spec editor, mirroring the estimate form: pick a
        // category and operation, add it as an editable row.
        const parseJson = (id, fallback) => {
            try { return JSON.parse(document.getElementById(id)?.textContent || '') ?? fallback; }
            catch { return fallback; }
        };
        const SO_FINISHING_OPS = parseJson('so-finishing-ops-data', []);
        const SO_DIES = parseJson('so-dies-data', []);
        const SO_FINISHING_STOCKS = parseJson('so-finishing-stocks-data', []);
        const soOpById = new Map(SO_FINISHING_OPS.map(o => [String(o.id), o]));
        const soDieById = new Map(SO_DIES.map(d => [String(d.id), d]));
        const soEsc = t => String(t ?? '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

        function reindexFinishing(lineEl) {
            const lineIndex = lineEl.dataset.lineIndex;
            lineEl.querySelectorAll('.so-finishing-selected .finishing-item').forEach((item, j) => {
                item.querySelectorAll('[name]').forEach(input => {
                    input.name = input.name
                        .replace(/Lines\[\d+\]|Lines\[__LINE__\]/, `Lines[${lineIndex}]`)
                        .replace(/Finishing\[\d+\]/, `Finishing[${j}]`);
                });
            });
        }

        // A die-cut row starts on the line's own die (the spec's Die field); the task carries none.
        function buildSoFinishingItem(op, lineDieId) {
            const dieId = op.category === 'DieCut' && lineDieId ? String(lineDieId) : '';
            const dieBlock = op.category === 'DieCut'
                ? `<div class="col-md-4">
                        <label class="form-label small mb-0">Die</label>
                        <select name="Input.Lines[0].Finishing[0].DieId" class="form-select form-select-sm so-finishing-die">
                            <option value="">No die</option>
                            ${SO_DIES.map(d => `<option value="${soEsc(d.id)}"${String(d.id) === dieId ? ' selected' : ''}>${soEsc(d.description)}</option>`).join('')}
                        </select>
                    </div>`
                : `<input type="hidden" name="Input.Lines[0].Finishing[0].DieId" value="" />`;
            const stockBlock = (op.category === 'Laminate' || op.category === 'Foil')
                ? `<div class="col-md-4">
                        <label class="form-label small mb-0">Material stock</label>
                        <select name="Input.Lines[0].Finishing[0].StockId" class="form-select form-select-sm">
                            <option value="">Select stock</option>
                            ${SO_FINISHING_STOCKS.map(s => `<option value="${soEsc(s.id)}">${soEsc(s.label)}</option>`).join('')}
                        </select>
                    </div>`
                : `<input type="hidden" name="Input.Lines[0].Finishing[0].StockId" value="" />`;
            const holder = document.createElement('div');
            holder.innerHTML = `
                <div class="finishing-item border rounded p-2 mb-2" data-op-id="${soEsc(op.id)}">
                    <input type="hidden" name="Input.Lines[0].Finishing[0].OperationId" value="${soEsc(op.id)}" />
                    <input type="hidden" name="Input.Lines[0].Finishing[0].Include" value="true" />
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div class="text-truncate">
                            <span class="fw-semibold small">${soEsc(op.code)} — ${soEsc(op.description)}</span>
                            <span class="badge text-bg-secondary ms-1">${soEsc(op.category)}</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 so-finishing-remove">Remove</button>
                    </div>
                    <div class="row g-2 mt-0">
                        ${dieBlock}
                        <div class="col-6 col-md-3">
                            <label class="form-label small mb-0">Setup (min)</label>
                            <input name="Input.Lines[0].Finishing[0].SetupMinutesOverride" placeholder="${op.setupMinutes ?? ''}" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small mb-0">Speed (fpm)</label>
                            <input name="Input.Lines[0].Finishing[0].RunSpeedFpmOverride" placeholder="${op.runSpeedFpm ?? ''}" class="form-control form-control-sm" />
                        </div>
                        ${stockBlock}
                    </div>
                </div>`;
            return holder.firstElementChild;
        }

        const applySoDieRatings = (item) => {
            const die = soDieById.get(item.querySelector('.so-finishing-die')?.value);
            const setup = item.querySelector('[name$=".SetupMinutesOverride"]');
            const speed = item.querySelector('[name$=".RunSpeedFpmOverride"]');
            if (setup) setup.value = die?.setupRating != null ? String(die.setupRating) : '';
            if (speed) speed.value = die?.speedRating != null ? String(die.speedRating) : '';
        };

        document.addEventListener('change', e => {
            const categorySel = e.target.closest('.so-finishing-category');
            if (categorySel) {
                const builder = categorySel.closest('.finishing-builder');
                const opSel = builder?.querySelector('.so-finishing-operation');
                const addBtn = builder?.querySelector('.so-finishing-add');
                if (!opSel) return;
                opSel.innerHTML = '<option value="">Select operation</option>';
                SO_FINISHING_OPS.filter(o => o.category === categorySel.value).forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.id;
                    opt.textContent = `${o.code} — ${o.description}`;
                    opSel.appendChild(opt);
                });
                opSel.disabled = !categorySel.value;
                if (addBtn) addBtn.disabled = true;
                return;
            }

            const operationSel = e.target.closest('.so-finishing-operation');
            if (operationSel) {
                const addBtn = operationSel.closest('.finishing-builder')?.querySelector('.so-finishing-add');
                if (addBtn) addBtn.disabled = !operationSel.value;
                return;
            }

            const dieSel = e.target.closest('.so-finishing-die');
            if (dieSel) {
                const item = dieSel.closest('.finishing-item');
                if (item) applySoDieRatings(item);
            }
        });

        document.addEventListener('click', e => {
            const addBtn = e.target.closest('.so-finishing-add');
            if (addBtn) {
                const lineEl = addBtn.closest('.order-line');
                const opSel = addBtn.closest('.finishing-builder')?.querySelector('.so-finishing-operation');
                const op = soOpById.get(opSel?.value);
                const list = lineEl?.querySelector('.so-finishing-selected');
                if (op && list && !list.querySelector(`.finishing-item[data-op-id="${op.id}"]`)) {
                    list.querySelector('.so-finishing-empty')?.remove();
                    const item = buildSoFinishingItem(op, lineEl.querySelector('.so-line-die')?.value);
                    list.appendChild(item);
                    reindexFinishing(lineEl);
                    if (item.querySelector('.so-finishing-die')?.value) applySoDieRatings(item);
                }
                if (opSel) { opSel.value = ''; }
                addBtn.disabled = true;
                return;
            }

            const removeBtn = e.target.closest('.so-finishing-remove');
            if (removeBtn) {
                const lineEl = removeBtn.closest('.order-line');
                removeBtn.closest('.finishing-item')?.remove();
                if (lineEl) reindexFinishing(lineEl);
            }
        });
    })();
</script>
<script>
    // Outsourced lines/charges: live margin readout — our price (qty × unit) against the vendor's cost.
    (function () {
        const pct = (total, cost) => Number.isFinite(total) && Number.isFinite(cost) && total > 0
            ? `${((total - cost) / total * 100).toFixed(1)}%`
            : '—';
        const paint = (el, total, cost) => {
            if (!el) return;
            el.textContent = pct(total, cost);
            el.classList.toggle('text-danger', Number.isFinite(total) && Number.isFinite(cost) && total > 0 && total < cost);
        };
        const refresh = () => {
            document.querySelectorAll('#order-lines .order-line').forEach(line => {
                const qty = Number(line.querySelector('.line-qty')?.value);
                const price = Number(line.querySelector('.line-price')?.value);
                const cost = Number(line.querySelector('.order-line-outsource-cost')?.value);
                paint(line.querySelector('.order-line-outsource-margin'), qty * price, cost);
            });
            document.querySelectorAll('#order-charges .order-charge-row').forEach(row => {
                const qtyRaw = Number(row.querySelector('.order-charge-qty')?.value);
                const qty = Number.isFinite(qtyRaw) && qtyRaw > 0 ? qtyRaw : 1;
                const price = Number(row.querySelector('.order-charge-price')?.value);
                const cost = Number(row.querySelector('.order-charge-outsource-cost')?.value);
                paint(row.querySelector('.order-charge-outsource-margin'), qty * price, cost);
            });
        };
        document.addEventListener('input', e => {
            if (e.target.closest('#order-lines, #order-charges')) refresh();
        });
        document.addEventListener('outsource:toggle', refresh);
        document.addEventListener('order-line-added', refresh);
        refresh();
    })();
</script>

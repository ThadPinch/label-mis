@model LabelsMis.Web.Pages.Inks.InkFormInput
@using LabelsMis.Domain.Enums

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="InkSet" class="form-label"></label>
        <select asp-for="InkSet" asp-items="Html.GetEnumSelectList<InkSet>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="ClickRatePer1000" class="form-label"></label>
        <input asp-for="ClickRatePer1000" class="form-control" />
        <span asp-validation-for="ClickRatePer1000" class="text-danger"></span>
    </div>
    <div class="col-md-2 form-check align-self-end">
        <input asp-for="IsSpot" class="form-check-input" id="ink-is-spot" />
        <label asp-for="IsSpot" class="form-check-label"></label>
    </div>
    <div class="col-md-2" id="ink-spot-color-group">
        <label asp-for="SpotColor" class="form-label"></label>
        <select asp-for="SpotColor" asp-items="Html.GetEnumSelectList<SpotColor>()" class="form-select"></select>
        <span asp-validation-for="SpotColor" class="text-danger"></span>
    </div>
    <div class="col-12" id="ink-spot-fields">
        <div class="row g-3">
            <div class="col-12"><hr /><h2 class="h6 mb-0">Bottle &amp; coverage</h2>
                <p class="text-muted small mb-0">Used for spot inks (white, silver, PMS colors) to cost ink consumption. Leave mL/in² at 0 to charge clicks only.</p>
            </div>
            <div class="col-md-3">
                <label asp-for="BottleCost" class="form-label"></label>
                <div class="input-group"><span class="input-group-text">$</span><input asp-for="BottleCost" class="form-control" /></div>
                <span asp-validation-for="BottleCost" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="BottleSizeMl" class="form-label"></label>
                <input asp-for="BottleSizeMl" class="form-control" />
                <div class="form-text">Colors typically 1500 mL, white 1800 mL.</div>
                <span asp-validation-for="BottleSizeMl" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MlPer1000SqIn" class="form-label"></label>
                <input asp-for="MlPer1000SqIn" class="form-control" />
                <div class="form-text">Ink laid down per 1000 in² at 100% coverage.</div>
                <span asp-validation-for="MlPer1000SqIn" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DefaultCoveragePct" class="form-label"></label>
                <div class="input-group"><input asp-for="DefaultCoveragePct" class="form-control" /><span class="input-group-text">%</span></div>
                <span asp-validation-for="DefaultCoveragePct" class="text-danger"></span>
            </div>
            <div class="col-12">
                <hr /><h2 class="h6 mb-0">Press speed overrides (fpm)</h2>
                <p class="text-muted small mb-0">Optional. Set the press speed by hit count. The estimate's press run uses the slowest applicable speed. Leave blank for no slowdown.</p>
            </div>
            <div class="col-md-4">
                <label asp-for="SpeedFpm1Hit" class="form-label"></label>
                <input asp-for="SpeedFpm1Hit" class="form-control" />
                <span asp-validation-for="SpeedFpm1Hit" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SpeedFpm2Hit" class="form-label"></label>
                <input asp-for="SpeedFpm2Hit" class="form-control" />
                <span asp-validation-for="SpeedFpm2Hit" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SpeedFpm3Hit" class="form-label"></label>
                <input asp-for="SpeedFpm3Hit" class="form-control" />
                <span asp-validation-for="SpeedFpm3Hit" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var spot = document.getElementById('ink-is-spot');
        var colorGroup = document.getElementById('ink-spot-color-group');
        var fields = document.getElementById('ink-spot-fields');
        if (!spot || !colorGroup || !fields) return;

        function sync() {
            var show = spot.checked ? '' : 'none';
            colorGroup.style.display = show;
            fields.style.display = show;
        }

        spot.addEventListener('change', sync);
        sync();
    })();
</script>

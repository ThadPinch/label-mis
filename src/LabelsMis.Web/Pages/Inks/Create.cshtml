@page "/inks/create"
@model LabelsMis.Web.Pages.Inks.CreateModel
@{
    ViewData["Title"] = "New ink";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New ink</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_InkForm" model="Model.Input" />
    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

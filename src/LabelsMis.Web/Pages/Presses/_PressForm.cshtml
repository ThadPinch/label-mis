@model LabelsMis.Web.Pages.Presses.PressFormInput
@using LabelsMis.Domain.Enums

<div class="row g-3">
    <div class="col-md-5">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PressType" class="form-label"></label>
        <select asp-for="PressType" asp-items="Html.GetEnumSelectList<PressType>()" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="WebWidthIn" class="form-label"></label>
        <input asp-for="WebWidthIn" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="MaxRepeatIn" class="form-label"></label>
        <input asp-for="MaxRepeatIn" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="MinRepeatIn" class="form-label"></label>
        <input asp-for="MinRepeatIn" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="MaxColors" class="form-label"></label>
        <input asp-for="MaxColors" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="SpeedFpm" class="form-label"></label>
        <input asp-for="SpeedFpm" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="SetupMinutes" class="form-label"></label>
        <input asp-for="SetupMinutes" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="CostPerHour" class="form-label"></label>
        <input asp-for="CostPerHour" class="form-control" />
    </div>
    <div class="col-md-3 form-check align-self-end">
        <input asp-for="IsClickBased" class="form-check-input" />
        <label asp-for="IsClickBased" class="form-check-label"></label>
    </div>
</div>

@page "/presses/create"
@model LabelsMis.Web.Pages.Presses.CreateModel
@{
    ViewData["Title"] = "New press";
    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">New press</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_PressForm" model="Model.Input" />
    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

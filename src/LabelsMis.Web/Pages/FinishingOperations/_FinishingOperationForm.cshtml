@model LabelsMis.Web.Pages.FinishingOperations.FinishingOperationFormInput
@using LabelsMis.Domain.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="OperationType" class="form-label"></label>
        <select asp-for="OperationType" asp-items="Html.GetEnumSelectList<FinishingOperationType>()" class="form-select" id="finishing-operation-type"></select>
    </div>
    <div class="col-md-6 @(Model.OperationType == FinishingOperationType.DieCut ? "" : "d-none")" id="finishing-operation-die-field">
        <label asp-for="DieId" class="form-label"></label>
        <select asp-for="DieId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Dies"]!)">
            <option value="">Select die…</option>
        </select>
        <span class="form-text">Required when operation type is Die cut.</span>
        <span asp-validation-for="DieId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EquipmentName" class="form-label"></label>
        <input asp-for="EquipmentName" class="form-control" />
        <span asp-validation-for="EquipmentName" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DefaultSetupMinutes" class="form-label"></label>
        <input asp-for="DefaultSetupMinutes" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="DefaultRunSpeedFpm" class="form-label"></label>
        <input asp-for="DefaultRunSpeedFpm" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="CostPerHour" class="form-label"></label>
        <input asp-for="CostPerHour" class="form-control" />
    </div>
</div>

<script>
(() => {
    const dieCutValue = '@((int)FinishingOperationType.DieCut)';
    const typeSelect = document.getElementById('finishing-operation-type');
    const dieField = document.getElementById('finishing-operation-die-field');
    const dieSelect = document.querySelector('[name="Input.DieId"]');
    if (!typeSelect || !dieField) return;

    const sync = () => {
        const isDieCut = typeSelect.value === dieCutValue;
        dieField.classList.toggle('d-none', !isDieCut);
        if (dieSelect) {
            dieSelect.required = isDieCut;
            if (!isDieCut) dieSelect.value = '';
        }
    };

    typeSelect.addEventListener('change', sync);
    sync();
})();
</script>

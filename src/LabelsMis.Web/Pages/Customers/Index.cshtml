@page "/customers"
@model LabelsMis.Web.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
    var route = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["IncludeInactive"] = Model.IncludeInactive ? "true" : null,
        ["Sort"] = Model.Sort
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-primary" asp-page="Create">New customer</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Sort" />
    <div class="col-md-4">
        <input asp-for="Search" class="form-control" placeholder="Search name or code" />
    </div>
    <div class="col-md-2 form-check align-self-center">
        <input asp-for="IncludeInactive" class="form-check-input" />
        <label asp-for="IncludeInactive" class="form-check-label">Show inactive</label>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Name", "name", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Code", "code", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Status", "status", Model.Sort, route))</th>
            <th>@await Html.PartialAsync("Shared/_SortHeader", new SortHeaderModel("Active", "active", Model.Sort, route))</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Code</td>
            <td>@item.Status</td>
            <td>@(item.IsActive ? "Yes" : "No")</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@(Model.CanEdit ? "Edit" : "View")</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@await Html.PartialAsync("Shared/_Pager", new PagerModel(
    Model.Result.Page,
    Model.Result.TotalPages,
    Model.Result.TotalCount,
    Model.Search,
    Model.Sort,
    Model.IncludeInactive))

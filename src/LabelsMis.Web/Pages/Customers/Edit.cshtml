@page "/customers/edit/{id:guid}"
@model LabelsMis.Web.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Edit customer";

    ViewData["BackNav"] = new BackNavModel();
}

<h1 class="h3 mb-3">Edit customer</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_CustomerForm" for="Input" />
    @if (Model.CanEdit)
    {
        <button type="submit" class="btn btn-primary">Save</button>
        @if (Model.IsActive)
        {
            <button type="submit" asp-page-handler="Deactivate" class="btn btn-outline-danger"
                    onclick="return confirm('Deactivate this customer?');">Deactivate</button>
        }
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/customer-form.js" asp-append-version="true"></script>
}

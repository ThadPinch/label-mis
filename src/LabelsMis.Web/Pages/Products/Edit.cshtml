@page "/products/{id:guid}/edit"
@model LabelsMis.Web.Pages.Products.EditModel
@{ ViewData["Title"] = Model.Product?.InternalSku ?? "Product"; ViewData["BackNav"] = new BackNavModel(); }
<h1 class="h3 mb-1">@Model.Product?.InternalSku</h1>
<p class="text-muted">@Model.Product?.Status</p>
<form method="post">
    <partial name="_ProductForm" model="Model.Input" />
    <div class="mt-3 d-flex gap-2">
        @if (Model.CanEdit)
        {
            <button type="submit" asp-page-handler="Save" class="btn btn-primary">Save</button>
            @if (Model.Product?.Status == LabelsMis.Domain.Enums.ProductStatus.Active)
            {
                <button type="submit" asp-page-handler="Discontinue" class="btn btn-outline-danger">Discontinue</button>
            }
        }
    </div>
</form>

@page "/products/{id:guid}/edit"
@model LabelsMis.Web.Pages.Products.EditModel
@{
    ViewData["Title"] = Model.Product?.InternalSku ?? "Product";
    ViewData["BackNav"] = new BackNavModel();
    ViewData["ArtworkProductId"] = Model.Id;
    ViewData["CanEditArtwork"] = Model.CanEdit;
}

<div class="mb-2">
    <h1 class="h4 mb-0">
        @Model.Product?.InternalSku
        <span class="badge @(Model.Product?.Status == LabelsMis.Domain.Enums.ProductStatus.Active ? "text-bg-success" : "text-bg-secondary") align-middle">@Model.Product?.Status</span>
    </h1>
</div>

@if (TempData["ProductStatus"] is string productStatus)
{
    <div class="alert alert-success py-1 px-2 small mb-2">@productStatus</div>
}

<form method="post">
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <partial name="_ProductForm" for="Input" />
    @if (Model.CanEdit)
    {
        <div class="d-flex gap-2 mt-1 mb-2">
            <button type="submit" asp-page-handler="Save" class="btn btn-sm btn-primary">Save</button>
            @if (Model.Product?.Status == LabelsMis.Domain.Enums.ProductStatus.Active)
            {
                <button type="submit" asp-page-handler="Discontinue" class="btn btn-sm btn-outline-danger">Discontinue</button>
            }
        </div>
    }
</form>

@if (Model.CanEdit)
{
    @* Target of the artwork upload controls rendered inside the form partial's Artwork card. *@
    <form method="post" asp-page-handler="UploadArtwork" enctype="multipart/form-data" id="artwork-upload-form"></form>
    @* Target of the Remove artwork button in the same card; confirmed in the browser before it posts. *@
    <form method="post" asp-page-handler="RemoveArtwork" id="artwork-remove-form"
          onsubmit="return confirm('Remove the current artwork from this product? Jobs that already imposed it keep their imposed PDF; new impositions will need a fresh upload.');"></form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model LabelsMis.Web.Pages.Products.ProductPageInput
@using LabelsMis.Domain.Entities
@{
    var finishingOps = (IReadOnlyList<FinishingOperation>?)ViewData["FinishingOperations"] ?? Array.Empty<FinishingOperation>();
    var finishingPrefix = string.IsNullOrEmpty(ViewData.TemplateInfo.HtmlFieldPrefix)
        ? ""
        : ViewData.TemplateInfo.HtmlFieldPrefix + ".";
}
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Customers <span class="text-muted">(optional)</span></label>
        <select asp-for="CustomerIds" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Customers"]!)" multiple size="5"></select>
        <span asp-validation-for="CustomerIds" class="text-danger"></span>
        <div class="form-text">Hold Ctrl/Cmd to select multiple customers. Leave empty for a stock product with no customer affiliation.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="PrimaryCustomerId" class="form-label">Primary customer <span class="text-muted">(optional)</span></label>
        <select asp-for="PrimaryCustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Customers"]!)">
            <option value="">— No customer (stock product) —</option>
        </select>
        <span asp-validation-for="PrimaryCustomerId" class="text-danger"></span>
        <div class="form-text">Used for the internal SKU prefix (e.g. ACME-0001). Stock products use the STK prefix.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="CustomerSku" class="form-label">Customer SKU</label>
        <input asp-for="CustomerSku" class="form-control" />
        <span asp-validation-for="CustomerSku" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Description" class="form-label">Description</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="LabelAcrossIn" class="form-label">Across (in)</label>
        <input asp-for="LabelAcrossIn" class="form-control" />
        <span asp-validation-for="LabelAcrossIn" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="LabelAroundIn" class="form-label">Around (in)</label>
        <input asp-for="LabelAroundIn" class="form-control" />
        <span asp-validation-for="LabelAroundIn" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="CornerRadiusIn" class="form-label">Corner radius</label>
        <input asp-for="CornerRadiusIn" class="form-control" />
        <span asp-validation-for="CornerRadiusIn" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="SubstrateId" class="form-label">Substrate</label>
        <select asp-for="SubstrateId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Substrates"]!)">
            <option value="">— Select substrate —</option>
        </select>
        <span asp-validation-for="SubstrateId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="InkSet" class="form-label">Ink set</label>
        <select asp-for="InkSet" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.InkSet>()"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="DieId" class="form-label">Die</label>
        <select asp-for="DieId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["Dies"]!)"><option value="">None</option></select>
    </div>
    <input type="hidden" asp-for="ArtworkFilePath" />
    <div class="col-12">
        <hr />
        <h2 class="h5">Finishing operations</h2>
        <p class="text-muted small mb-2">Added operations are auto-populated when this product is pulled into an estimate.</p>
        <script type="application/json" id="finishing-ops-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(finishingOps.Select(o => new { id = o.Id, code = o.Code, description = o.Description, category = o.OperationType.ToString() })))</script>
        <div id="product-finishing" data-prefix="@finishingPrefix">
            <div class="finishing-builder row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Category</label>
                    <select class="form-select finishing-category-select">
                        <option value="">Select category</option>
                        @foreach (var cat in finishingOps.Select(o => o.OperationType).Distinct())
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small mb-1">Operation</label>
                    <select class="form-select finishing-operation-select" disabled>
                        <option value="">Select operation</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-outline-primary finishing-add w-100" disabled>Add operation</button>
                </div>
            </div>
            <div class="finishing-selected mt-2">
                @for (var j = 0; j < Model.FinishingOperations.Count; j++)
                {
                    var sel = Model.FinishingOperations[j];
                    var op = finishingOps.FirstOrDefault(o => o.Id == sel.OperationId);
                    <div class="finishing-item border rounded p-2 mb-2" data-op-id="@sel.OperationId">
                        <div class="d-flex flex-wrap gap-2 align-items-end">
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@(op is null ? sel.OperationId.ToString() : $"{op.Code} — {op.Description}")</div>
                                @if (op is not null)
                                {
                                    <span class="text-muted small">@op.OperationType</span>
                                }
                                <input type="hidden" name="@(finishingPrefix)FinishingOperations[@j].OperationId" value="@sel.OperationId" class="finishing-op-id" />
                                <input type="hidden" name="@(finishingPrefix)FinishingOperations[@j].SortOrder" value="@j" class="finishing-sort" />
                                <input type="hidden" name="@(finishingPrefix)FinishingOperations[@j].StockId" value="@(sel.StockId?.ToString() ?? "")" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Setup min override</label>
                                <input name="@(finishingPrefix)FinishingOperations[@j].SetupMinutesOverride" value="@(sel.SetupMinutesOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control form-control-sm" style="max-width: 8rem;" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Run speed fpm override</label>
                                <input name="@(finishingPrefix)FinishingOperations[@j].RunSpeedFpmOverride" value="@(sel.RunSpeedFpmOverride?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control form-control-sm" style="max-width: 8rem;" />
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger finishing-remove">Remove</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-12"><hr /><h2 class="h5">Roll spec</h2></div>
    <div class="col-md-2"><label asp-for="LabelsPerRoll" class="form-label">Labels/roll</label><input asp-for="LabelsPerRoll" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="CoreSizeIn" class="form-label">Core (in)</label><input asp-for="CoreSizeIn" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="UnwindPosition" class="form-label">Unwind</label><input asp-for="UnwindPosition" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="MaxOdIn" class="form-label">Max OD</label><input asp-for="MaxOdIn" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="RollsPerCase" class="form-label">Rolls/case</label><input asp-for="RollsPerCase" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="CaseLabelFormat" class="form-label">Case label format</label><input asp-for="CaseLabelFormat" class="form-control" /></div>
</div>

<script>
(() => {
    const root = document.getElementById('product-finishing');
    if (!root) return;
    const prefix = root.dataset.prefix || '';
    let OPS = [];
    try {
        const el = document.getElementById('finishing-ops-data');
        if (el) OPS = JSON.parse(el.textContent || '[]');
    } catch { OPS = []; }
    const byId = new Map(OPS.map(o => [String(o.id), o]));
    const categorySel = root.querySelector('.finishing-category-select');
    const opSel = root.querySelector('.finishing-operation-select');
    const addBtn = root.querySelector('.finishing-add');
    const list = root.querySelector('.finishing-selected');
    const esc = (t) => String(t ?? '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    const renumber = () => {
        list.querySelectorAll('.finishing-item').forEach((item, j) => {
            item.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/FinishingOperations\[\d+\]/, `FinishingOperations[${j}]`);
            });
            const sort = item.querySelector('.finishing-sort');
            if (sort) sort.value = String(j);
        });
    };
    const wireRemove = (btn) => {
        if (!btn) return;
        btn.addEventListener('click', () => { btn.closest('.finishing-item')?.remove(); renumber(); });
    };
    const addOp = (op) => {
        if (!op) return;
        if (list.querySelector(`.finishing-item[data-op-id="${op.id}"]`)) return;
        const item = document.createElement('div');
        item.className = 'finishing-item border rounded p-2 mb-2';
        item.dataset.opId = op.id;
        item.innerHTML = `
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1">
                    <div class="fw-semibold">${esc(op.code)} — ${esc(op.description)}</div>
                    <span class="text-muted small">${esc(op.category)}</span>
                    <input type="hidden" name="${prefix}FinishingOperations[0].OperationId" value="${esc(op.id)}" class="finishing-op-id" />
                    <input type="hidden" name="${prefix}FinishingOperations[0].SortOrder" value="0" class="finishing-sort" />
                </div>
                <div>
                    <label class="form-label small mb-0">Setup min override</label>
                    <input name="${prefix}FinishingOperations[0].SetupMinutesOverride" class="form-control form-control-sm" style="max-width: 8rem;" />
                </div>
                <div>
                    <label class="form-label small mb-0">Run speed fpm override</label>
                    <input name="${prefix}FinishingOperations[0].RunSpeedFpmOverride" class="form-control form-control-sm" style="max-width: 8rem;" />
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger finishing-remove">Remove</button>
            </div>`;
        list.appendChild(item);
        renumber();
        wireRemove(item.querySelector('.finishing-remove'));
    };
    categorySel?.addEventListener('change', () => {
        opSel.innerHTML = '<option value="">Select operation</option>';
        OPS.filter(o => o.category === categorySel.value).forEach(o => {
            const opt = document.createElement('option');
            opt.value = o.id;
            opt.textContent = `${o.code} — ${o.description}`;
            opSel.appendChild(opt);
        });
        opSel.disabled = !categorySel.value;
        if (addBtn) addBtn.disabled = true;
    });
    opSel?.addEventListener('change', () => { if (addBtn) addBtn.disabled = !opSel.value; });
    addBtn?.addEventListener('click', () => {
        addOp(byId.get(opSel.value));
        opSel.value = '';
        addBtn.disabled = true;
    });
    list.querySelectorAll('.finishing-remove').forEach(wireRemove);
})();
</script>

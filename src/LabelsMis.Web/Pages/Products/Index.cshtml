@page "/products"
@model LabelsMis.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-primary" asp-page="Create">New product</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input asp-for="Search" class="form-control" placeholder="Search SKU or description" /></div>
    <div class="col-md-3">
        <select asp-for="CustomerId" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewData["CustomerOptions"]!)">
            <option value="">All customers</option>
        </select>
    </div>
    <div class="col-md-3">
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LabelsMis.Domain.Enums.ProductStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary w-100">Filter</button></div>
</form>

<table class="table table-striped">
    <thead><tr><th>Internal SKU</th><th>Customer SKU</th><th>Description</th><th>Customer</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr>
            <td>@item.InternalSku</td>
            <td>@(item.CustomerSku ?? "—")</td>
            <td>@item.Description</td>
            <td>@item.CustomerNames</td>
            <td>@item.Status</td>
            <td class="text-end"><a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
        </tr>
    }
    </tbody>
</table>
